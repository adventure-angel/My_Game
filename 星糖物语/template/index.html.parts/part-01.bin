<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#f4efff">
<title>星糖物语 · 星愿消除</title>
<style>
:root{--ink:#35264f;--muted:#82778f;--purple:#8261d6;--deep:#6545b8;--line:#e8dff2;--panel:#fffaf7;--shadow:0 18px 55px #4d2f7417}
*{box-sizing:border-box} [hidden]{display:none!important}
body{margin:0;color:var(--ink);font-family:"Microsoft YaHei","PingFang SC",system-ui,sans-serif;background:#f4eff9;background-image:radial-gradient(ellipse at 0 15%,#ffe8e8 0,transparent 50%),radial-gradient(ellipse at 100% 85%,#e0eafc 0,transparent 55%);min-height:100svh}
button{font:inherit;color:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}button:disabled{cursor:default;opacity:.42}button:focus-visible{outline:3px solid #7863c7;outline-offset:3px}svg{display:block}button,select{touch-action:manipulation}
.app{max-width:1120px;margin:auto;padding:22px 28px 16px}.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;gap:10px}.brand{display:flex;gap:10px;align-items:center;font-size:18px;font-weight:900;letter-spacing:.08em}.brand-mark{background:var(--purple);color:white;border-radius:14px;padding:9px 12px;box-shadow:0 4px 0 #684ba3}.brand small{display:block;font-size:8px;letter-spacing:.27em;color:#8e7ca2;margin-top:3px}.top-right{display:flex;gap:7px}.icon-btn{border:1px solid var(--line);background:#fff9;border-radius:13px;min-width:40px;height:40px;font-size:17px}.main{display:grid;grid-template-columns:1fr 470px;gap:42px;align-items:center}.story{padding:20px 0}.eyebrow{color:#9477ba;font-size:10px;letter-spacing:.25em;font-weight:bold}.story h1{font-size:56px;line-height:1.18;letter-spacing:-.05em;margin:14px 0 18px}.story h1 span{color:#9572c6}.story>p{font-size:14px;color:var(--muted);line-height:1.9;max-width:345px}.illustration{position:relative;width:100%;max-width:380px;aspect-ratio:1.5;margin:16px 0}.orbit{position:absolute;inset:12% 7%;border:1px dashed #cbb7de;border-radius:50%;transform:rotate(-16deg)}.big-character{position:absolute;width:58%;left:22%;top:0;filter:drop-shadow(0 14px 8px #73508019)}.floating{position:absolute;width:54px;height:54px;border:1px solid #fff;background:#fff9;padding:10px;border-radius:18px;box-shadow:0 10px 20px #79678b10;animation:float 5s ease-in-out infinite}.f1{left:5%;top:23%;transform:rotate(-14deg)}.f2{right:0;top:12%;animation-delay:-2s}.f3{right:7%;bottom:5%;animation-delay:-3s}.story-note{font-size:11px;color:#9b89aa;line-height:1.8}.companions{display:flex;gap:9px;margin-top:15px}.companion{width:70px;border-radius:18px;border:1px solid var(--line);padding:7px;background:#fff9}.companion.active{background:#eee4fb;border-color:#b59bda;box-shadow:0 3px 0 #cdb6eb}.companion svg{width:52px;height:52px}.companion span{font-size:10px;display:block;text-align:center;margin-top:2px}.game{border:1px solid #fff;border-radius:30px;padding:18px;background:#fffc;box-shadow:var(--shadow);min-width:0}.mode-tabs{display:flex;background:#f0eaf7;padding:4px;border-radius:14px;gap:4px}.mode-tab{flex:1;border:0;background:none;padding:9px 5px;border-radius:10px;color:#95849e;font-size:12px;font-weight:800}.mode-tab.active{background:#fff;color:#70529b;box-shadow:0 3px 8px #5e427b0c}
.level-head{display:flex;justify-content:space-between;align-items:center;margin:16px 2px 12px}.level-head h2{font-size:15px;margin:0}.level-head small{font-size:10px;color:#a08daa;display:block;margin-top:4px}.map-btn{border:1px solid var(--line);border-radius:12px;background:#fff;padding:8px 10px;font-size:11px}.hud{display:flex;gap:8px;margin-bottom:10px}.metric{flex:1;border:1px solid #eee6f1;border-radius:15px;background:#f8f5fc;padding:9px 12px}.metric span{color:#95849f;font-size:10px;display:block}.metric strong{display:block;font-size:23px;font-variant-numeric:tabular-nums;line-height:1.3}.metric.moves{flex:0 0 88px;background:#f9eee7;border-color:#f2e1d4}.metric.moves strong{color:#c38858}.target{flex:1.5}.target strong{font-size:13px;margin-top:6px}.progress{height:5px;border-radius:5px;background:#e8deee;margin-top:7px;overflow:hidden}.progress>i{display:block;height:100%;background:linear-gradient(90deg,#b5a0df,#e8a2b8);transition:width .3s;width:0}
.board-shell{position:relative;background:#e9e0f0;padding:7px;border-radius:23px;box-shadow:inset 0 2px 6px #75568e12}.board{position:relative;aspect-ratio:1;touch-action:none;user-select:none;overflow:hidden;border-radius:17px;background:repeating-linear-gradient(0deg,transparent 0 14.285%,#ffffff1c 14.285% 28.57%)}.tile{position:absolute;width:14.285714%;height:14.285714%;padding:3px;border:0;background:none;transition:left .18s ease,top .23s cubic-bezier(.22,.8,.3,1);touch-action:none}.tile-face{width:100%;height:100%;display:grid;place-items:center;border-radius:14px;border:1px solid #ffffffbd;box-shadow:0 3px 0 #46375417,inset 0 2px 0 #fff9;position:relative;transition:transform .15s,filter .15s}.tile svg{width:78%;height:78%;filter:drop-shadow(0 2px 0 #00000008);pointer-events:none}.tile[data-k="0"] .tile-face{background:#f4dfe9}.tile[data-k="1"] .tile-face{background:#dcecf6}.tile[data-k="2"] .tile-face{background:#f8e5cd}.tile[data-k="3"] .tile-face{background:#dfeccc}.tile[data-k="4"] .tile-face{background:#e4dcf6}.tile[data-k="5"] .tile-face{background:#f8dbd3}.tile.selected .tile-face{outline:3px solid #8867c1;outline-offset:-2px;transform:scale(.9);filter:brightness(1.08)}.tile.hint .tile-face{animation:hint .7s ease-in-out 2}.tile.clearing .tile-face{animation:pop .23s ease-in both}.tile.enter .tile-face{animation:enter .28s both}.special{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;border-radius:13px;font-size:23px;color:white;text-shadow:0 2px 3px #65437c;font-weight:900}.tile[data-s="row"] .tile-face{box-shadow:inset 0 0 0 2px #fff,0 0 8px #fff}.tile[data-s="row"] .special:before{content:"";position:absolute;left:2px;right:2px;height:4px;background:#fff9;box-shadow:0 0 5px #fff;transform:rotate(-12deg)}.tile[data-s="col"] .special:before{content:"";position:absolute;top:2px;bottom:2px;width:4px;background:#fff9;box-shadow:0 0 5px #fff;transform:rotate(-12deg)}.tile[data-s="bomb"] .tile-face{outline:2px dashed #fff;outline-offset:-5px}.tile[data-s="rainbow"] .tile-face{background:conic-gradient(#ecc2dd,#c5dff4,#dcecbc,#f8e1aa,#ecc2dd);box-shadow:0 0 10px #f9f2ff}
.board-caption{min-height:28px;display:flex;align-items:center;justify-content:center;font-size:10px;color:#9d8aaa;text-align:center;padding:5px}.tool-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.tool{background:#fff;border:1px solid var(--line);border-radius:14px;padding:9px 5px;font-size:11px;display:flex;justify-content:center;gap:6px;align-items:center}.tool b{font-size:10px;border-radius:8px;background:#f0e9f7;padding:2px 5px}.tool.on{background:#eee0fa;border-color:#aa84cd}.skill-box{display:flex;align-items:center;gap:10px;padding:10px 11px 0}.skill-avatar{width:39px;height:39px;flex-shrink:0}.skill-info{flex:1;min-width:0}.skill-info strong{font-size:11px;display:block}.skill-info small{font-size:9px;color:#9b89a7}.skill-info .progress{height:4px;margin-top:5px}.skill-btn{border:0;background:#eee6f6;color:#7e5f9a;border-radius:12px;padding:10px 12px;font-weight:bold;font-size:11px}.skill-btn.ready{color:white;background:#a07bc4;animation:glow 2s infinite}.footer{display:flex;justify-content:space-between;margin-top:20px;font-size:10px;color:#ac9bb4;gap:10px}
.veil{position:fixed;inset:0;background:#38264765;backdrop-filter:blur(8px);z-index:20;display:flex;justify-content:center;align-items:center;padding:20px}.dialog{background:#fffaf8;width:360px;max-width:100%;max-height:88svh;overflow:auto;border-radius:27px;padding:26px;text-align:center;box-shadow:0 20px 80px #20112940;border:1px solid #fff;animation:enter .2s}.dialog h2{font-size:23px;margin:8px 0 10px}.dialog p{font-size:12px;line-height:1.8;color:#93809f;margin:7px 0 18px}.dialog-icon{font-size:34px;color:#aa83c6;line-height:1.4}.dialog .primary,.dialog .secondary{width:100%;margin-top:9px}.primary{border:0;background:linear-gradient(135deg,#ab89cc,#8765b7);border-radius:14px;padding:13px 17px;color:white;font-size:13px;font-weight:800;box-shadow:0 4px 0 #76579b}.secondary{border:1px solid var(--line);background:#fff;border-radius:14px;padding:11px 15px;color:#8a7599;font-size:12px}.level-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:16px 0}.level-button{border:1px solid var(--line);background:#f0e7f8;border-radius:14px;padding:10px 2px;font-size:17px;font-weight:bold}.level-button small{display:block;color:#c9945b;font-size:9px;margin-top:4px;letter-spacing:1px}.rule{display:flex;align-items:center;gap:10px;text-align:left;padding:10px 0;border-bottom:1px solid #eee5f1;font-size:12px;line-height:1.7}.rule b{font-size:22px;min-width:30px;text-align:center;color:#a383c0}.rule small{display:block;color:#a593ad;font-size:10px}.toast{position:fixed;bottom:max(24px,env(safe-area-inset-bottom));left:50%;transform:translate(-50%,15px);opacity:0;pointer-events:none;background:#514060;color:white;padding:10px 16px;border-radius:18px;font-size:12px;z-index:30;max-width:90vw;text-align:center;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}.burst{position:absolute;left:50%;top:40%;z-index:5;pointer-events:none;text-align:center;font-size:26px;font-weight:900;color:#fff;text-shadow:0 2px 0 #9161b4,0 0 15px #9c71b6;animation:burst .8s both;white-space:nowrap}.burst small{display:block;font-size:14px}.spark{position:absolute;pointer-events:none;z-index:6;width:7px;height:7px;border-radius:2px;background:var(--spark);animation:spark .6s ease-out both}.low{color:#bc6571!important}.stars{font-size:36px;color:#dca45d;letter-spacing:7px}.settings-row{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line);font-size:13px}.switch{border:0;background:#eee4f5;border-radius:11px;padding:7px 13px;color:#89639e;font-size:12px}.switch[aria-pressed="true"]{background:#9d7abd;color:#fff}
@keyframes float{50%{translate:0 -8px}}@keyframes glow{50%{box-shadow:0 0 15px #b990d655}}@keyframes hint{50%{transform:scale(.85);filter:brightness(1.2)}}@keyframes pop{to{transform:scale(.15) rotate(20deg);opacity:0}}@keyframes enter{from{transform:scale(.75);opacity:0}to{transform:scale(1);opacity:1}}@keyframes burst{0%{transform:translate(-50%,0) scale(.7);opacity:0}25%{opacity:1;transform:translate(-50%,-10px) scale(1.08)}100%{transform:translate(-50%,-55px);opacity:0}}@keyframes spark{to{transform:translate(var(--x),var(--y)) rotate(130deg);opacity:0}}
@media(max-width:860px){.app{max-width:490px;padding:12px 12px 16px}.top{margin-bottom:11px}.brand{font-size:15px}.brand-mark{padding:7px 10px}.brand small{font-size:7px}.main{display:block}.story{display:none}.game{padding:13px;border-radius:23px}.level-head{margin:12px 2px 10px}.footer{margin-top:12px;font-size:9px}.tile-face{border-radius:12px}.icon-btn{width:36px;min-width:36px;height:36px;font-size:15px}.skill-box{padding-top:9px}.metric{padding:8px 10px}.metric.moves{flex-basis:74px}.metric strong{font-size:21px}.target strong{font-size:12px}.board-shell{padding:6px;border-radius:20px}.tile{padding:2.5px}}
@media(max-width:360px){.app{padding:9px}.game{padding:10px}.hud{gap:5px}.metric{padding:7px}.metric.moves{flex-basis:62px}.metric span{font-size:9px}.target strong{font-size:11px}.tile-face{border-radius:9px}.board-caption{font-size:9px}.tool{font-size:10px;padding:9px 3px}.skill-btn{padding:9px}.footer span:last-child{display:none}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.001ms!important;transition-duration:.001ms!important}}
body.reduced *,body.reduced *:before{animation-duration:.001ms!important;transition-duration:.001ms!important}
.screen{max-width:940px;margin:0 auto;min-height:65svh;animation:enter .22s ease-out}.screen-title{outline:none;font-size:30px;letter-spacing:-.04em;margin:8px 0}.screen-copy{color:var(--muted);font-size:13px;line-height:1.85}.page-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:24px}.page-kicker{font-size:9px;color:#a28aaf;letter-spacing:.2em;font-weight:800}.page-back{font-size:11px;white-space:nowrap;border:1px solid var(--line);background:#fff9;padding:10px;border-radius:12px}.home-hero{position:relative;overflow:hidden;border:1px solid #fff;background:linear-gradient(120deg,#fffaf8,#ece3fa);padding:36px;border-radius:30px;display:grid;grid-template-columns:1.2fr 1fr;align-items:center;box-shadow:var(--shadow)}.home-hero h1{font-size:clamp(32px,5vw,52px);line-height:1.2;margin:14px 0;color:#654d87;letter-spacing:-.05em}.home-art{width:100%;max-width:270px;justify-self:center;position:relative}.home-art:before{content:"";position:absolute;inset:20% -5% 5%;border:1px dashed #baa0cf;border-radius:50%;transform:rotate(-15deg)}.home-art svg{position:relative;filter:drop-shadow(0 15px 9px #79609224)}.home-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.home-actions button{min-width:140px}.page-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:20px 0}.page-stat{padding:18px 12px;text-align:center;border:1px solid #fff;background:#ffffffa6;border-radius:18px}.page-stat strong{display:block;font-size:24px;font-weight:900;color:#8b6ca8}.page-stat small{font-size:10px;color:#9a89a6;display:block;margin-top:5px}.page-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.entry-card{border:1px solid #fff;border-radius:22px;background:#fffc;padding:23px;text-align:left;display:flex;align-items:center;gap:17px;box-shadow:0 7px 25px #73568107}.entry-card .entry-icon{font-size:26px;color:#a086c3;background:#eee6f7;width:55px;height:55px;display:grid;place-items:center;border-radius:17px;flex-shrink:0}.entry-card strong{font-size:15px;display:block}.entry-card small{color:#9c89a8;font-size:11px;line-height:1.8;display:block;margin-top:5px}.entry-arrow{margin-left:auto;color:#b29bc3}.resume-banner{width:100%;border:1px solid #ddcbea;background:#eee5f6;border-radius:17px;padding:15px 18px;text-align:left;display:flex;align-items:center;gap:12px;margin-top:16px}.resume-banner strong{font-size:12px;display:block}.resume-banner small{display:block;color:#8c769d;font-size:10px;margin-top:4px}.section-label{font-size:13px;margin:27px 0 12px}.travel-summary{display:flex;align-items:center;gap:15px;background:#fff9;padding:16px 20px;border-radius:19px;margin-bottom:18px}.travel-summary .progress{flex:1;min-width:40px;margin:0}.travel-summary span{font-size:11px;color:#907ca0}.chapters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.chapter{border-radius:24px;overflow:hidden;border:1px solid #fff;background:linear-gradient(#faf5fc,#eadff3);position:relative}.chapter:nth-child(2){background:linear-gradient(#f5fbf8,#e2ecdf)}.chapter:nth-child(3){background:linear-gradient(#fff8f0,#f1e2e6)}.chapter-head{padding:22px 20px 0}.chapter-head h3{font-size:17px;margin:6px 0}.chapter-head small{font-size:10px;color:#a08da9}.trail{height:375px;position:relative;margin:0 5px}.trail>svg{position:absolute;width:100%;height:100%;inset:0}.level-stop{position:absolute;width:110px;transform:translate(-50%,-50%);text-align:center}.node{display:block;margin:auto;border:3px solid white;border-radius:50%;width:56px;height:56px;background:#cbb6df;color:white;font-size:21px;font-weight:900;box-shadow:0 5px 0 #a28bb9,0 9px 12px #8c749620}.node.done{background:#ba9dce}.node.current{background:#a17ac2;box-shadow:0 5px 0 #7b579b,0 0 0 7px #ffffff70;animation:glow 2s infinite}.node:disabled{opacity:1;background:#e3dce6;color:#b7a8c2;box-shadow:0 4px 0 #ccbfda}.level-stop strong{font-size:10px;display:block;margin-top:9px;color:#786785}.level-stop small{font-size:10px;color:#bd9254;letter-spacing:2px}.map-legend{text-align:center;font-size:10px;color:#9d8aa9;padding:18px}.partner-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.partner-card{background:#fff9;border:1px solid #fff;border-radius:24px;padding:18px;text-align:center}.partner-card.chosen{border:2px solid #b497cd;background:#f2e9fa}.partner-card svg{width:100%;max-width:160px;margin:auto}.partner-card h3{margin:12px 0 5px;font-size:18px}.partner-card p{min-height:40px;font-size:11px;color:#9b86a6;line-height:1.7}.partner-card button{width:100%;font-size:11px}.ability-note{padding:23px;background:#fff9;border:1px solid #fff;border-radius:22px;margin-top:20px;display:flex;gap:18px;align-items:center}.ability-note>span{font-size:31px;color:#a58ac1}.ability-note strong{font-size:13px}.ability-note p{font-size:11px;color:#95839f;line-height:1.8;margin-bottom:0}.challenge-hero,.result-card{max-width:610px;margin:auto;background:#fffaf8;border:1px solid #fff;border-radius:30px;padding:32px;text-align:center;box-shadow:var(--shadow)}.challenge-clock{font-size:80px;line-height:1.2;color:#a17bc1;font-weight:900;letter-spacing:-.08em;margin:15px 0}.challenge-clock small{font-size:15px;letter-spacing:0;color:#bc9bcd}.challenge-hero .primary,.result-card .primary,.result-card .secondary{width:100%;margin-top:12px}.challenge-rules{text-align:left;margin:20px 0;padding:17px 20px;border-radius:17px;background:#f4edf8;color:#96819f;font-size:12px;line-height:2}.result-art{width:130px;margin:0 auto}.result-score{font-size:44px;font-weight:900;color:#8d6bad;margin:12px 0 0;letter-spacing:-.04em}.result-label{font-size:10px;color:#b29bc0}.result-goals{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin:16px 0;color:#9b81ab;font-size:12px}.result-goals span{background:#f1e9f6;padding:8px 12px;border-radius:10px}.record-list{background:#fff9;border:1px solid white;border-radius:22px;padding:8px 20px}.record-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:1px solid var(--line);font-size:12px}.record-row:last-child{border:0}.record-row small{display:block;color:#ac97b7;font-size:10px;margin-top:5px}.record-stars{color:#bf945a;letter-spacing:2px;white-space:nowrap}.bottom-nav{display:flex;justify-content:center;gap:6px;width:fit-content;max-width:100%;margin:28px auto 8px;padding:6px;background:#fffdf9ed;border:1px solid #fff;border-radius:21px;box-shadow:0 8px 25px #77618d12;position:sticky;bottom:max(10px,env(safe-area-inset-bottom));z-index:8;backdrop-filter:blur(10px)}.bottom-nav button{border:0;background:none;border-radius:15px;padding:10px 24px;font-size:10px;color:#a390af}.bottom-nav button b{display:block;font-size:19px;font-weight:400;margin-bottom:3px}.bottom-nav button.active{background:#eee5f7;color:#86639f}.return-game{color:#86639f;background:#eee3f7}.screen a{color:var(--purple)}
@media(max-width:860px){.screen{min-height:70svh}.page-head{margin:12px 4px 20px}.screen-title{font-size:26px}.home-hero{padding:24px 20px;grid-template-columns:1fr 115px;border-radius:24px}.home-hero h1{font-size:32px}.home-hero .screen-copy{font-size:11px}.home-art{width:145px;margin-left:-22px;align-self:center}.home-actions{grid-column:1/-1;margin-top:16px;display:grid;grid-template-columns:1fr 1fr}.home-actions button{min-width:0;font-size:12px}.page-stat{padding:14px 5px}.page-stat strong{font-size:22px}.page-stat small{font-size:9px}.page-grid{gap:10px}.entry-card{padding:16px 13px;gap:9px;align-items:flex-start}.entry-card .entry-icon{width:35px;height:35px;border-radius:12px;font-size:20px}.entry-card strong{font-size:12px}.entry-card small{font-size:10px}.entry-arrow{display:none}.chapters{grid-template-columns:1fr}.trail{height:365px;max-width:380px;margin:auto}.chapter-head{padding:22px 23px 0}.partner-grid{grid-template-columns:1fr 1fr;gap:11px}.partner-card{padding:15px 12px}.partner-card p{font-size:10px}.bottom-nav{width:100%;gap:3px}.bottom-nav button{flex:1;padding:8px 3px}.challenge-hero,.result-card{padding:25px 19px}.travel-summary{padding:15px;gap:10px}.page-head .screen-copy{font-size:11px}.page-head .page-back{font-size:10px}.result-score{font-size:39px}}
.wish-room{margin:18px 0;padding:18px;background:#fffaf5;border:1px solid #eadff0;border-radius:24px}.room-scene{position:relative;overflow:hidden;border-radius:17px;background:linear-gradient(#e8def5 72%,#dbc1ab 72%);height:220px}.room-window{position:absolute;left:12%;top:22px;width:76px;height:88px;background:linear-gradient(#8499ca,#c2cbeb);border:7px solid #fff4dc;border-radius:40px 40px 5px 5px;box-shadow:inset 0 0 0 2px #a28fbb}.room-window:after{content:'✦';display:block;color:#fff3bd;font-size:28px;text-align:center}.room-guest{position:absolute;bottom:13px;left:37%;width:125px}.room-guest svg{width:100%}.room-lamp{position:absolute;left:9%;bottom:24px;font-size:44px;filter:grayscale(1);opacity:.25}.room-lamp.lit{filter:none;opacity:1;text-shadow:0 0 25px #ffd269}.room-table{position:absolute;right:6%;bottom:20px;width:72px;height:43px;border-top:10px solid #b58a74;border-left:6px solid #b58a74;border-right:6px solid #b58a74;text-align:center}.room-table span{position:relative;top:-44px;font-size:31px}.room-photo{position:absolute;right:8%;top:23px;border:5px solid #fff4db;background:#d8c4ed;border-radius:5px;padding:3px;display:flex;width:94px;height:66px;align-items:end}.room-photo svg{width:25%;height:auto}.room-placeholder{opacity:.3;filter:grayscale(1)}.room-caption{font-size:12px;line-height:1.8;margin:12px 0;color:#79648c}.room-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.room-step{font-size:11px;line-height:1.6;background:#f2ecf8;border-radius:12px;padding:9px;text-align:center}.room-step.earned{background:#fff0d2;color:#805d34}.room-step b{display:block;font-size:20px}.coach{display:flex;gap:10px;align-items:center;border:1px solid #e5d5ed;border-radius:15px;padding:10px;margin:0 0 10px;background:#fcf5ff;min-height:68px}.coach-avatar{width:38px;flex-shrink:0}.coach strong{display:block;font-size:12px}.coach p{font-size:11px;line-height:1.6;margin:3px 0;color:#816e92}.reward-note{padding:14px;background:#fff1d8;border:1px solid #ecd6a8;border-radius:15px;font-size:12px;line-height:1.8;margin:14px 0}.reward-note strong{display:block;font-size:16px}.lesson-recap{font-size:12px;color:#87659d;margin:10px 0}.room-steps button{border:0;width:100%;font:inherit;background:transparent;color:inherit}@media(max-width:360px){.wish-room{padding:12px}.room-step{font-size:10px}.room-guest{left:32%}}

/* Illustrated home: artwork is embedded for offline/mobile delivery. */
body.cover-home{background:#17152c}.cover-home .app{max-width:510px;padding:0;position:relative}.cover-home .top{position:absolute;top:max(12px,env(safe-area-inset-top));right:14px;z-index:10;margin:0}.cover-home .brand,.cover-home .footer{display:none}.cover-home .icon-btn{background:#221c4880;color:#fff4df;border-color:#fff5;backdrop-filter:blur(12px)}.cover-home .screen{min-height:0;animation:none}.cover-stage{position:relative;isolation:isolate;height:100svh;min-height:660px;max-height:1050px;overflow:hidden;background:#272443}.cover-paint{position:absolute;width:100%;height:100%;inset:0;object-fit:cover;object-position:50% 45%;z-index:-3}.cover-stage:before{content:'';position:absolute;inset:0;z-index:-2;background:linear-gradient(180deg,#18163d80 0%,transparent 32%,transparent 57%,#201635b8 78%,#151226 100%)}.cover-heading{position:absolute;top:8%;left:0;width:100%;text-align:center;color:#fff5de;text-shadow:0 3px 16px #171438,0 1px 2px #5e3c65}.cover-heading .screen-title{font-family:'STKaiti','KaiTi','Songti SC',serif;font-size:clamp(44px,11vw,66px);font-weight:900;letter-spacing:.06em;margin:0;line-height:1.3}.cover-heading p{font-size:12px;letter-spacing:.26em;margin:9px 0}.cover-heading small{font-size:9px;letter-spacing:.5em;color:#f3d4bc}.cover-controls{position:absolute;bottom:calc(100px + env(safe-area-inset-bottom));left:24px;right:24px;text-align:center;color:#fff2e0}.cover-line{font-family:'STKaiti','KaiTi',serif;font-size:20px;text-shadow:0 2px 8px #251429;margin:0 0 7px}.cover-progress{font-size:11px;letter-spacing:.08em;color:#f6e0d6;margin:0 0 17px}.cover-start{display:block;width:100%;min-height:60px;border:1px solid #fff1ba;border-radius:20px;background:linear-gradient(#fff0bd,#e7bd79);box-shadow:inset 0 2px 0 #fff9,0 5px 0 #99633e,0 9px 25px #0d082b70;color:#64402e;font-size:19px;font-weight:900;letter-spacing:.12em;text-shadow:0 1px #fff6}.cover-start span{float:right;margin-right:8px}.cover-shortcuts{display:flex;justify-content:center;gap:20px;margin-top:18px}.cover-shortcuts button{border:0;background:none;color:#fff2dd;font-size:11px;padding:6px 10px;text-shadow:0 1px 6px #21132c}.cover-home .bottom-nav{position:absolute;bottom:0;left:0;width:100%;max-width:none;margin:0;border:0;border-top:1px solid #f2d7b52b;border-radius:0;background:#1b172dd9;padding:8px 12px calc(10px + env(safe-area-inset-bottom));box-shadow:none}.cover-home .bottom-nav button{flex:1;padding:7px 3px;color:#c3b0ce}.cover-home .bottom-nav button.active{background:#f5d5a918;color:#ffe1a4}.cover-home .bottom-nav button b{font-size:22px}.cover-start:focus-visible,.cover-shortcuts button:focus-visible{outline:3px solid #fff;outline-offset:4px}@media(min-width:600px){.cover-home .app{box-shadow:0 0 100px #0008}.cover-stage{min-height:660px}}@media(max-height:700px){.cover-heading{top:9%}.cover-controls{bottom:90px}.cover-line{font-size:18px}.cover-progress{margin-bottom:12px}.cover-start{min-height:53px}.cover-shortcuts{margin-top:12px}}



/* Shared fantasy art direction: the cover and every inner route belong to one world. */
:root{--ink:#fff1d9;--muted:#cabbd8;--purple:#edc78a;--deep:#c296e7;--line:#b699cc40;--panel:#29213e;--shadow:0 18px 55px #08051370}
body{background:#161226;background-image:radial-gradient(ellipse at 15% 0,#57416c70,transparent 60%),radial-gradient(ellipse at 95% 65%,#293a6450,transparent 65%);color:var(--ink)}
body:not(.cover-home):before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;background-size:200% 200%;background-position:0 0;opacity:.18;filter:saturate(.7)}
.app{padding:20px 26px 16px;max-width:1080px}.top{margin-bottom:20px}.brand{font-family:'STKaiti','KaiTi',serif;font-size:21px;letter-spacing:.12em;color:#ffe3b0}.brand small{color:#bda6ce;letter-spacing:.18em}.brand-mark{background:linear-gradient(145deg,#8d6aab,#44345e);border:1px solid #dab883!important;box-shadow:0 3px 0 #251c37;color:#ffe3a6}.icon-btn{color:#ffe1ac;border:1px solid #c1a27650;background:#30253cd9;border-radius:12px}.top-right{gap:8px}.footer{color:#a594b5;font-size:10px}
.main{grid-template-columns:minmax(230px,1fr) 470px;gap:35px;align-items:start}.story{padding-top:25px}.eyebrow,.page-kicker{color:#ddbd8e;letter-spacing:.2em}.story h1{font-family:'STKaiti','KaiTi',serif;font-size:47px;color:#ffebc6;line-height:1.3}.story h1 span{color:#d8b4ed}.story>p,.story-note{color:#cabbd8}.illustration{max-width:370px;aspect-ratio:.95;margin:15px 0}.big-character{width:78%;left:10%;top:0}.orbit{display:none}.floating{z-index:2;background:#31263dd9;border:1px solid #ddbd7d80;box-shadow:0 8px 22px #10091c80}.f1{left:0;top:23%}.f2{right:0;top:10%}.f3{right:0;bottom:0}
.portrait-art{display:block;width:100%;aspect-ratio:1/1.7;background-image:url("");background-size:400% auto;background-repeat:no-repeat;background-position:0 0;border-radius:inherit}.portrait-1{background-position:33.333333% 0}.portrait-2{background-position:66.666667% 0}.portrait-3{background-position:100% 0}.big-character .portrait-art{border-radius:100px 100px 24px 24px;border:1px solid #f0d4aa70;box-shadow:0 15px 55px #100b2580;mask-image:linear-gradient(#000 85%,transparent)}
.companions{margin-top:28px;gap:12px}.companion{padding:3px;width:62px;background:#251e36;border-color:#a78ab360;border-radius:15px;overflow:hidden}.companion .portrait-art{aspect-ratio:1;border-radius:11px;background-position-y:18%}.companion span:not(.portrait-art){color:#e9d8ee;font-size:11px;margin:5px 0}.companion.active{border-color:#f3cd8e;background:#4a3659;box-shadow:0 0 15px #e5bd5e30}
.game{padding:15px;background:linear-gradient(150deg,#30233ee8,#171b32f5);border:1px solid #b9986866;border-radius:26px;box-shadow:0 0 0 4px #1d1730,0 18px 60px #080617a0,inset 0 1px 0 #f8ddb22b}.mode-tabs{background:#171329b3;border:1px solid #ab89aa30;border-radius:12px;padding:3px}.mode-tab{color:#af9bbd;font-weight:600;font-size:11px;padding:8px 5px}.mode-tab.active{background:linear-gradient(#72567d,#4a375e);color:#ffe3b0;box-shadow:inset 0 1px 0 #e7bb8d66}.level-head{margin:14px 2px 10px}.level-head h2{font-family:'STKaiti','KaiTi',serif;font-size:21px;color:#ffe8bd}.level-head small{color:#b9a6c7}.map-btn{background:#292039;color:#ead2b2;border-color:#b08e694d}.hud{gap:8px}.metric{padding:9px 11px;background:linear-gradient(135deg,#392e4c,#211b34);border:1px solid #b9a2c12b;border-radius:13px}.metric span{color:#c6b2d2}.metric strong{color:#fff0cc;font-size:25px}.metric.moves{background:radial-gradient(ellipse at top,#876344,#4c3446);border:1px solid #e6c18a75;flex-basis:78px}.metric.moves strong{color:#ffe8ad}.target strong{font-size:13px}.progress{background:#130e24;border:1px solid #c0a3be22;height:6px}.progress>i{background:linear-gradient(90deg,#bb82eb,#ffe0a1);box-shadow:0 0 12px #e6abf1}
.coach{background:linear-gradient(100deg,#52395880,#241e3590);border:1px solid #b992c039;border-radius:14px;padding:8px 10px;min-height:61px;gap:11px}.coach-avatar{width:43px;border:1px solid #d4ae7c80;border-radius:50%;overflow:hidden;flex-shrink:0}.coach-avatar .portrait-art{aspect-ratio:1;background-position-y:18%}.coach strong{color:#f3d4a6;font-size:11px}.coach p{color:#dacbe4;font-size:10px;line-height:1.6;margin:3px 0}
.board-shell{padding:8px;border:1px solid #e1bd8666;border-radius:20px;background:linear-gradient(135deg,#a77c5859,#493957 30%,#25273e 70%,#94725270);box-shadow:0 7px 24px #0c071b90,inset 0 1px 2px #ffdda644}.board{border-radius:12px;background-color:#151527;background-image:linear-gradient(90deg,#76628a25 1px,transparent 1px),linear-gradient(#76628a25 1px,transparent 1px);background-size:14.285714% 14.285714%}.tile{padding:3px}.tile-face{border:1px solid #9d81bf20!important;border-radius:10px;background:linear-gradient(145deg,#51416670,#29233f70)!important;box-shadow:inset 0 1px 0 #d3b5ff12,0 2px 2px #08061580}.tile:nth-child(2n) .tile-face{background:linear-gradient(145deg,#44365365,#201e3860)!important}.tile svg{width:90%;height:94%;filter:drop-shadow(0 3px 2px #0b061b90);overflow:visible}.tile.selected .tile-face{outline:2px solid #ffe3a5;outline-offset:0;box-shadow:0 0 15px #ffcd8f70;filter:brightness(1.3)}.tile[data-s='row'] .tile-face,.tile[data-s='col'] .tile-face{border:1px solid #fff2be!important;box-shadow:0 0 12px #eccd7c6b,inset 0 0 10px #fff2}.special{color:#fff6cc;text-shadow:0 0 6px #ffde84,0 2px 4px #130b1f;font-size:29px}.tile[data-s='rainbow'] .tile-face{background:conic-gradient(#d34e91aa,#5068ceaa,#44b895aa,#dfae57aa,#d34e91aa)!important;box-shadow:0 0 16px #d6b4f385}.board-caption{color:#bca9cf;font-size:10px;min-height:26px}.tool{background:linear-gradient(#44334e,#2a233b);border:1px solid #b79b763f;color:#f0d7b5;border-radius:12px;padding:10px 4px;box-shadow:0 3px 0 #171124}.tool b{background:#18152a;color:#c5afda}.tool.on{background:#654369;border-color:#f6d093}.skill-box{margin-top:12px;padding:10px 0 0;border-top:1px solid #ae8cbb30;gap:10px}.skill-avatar{width:44px;height:44px;padding:0;overflow:hidden;border:1px solid #d7b274;border-radius:50%}.skill-avatar .portrait-art{aspect-ratio:1;background-position-y:18%}.skill-info strong{color:#ffe1ac}.skill-info small{color:#bfadcd}.skill-btn{background:linear-gradient(#6a4c87,#44335f);color:#f4d9fd;border:1px solid #b28dcd66;border-radius:12px}.skill-btn.ready{background:linear-gradient(#ffe6ac,#d29b55);border-color:#fff0ca;color:#4c2f32;box-shadow:0 0 20px #f6bf5950}
.screen-title{font-family:'STKaiti','KaiTi',serif;color:#ffdfaa;font-size:35px}.screen-copy{color:#c9b9d6}.page-head{padding:12px 2px 18px;border-bottom:1px solid #c6a16c30;margin-bottom:19px}.page-back,.secondary{background:linear-gradient(#40314f,#2a233b);border:1px solid #b79b7666;color:#eed7b8}.primary{background:linear-gradient(#ffe5ab,#d7a865);color:#533632;box-shadow:0 4px 0 #835835,inset 0 1px 0 #fff4d5;border:1px solid #ffdfa3;font-size:13px}.page-stat{background:linear-gradient(#382944dd,#241d36dd);border:1px solid #b79b763b}.page-stat strong{color:#f8d394}.page-stat small{color:#c8b5d2}.travel-summary{background:#30253bba;border:1px solid #caa36c3d}.travel-summary span{color:#eddbba}.chapters{gap:18px}.chapter{background-size:200% 200%!important;background-position:0 0!important;border:1px solid #dab67c75;border-radius:23px;box-shadow:0 12px 30px #08051366;isolation:isolate}.chapter:nth-child(2){background-position:100% 0!important}.chapter:nth-child(3){background-position:0 100%!important}.chapter:before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(#120e2abf,transparent 45%,#120e2ab3)}.chapter-head{padding:20px 20px 6px}.chapter-head h3{font-family:'STKaiti','KaiTi',serif;color:#ffe5b7;font-size:24px;margin:7px 0}.chapter-head small{color:#e4d5e9}.trail{height:375px}.trail>svg{filter:drop-shadow(0 2px 5px #170e2d)}.trail>svg path:first-child{stroke:#20132f8c;stroke-width:14}.trail>svg path:last-child{stroke:#f3d9a8;stroke-width:2;stroke-dasharray:3 9}.node{background:linear-gradient(#8f68a1,#4f3c68);border:2px solid #eacb91;color:#ffedc6;box-shadow:0 4px 0 #35203c,0 7px 16px #0e0b2d99}.node.done{background:linear-gradient(#bfa166,#7b5a44);border-color:#fff1bf}.node.current{background:linear-gradient(#fff0b9,#e4ad5e);color:#69442e;border-color:#fff7d6;box-shadow:0 4px 0 #93633e,0 0 0 6px #ffebb83b,0 0 28px #ffe7a675}.node:disabled{background:linear-gradient(#544c65,#302b43);border-color:#9e94b180;color:#d6c9e0;box-shadow:0 4px 0 #242037}.level-stop strong{color:#fff0d7;text-shadow:0 1px 5px #09061e;font-size:11px;background:#1c142ab3;border-radius:8px;padding:4px 3px;margin-top:8px}.level-stop small{color:#ffdb8a;text-shadow:0 2px 4px #130d28}.map-legend{color:#c3afd0;line-height:1.7}
.partner-grid{gap:15px}.partner-card{padding:0 0 16px;overflow:hidden;border:1px solid #b796655c;background:linear-gradient(#47304f,#211b32);border-radius:20px;box-shadow:0 10px 25px #09051b40}.partner-card.chosen{padding:0 0 15px;border:2px solid #f3cc88;background:linear-gradient(#66485f,#30213d);box-shadow:0 0 25px #f3be6c22}.partner-card>.portrait-art{border-radius:0;aspect-ratio:1/1.55;mask-image:linear-gradient(#000 80%,transparent)}.partner-card h3{font-family:'STKaiti','KaiTi',serif;font-size:24px;color:#ffe0ac;margin:0 0 7px}.partner-card p{color:#cdbbd6;margin:0 10px 12px;font-size:11px;min-height:35px}.partner-card button{width:calc(100% - 28px);font-size:11px}.ability-note{background:#2d233bcf;border:1px solid #b3977245;color:#e9d1ad}.ability-note>span{color:#f2cd8c}.ability-note p{color:#c5b1d1}
.wish-room{padding:18px;background:linear-gradient(140deg,#382842e8,#201a30f0);border:1px solid #c4a17150;border-radius:22px;box-shadow:0 12px 40px #10081d40;margin:18px 0 25px}.wish-room h2{font-family:'STKaiti','KaiTi',serif;color:#ffe0af}.room-scene{height:310px;background-size:200% 200%;background-position:100% 100%;border:1px solid #ddbb7b65;border-radius:15px;box-shadow:inset 0 -50px 60px #170e2880}.room-moonbeam{position:absolute;inset:0;background:linear-gradient(130deg,transparent 25%,#dabef812 40%,transparent 70%);pointer-events:none}.room-guest{left:auto;right:6%;bottom:18px;width:108px;border:1px solid #f4cf9260;border-radius:65px 65px 12px 12px;overflow:hidden;box-shadow:0 8px 25px #08051cb3}.room-guest .portrait-art{aspect-ratio:1/1.4}.room-guest>span:not(.portrait-art){display:block;text-align:center;background:#24162de6;color:#ffe0b2;font-size:10px;padding:6px 2px}.room-lamp{left:13%;bottom:22px;width:48px;height:70px;display:grid;place-items:center;border:2px solid #bfa47e66;border-radius:18px 18px 8px 8px;background:#251b30;font-size:37px;color:#ffe4a5;opacity:.25}.room-lamp.lit{background:radial-gradient(#fff8b6,#dd963f9c 60%,#5c365300);box-shadow:0 0 40px #ffbf6470;color:#fff5bd;text-shadow:0 0 16px #ffe173;border-color:#ffe6ae}.room-table{right:auto;left:36%;bottom:26px;width:57px;height:40px;border-color:#8e593b;filter:drop-shadow(0 5px 6px #170b2280)}.room-table span{font-size:33px;top:-39px}.room-photo{right:7%;top:18px;width:110px;height:67px;border:4px double #deb374;box-shadow:0 3px 10px #0f061c;background:#25172e;color:#d6be9b;font-size:11px;justify-content:center;align-items:center}.room-photo .portrait-art{width:25%;height:100%;aspect-ratio:auto;border-radius:0;background-size:400% auto}.room-caption{color:#cebbd7;font-size:12px}.room-step{background:#251d35;border:1px solid #b69b7133;color:#ad9bbf}.room-step.earned{background:linear-gradient(#67503f,#443044);border-color:#dcb78375;color:#ffe5b6}.room-step b{color:#f4d59f}
.challenge-hero,.result-card{position:relative;isolation:isolate;overflow:hidden;border:1px solid #dbb47c66;border-radius:25px;background:linear-gradient(#322343ee,#1d192ef5);box-shadow:0 18px 50px #09061d80}.challenge-hero:before,.result-card:before{content:'';position:absolute;inset:0;z-index:-1;background-size:200% 200%;background-position:0 100%;opacity:.24;mask-image:linear-gradient(#000,transparent 80%)}.challenge-clock{color:#ffe0a5;text-shadow:0 0 35px #ffc76c30;font-family:Georgia,serif;font-size:85px}.challenge-clock small{color:#dbc4e2}.challenge-hero h2{font-family:'STKaiti','KaiTi',serif;color:#ffdfb2}.challenge-rules{background:#1e172cbd;color:#d0bddc;border:1px solid #ae8abb2b;font-size:11px}.result-art{width:150px;height:180px;margin:8px auto;overflow:hidden;border:1px solid #e7bd7f;border-radius:80px 80px 20px 20px;box-shadow:0 0 55px #d7a4eb33}.result-art .portrait-art{height:100%;aspect-ratio:auto;background-position-y:10%}.stars{color:#ffd992;text-shadow:0 0 20px #fdbe6a50;font-size:35px}.result-score{color:#ffe2a5}.result-label{color:#c4abd1}.result-goals{color:#e2c8a5}.result-goals span{background:#34283e;border:1px solid #b3986933}.reward-note{background:linear-gradient(125deg,#73513f70,#48324a90);color:#f9dfb6;border-color:#cfad6b70}.lesson-recap{color:#e0bfdf}.record-list{background:#251d35dc;border:1px solid #c0a07840}.record-row{border-bottom-color:#b396bc26;color:#eedcbe}.record-row small{color:#bca6cd}.record-stars{color:#f2c77c}.section-label{color:#ecd5b5}
.bottom-nav{background:#211a30ed;border:1px solid #c5a17450;box-shadow:0 10px 35px #09051d99}.bottom-nav button{color:#b8a1c9}.bottom-nav button.active{color:#ffe1a1;background:linear-gradient(#64455a70,#3d2b4760)}.dialog{background:linear-gradient(140deg,#3e2c4f,#211b32);border:1px solid #d7b37b80;box-shadow:0 25px 100px #080516bf;color:#ffe5bc}.dialog h2{font-family:'STKaiti','KaiTi',serif}.dialog p{color:#c9b5d7}.dialog-icon{color:#f0cc92}.veil{background:#0e0925b8;backdrop-filter:blur(9px)}.rule{border-color:#b395bd30;color:#e7d3e6}.rule b{color:#edc68d}.rule small{color:#bfa9cc}.settings-row{border-color:#b395bd30;color:#e7d4c2}.switch{background:#251c34;color:#d8bde5;border:1px solid #b693c250}.switch[aria-pressed=true]{background:#795782;color:#fff0d0}.level-button{background:#3f2f50;border-color:#b695c45c;color:#ffe2b8}.level-button small{color:#f6cc82}.toast{background:#473253;border:1px solid #cdad7b;color:#ffebc7}.low{color:#ff9e9c!important}
@media(max-width:860px){.app{padding:10px 10px 14px;max-width:490px}.top{margin-bottom:12px}.brand{font-size:18px}.brand small{font-size:7px}.game{padding:11px;border-radius:21px}.level-head h2{font-size:19px}.level-head small{font-size:9px}.metric{padding:8px 10px}.metric strong{font-size:23px}.target strong{font-size:12px}.board-shell{padding:6px;border-radius:17px}.tile{padding:2px}.tile-face{border-radius:8px}.board-caption{font-size:9px}.coach{padding:7px 9px;min-height:56px}.coach-avatar{width:38px}.coach p{font-size:10px}.skill-box{margin-top:9px;padding-top:9px}.screen-title{font-size:31px}.page-head{margin:7px 2px 17px;padding:8px 0 15px}.chapters{gap:22px}.chapter-head{padding:23px 22px 7px}.trail{height:390px;max-width:390px}.chapter-head h3{font-size:26px}.chapter{background-size:200% 200%!important}.partner-grid{gap:12px}.partner-card h3{font-size:23px}.partner-card>.portrait-art{aspect-ratio:1/1.55}.room-scene{height:265px}.wish-room{padding:13px}.room-guest{width:87px;right:5%}.room-photo{width:87px;height:59px}.room-step{padding:7px 3px;font-size:10px}.challenge-hero,.result-card{padding:24px 19px}.bottom-nav{margin-top:22px}.page-stat{padding:14px 5px}}
@media(max-width:360px){.app{padding:8px}.game{padding:9px}.metric{padding:6px 7px}.metric.moves{flex-basis:60px}.target strong{font-size:11px}.coach p{font-size:9px}.coach-avatar{width:33px}.coach{gap:8px}.tool{font-size:10px;padding:9px 2px}.skill-avatar{width:37px;height:37px}.skill-info small{font-size:8px}.room-scene{height:235px}.room-guest{width:72px}.room-photo{width:75px;height:50px}.room-lamp{left:10%;width:37px;height:57px}.room-table{left:34%;width:45px}.room-caption{font-size:11px}.partner-card button{font-size:10px;width:calc(100% - 18px)}}


.chapter,body:not(.cover-home):before,.room-scene:before,.challenge-hero:before,.result-card:before{background-image:url("data:image/jpeg;base64,")!important}

.room-scene{background-image:none;max-width:650px;margin:auto;height:360px;isolation:isolate}.room-scene:before{content:'';position:absolute;z-index:-1;width:100%;aspect-ratio:1;left:0;top:50%;transform:translateY(-50%);background-size:200% 200%;background-position:100% 100%}.chapter{background-size:auto 200%!important}@media(max-width:860px){.room-scene{height:265px}.chapter{background-size:auto 200%!important}}@media(max-width:360px){.room-scene{height:235px}}@media(min-width:861px) and (max-height:800px){.main{grid-template-columns:minmax(230px,1fr) 410px}.game{padding:11px}.coach{min-height:50px;padding:6px 9px}.level-head{margin:10px 2px 8px}.metric{padding:6px 9px}.story h1{font-size:39px}.illustration{max-width:270px}.story{padding-top:15px}.story>p{font-size:12px}.companions{margin-top:15px}.app{padding-top:12px}.top{margin-bottom:13px}}

.room-table{border:0;width:44px;height:64px;left:37%;bottom:23px;filter:drop-shadow(0 5px 5px #170b2280)}.room-table span{display:block;position:static;top:auto;width:100%;height:100%}.room-table svg{width:100%;height:100%}.room-photo .portrait-art{background-position-y:18%}.room-placeholder{opacity:.2}.coach p{line-height:1.65}@media(max-width:360px){.room-table{width:37px;height:54px;left:35%;bottom:22px}}
</style>
<style>.dialog:has(.el-lab){width:440px;padding:20px}.dialog .el-lab h2{font-size:19px}.dialog .el-lab .el-copy{margin-bottom:12px}.dialog .el-board{margin:12px 0;padding:18px}</style><style>.dialog:has(.el-lab){width:440px;padding:20px}.dialog .el-lab h2{font-size:19px}.dialog .el-lab .el-copy{margin-bottom:12px}.dialog .el-board{margin:12px 0;padding:18px}</style><style>.dialog:has(.el-lab){width:440px;padding:20px}.dialog .el-lab h2{font-size:19px}.dialog .el-lab .el-copy{margin-bottom:12px}.dialog .el-board{margin:12px 0;padding:18px}</style>

















































































































































































































<style id="integrationStyle">.element-panel{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0 14px;font-size:11px;color:#e8d8bd}.element-panel button,.element-panel select{color:#f9e6bd;background:#352b47;border:1px solid #bda36c66;border-radius:9px;padding:7px;font:inherit}.element-panel>span{flex:1;min-width:120px}.element-panel label{width:100%}.tile[data-k="6"] .tile-face{background:radial-gradient(ellipse at 30% 20%,#b8ffdb,#255e66 70%)}.tile{overflow:visible!important}.tile .ef-host{z-index:3;pointer-events:none}.aura-age{position:absolute;right:3px;bottom:3px;font-size:10px;background:#21182ecc;color:#fff;border-radius:8px;padding:0 3px;z-index:8}.aura-age:empty{display:none}.buff-mark{position:absolute;top:0;left:0;z-index:8;font-size:18px;color:#dcffc3;text-shadow:0 0 8px #7eff5b}.reaction-overlay{position:absolute;width:14.2857%;height:14.2857%;pointer-events:none;z-index:18}.field-mark{position:absolute;transform:translate(-50%,-50%);font-size:13px;font-weight:bold;color:#efffc1;text-shadow:0 0 5px #87eb32;z-index:10;pointer-events:none;background:#192a24dc;border-radius:10px;padding:1px 5px}.field-mark.burn{color:#ffc582;background:#502e29e8}.field-mark.crystal{color:#ffeab2;background:#514025e8}.element-legend{display:flex;flex-wrap:wrap;gap:10px}.element-legend span{display:flex;align-items:center;font-size:12px}.element-legend svg{width:28px;height:30px}.reaction-row{padding:10px 0;border-bottom:1px solid #af98cf33;display:grid;gap:5px;text-align:left}.reaction-row small{line-height:1.6;color:#c8bed8}.premium-portrait{width:150px;height:190px;overflow:hidden;border-radius:80px 80px 20px 20px;margin:0 auto 15px;border:1px solid #c6a679}.premium-portrait .portrait-art{width:100%;height:100%;border-radius:0}.partner-card>strong{display:block;font-size:14px;color:#efce8b;margin-top:12px}.partner-card>small{display:block;color:#c4b5cc;margin:12px 0}.partner-card>p{line-height:1.7}.reward-art{display:block;background-size:300% 100%;aspect-ratio:1;border:1px solid #bc9b6155;border-radius:18px;box-shadow:0 12px 25px #100b214d}.reward-0{background-position:0 0}.reward-1{background-position:50% 0}.reward-2{background-position:100% 0}.reward-note .reward-art{width:140px;margin:8px auto 15px}.room-steps .reward-art{width:100%;border-radius:12px;margin-bottom:8px}.room-steps button{width:100%}.room-step:not(.earned) .reward-art{filter:saturate(.2) brightness(.5)}.room-treasure{position:absolute;bottom:8%;width:24%;z-index:5;transform:rotate(-4deg);animation:treasure-glow 4s ease-in-out infinite}.room-treasure.reward-0{left:4%}.room-treasure.reward-1{left:36%;bottom:5%;transform:rotate(2deg)}.room-treasure.reward-2{right:4%;bottom:13%;transform:rotate(5deg)}.room-guest{bottom:32%!important}.room-scene{min-height:330px!important}.room-lamp,.room-table,.room-photo{display:none!important}@keyframes treasure-glow{50%{box-shadow:0 0 22px #d2aa5959}}.reduced .room-treasure{animation:none}@media(max-width:430px){.partner-grid{grid-template-columns:1fr!important}.partner-card .portrait-art{height:260px!important;max-height:none!important;background-position-y:16%!important}.room-scene{min-height:300px!important}.room-step button{padding:6px;font-size:11px}.element-panel{font-size:10px}}@media(prefers-reduced-motion:reduce){.room-treasure{animation:none}}
.tile[data-aura="fire"]{--aura:#ff996c}.tile[data-aura="water"]{--aura:#6cdaff}.tile[data-aura="ice"]{--aura:#d5f5ff}.tile[data-aura="lightning"]{--aura:#d6a2ff}.tile[data-aura="grass"]{--aura:#addb7e}.tile[data-aura="wind"]{--aura:#82e2c1}.tile[data-aura="rock"]{--aura:#e8c37c}
.aura-shell{position:absolute;inset:5%;border:1.5px solid var(--aura);border-radius:12px;z-index:4;color:var(--aura);pointer-events:none;box-shadow:inset 0 0 6px #ffffff0a;overflow:hidden}
.aura-trace{position:absolute;inset:0;border-radius:inherit;border-bottom:2px solid currentColor;opacity:.38;animation:aura-breathe 3.6s ease-in-out infinite}
.aura-chip{position:absolute;right:0;top:0;font-size:clamp(9px,1.8vw,12px);line-height:1.25;min-width:15px;text-align:center;padding:2px 3px;background:#211a32;border-radius:0 8px 0 6px;font-weight:700}
.aura-dots{position:absolute;right:2px;bottom:0;font:12px/1 system-ui;letter-spacing:1px;color:var(--aura)}
.aura-arrival{position:absolute;inset:0;border:3px solid currentColor;border-radius:inherit;animation:aura-arrive .55s ease-out both;pointer-events:none}
.tile[data-aura="water"] .aura-trace{animation-name:aura-tide}.tile[data-aura="wind"] .aura-trace{border-bottom:0;border-left:2px solid currentColor;animation-name:aura-wind}.tile[data-aura="lightning"] .aura-trace{animation:aura-spark 4.5s steps(1) infinite}.tile[data-aura="ice"] .aura-shell{border-style:dashed}.tile[data-aura="rock"] .aura-shell{border-radius:5px}.tile[data-aura="grass"] .aura-trace{border-radius:12px 12px 18px 6px}
#board .buff-mark{left:8%;top:8%;font-size:11px;line-height:1;background:#211a32;border-radius:4px;padding:2px;text-shadow:none;z-index:5}
#board .field-mark{font-size:10px;line-height:1;padding:2px 5px;border:1px solid #b0a08088;border-radius:5px;text-shadow:none;box-shadow:none;max-width:8%;z-index:5}
.tile.reaction-preview:after{content:attr(data-preview);position:absolute;left:7%;top:auto;bottom:7%;background:#fff1c9;color:#372642;border-radius:5px;padding:2px 4px;font-size:10px;z-index:12;box-shadow:0 0 0 1px #614c36}
.element-panel{align-items:flex-start;gap:6px;margin-top:10px}.element-panel>span{font-size:11px;line-height:1.7;min-width:150px;padding:5px 0;min-height:28px}.element-panel button{font-size:11px}
@keyframes aura-breathe{0%,100%{opacity:.28}50%{opacity:.65}}@keyframes aura-tide{0%,100%{opacity:.3;transform:translateY(0)}50%{opacity:.6;transform:translateY(-2px)}}@keyframes aura-wind{0%,100%{opacity:.3;transform:translateY(2px)}50%{opacity:.65;transform:translateY(-2px)}}@keyframes aura-spark{0%,86%,94%,100%{opacity:.25}88%,92%{opacity:.8}}@keyframes aura-arrive{0%{opacity:0;box-shadow:inset 0 0 20px currentColor;transform:scale(.72)}30%{opacity:.9}100%{opacity:0;transform:scale(1)}}
.reduced .aura-trace,.reduced .aura-arrival{animation:none}.reduced .aura-arrival{display:none}@media(prefers-reduced-motion:reduce){.aura-trace,.aura-arrival{animation:none}.aura-arrival{display:none}}
.edition-label{max-width:700px;margin:0 auto;padding:7px 12px;text-align:center;font:10px/1.5 system-ui;color:#d3c4df;background:#211b31;letter-spacing:.03em}
/* All idle particles are clipped by this shell; only reaction bursts leave a tile. */
#board .aura-shell{inset:5%;overflow:hidden;contain:paint;isolation:isolate;border-width:1.5px;box-shadow:inset 0 -5px 12px -8px var(--aura)}
.aura-flow{position:absolute;inset:0;pointer-events:none;overflow:hidden;border-radius:inherit}
.aura-flow i{position:absolute;display:block;background:currentColor;opacity:.8;box-shadow:0 0 4px currentColor;will-change:transform,opacity}
.aura-flow i:nth-child(1){--n:0}.aura-flow i:nth-child(2){--n:1}.aura-flow i:nth-child(3){--n:2}.aura-flow i:nth-child(4){--n:3}
.aura-chip{z-index:2;font-size:9px;opacity:.85}.aura-dots{z-index:2;background:#211a32b0;border-radius:3px}
.tile[data-aura="fire"] .aura-flow{background:linear-gradient(0deg,#ff722b30,transparent 42%)}
.tile[data-aura="fire"] .aura-flow i{width:15%;height:30%;left:calc(5% + var(--n)*25%);bottom:-6%;border-radius:80% 15% 55% 40%;background:linear-gradient(0deg,#ff633e,#ffbf65 65%,#fff4b8);transform-origin:50% 100%;animation:aura-fire-inner 1.55s ease-in-out infinite;animation-delay:calc(var(--n)*-.32s)}
.tile[data-aura="water"] .aura-flow{background:linear-gradient(0deg,#51cdff30,transparent 40%)}
.tile[data-aura="water"] .aura-flow i{left:-10%;bottom:calc(-4% + var(--n)*6%);width:120%;height:22%;border:1.5px solid #9beaff;border-radius:50%;background:transparent;box-shadow:none;animation:aura-water-inner 2.5s ease-in-out infinite;animation-delay:calc(var(--n)*-.55s)}
.tile[data-aura="ice"] .aura-flow i{width:18%;height:26%;left:calc(1% + var(--n)*26%);bottom:calc(2% + var(--n)*2%);clip-path:polygon(50% 0,100% 35%,75% 100%,25% 100%,0 35%);background:linear-gradient(120deg,#fff,#a8eaff88);box-shadow:none;animation:aura-ice-inner 2.8s ease-in-out infinite;animation-delay:calc(var(--n)*-.6s)}
.tile[data-aura="ice"] .aura-flow i:nth-child(even){top:4%;bottom:auto;height:19%;transform:rotate(180deg)}
.tile[data-aura="lightning"] .aura-flow i{width:19%;height:62%;top:20%;left:1%;clip-path:polygon(55% 0,95% 0,55% 38%,100% 38%,14% 100%,40% 54%,0 54%);background:linear-gradient(#f7e7ff,#bd7dff,#f1d9ff);animation:aura-lightning-inner 2.2s ease-in-out infinite;animation-delay:calc(var(--n)*-.55s)}
.tile[data-aura="lightning"] .aura-flow i:nth-child(even){left:auto;right:1%;top:28%;height:52%;transform:rotate(180deg)}
.tile[data-aura="lightning"] .aura-flow i:nth-child(n+3){height:20%;width:30%;left:35%;top:auto;bottom:0;transform:rotate(65deg)}
.tile[data-aura="grass"] .aura-flow i{width:22%;height:12%;left:0;top:calc(28% + var(--n)*16%);border-radius:100% 0 100% 0;background:linear-gradient(30deg,#78be49,#d1f7a8);transform-origin:left center;animation:aura-leaf-inner 2.4s ease-in-out infinite;animation-delay:calc(var(--n)*-.45s)}
.tile[data-aura="grass"] .aura-flow i:nth-child(even){left:auto;right:0;transform-origin:right center;border-radius:0 100% 0 100%}
.tile[data-aura="wind"] .aura-flow i{inset:calc(3% + var(--n)*5%);border:2px solid transparent;border-top-color:#a9ffe0;border-bottom-color:#7bdbb780;background:transparent;border-radius:50%;box-shadow:none;animation:aura-wind-inner 2.8s linear infinite;animation-delay:calc(var(--n)*-.6s)}
.tile[data-aura="wind"] .aura-flow i:nth-child(n+3){display:none}
.tile[data-aura="rock"] .aura-flow i{width:16%;height:21%;left:calc(1% + var(--n)*27%);bottom:2%;background:linear-gradient(130deg,#fff0b2,#c39751);clip-path:polygon(30% 0,85% 15%,100% 68%,55% 100%,0 75%,8% 20%);box-shadow:none;animation:aura-rock-inner 3.2s ease-in-out infinite;animation-delay:calc(var(--n)*-.65s)}
.tile[data-aura="rock"] .aura-flow i:nth-child(even){bottom:auto;top:5%;height:17%}
@keyframes aura-fire-inner{0%,100%{transform:scale(.65,.65) rotate(-8deg);opacity:.55}50%{transform:scale(.9,1.15) rotate(8deg);opacity:.95}}
@keyframes aura-water-inner{0%,100%{transform:translate(-3%,0) rotate(-5deg);opacity:.4}50%{transform:translate(4%,-20%) rotate(5deg);opacity:.85}}
@keyframes aura-ice-inner{0%,100%{opacity:.4;filter:brightness(.9)}50%{opacity:.95;filter:brightness(1.3)}}
@keyframes aura-lightning-inner{0%,100%{opacity:.22;filter:brightness(.8)}40%,60%{opacity:.9;filter:brightness(1.3)}}
@keyframes aura-leaf-inner{0%,100%{transform:rotate(-14deg) scale(.8);opacity:.6}50%{transform:rotate(15deg) scale(1.05);opacity:.95}}
@keyframes aura-wind-inner{to{transform:rotate(360deg)}}
@keyframes aura-rock-inner{0%,100%{transform:translateY(0) rotate(-10deg);opacity:.65}50%{transform:translateY(-25%) rotate(12deg);opacity:.95}}
.reduced .aura-flow i{animation:none!important;will-change:auto;opacity:.6}@media(prefers-reduced-motion:reduce){.aura-flow i{animation:none!important;will-change:auto;opacity:.6}}

.portrait-art{background-size:cover!important;background-position:50% 18%!important}.partner-card>.portrait-art{aspect-ratio:1;height:auto!important}.portrait-4{background-position:50% 12%!important}.portrait-1{background-image:url("data:image/webp;base64,")}
.portrait-2{background-image:url("data:image/webp;base64,")}
.portrait-3{background-image:url("data:image/webp;base64,")}
.portrait-4{background-image:url("data:image/webp;base64,")}.reward-art{background-image:url("data:image/webp;base64,")}
</style>
<style id="mobileFlowStyle">/* A portrait game shell rather than a document with a game embedded in it. */
body{background:#141123;overscroll-behavior-y:none}body .app{width:100%;max-width:480px;height:100svh;height:100dvh;min-height:0;padding:0;display:flex;flex-direction:column;margin:auto;overflow:hidden;background:#211a31;box-shadow:0 0 70px #0008}body .top{flex:none;padding:10px 16px;margin:0;height:60px;border-bottom:1px solid #d0b5e01c;background:#211a31e6}body .brand{font-size:17px}body .brand small{font-size:8px;letter-spacing:.12em}body .brand-mark{width:32px;height:32px;font-size:22px}body .top-right{gap:7px}body .icon-btn{width:33px;height:33px}body .screen{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;width:100%;padding:16px;scrollbar-width:thin}body .footer{display:none}body .bottom-nav{position:relative;bottom:auto;flex:none;display:grid;grid-template-columns:repeat(4,1fr);width:100%;max-width:none;margin:0;padding:6px 8px max(7px,env(safe-area-inset-bottom));border-radius:0;border:0;border-top:1px solid #d8ba7733;background:#241c34;box-shadow:none;gap:4px}body .bottom-nav button{min-width:0;width:100%;padding:5px 3px;font-size:11px;border-radius:12px}body .bottom-nav b{font-size:22px}body .bottom-nav [aria-current=page]{background:#58405b;color:#ffe5af}body .edition-label{position:fixed;left:calc(50% - 60px);bottom:1px;width:120px;max-width:none;padding:0;z-index:0;font-size:8px;opacity:.4;pointer-events:none}body [hidden]{display:none!important}
body[data-screen=splash] .top,body[data-screen=splash] .edition-label{display:none}body.cover-home .app{max-width:480px;padding:0}body.cover-home .screen{padding:0;overflow:hidden}body .cover-stage{height:100%;height:100dvh;min-height:0;max-height:none}.cover-home .cover-shortcuts{display:none}.cover-home .cover-start{min-height:58px}.cover-home .cover-content{bottom:8%}.cover-home .cover-progress{font-size:12px}
body[data-screen=home] .screen{padding:0;overflow:hidden}.lobby{height:100%;display:flex;flex-direction:column;position:relative}.lobby-top{position:absolute;left:14px;right:14px;top:12px;display:flex;justify-content:space-between;z-index:3;font-size:11px}.lobby-top span{background:#211a31c9;border:1px solid #dac19744;padding:6px 10px;border-radius:18px}.lobby-scene.room-scene{flex:1;width:100%;height:auto!important;min-height:180px!important;border:0;border-radius:0;overflow:hidden;margin:0}.lobby-scene:before{filter:brightness(.72)}.lobby-person{position:absolute;width:64%;height:88%;bottom:0;left:18%;mask-image:linear-gradient(#000 72%,transparent)}.lobby-person .portrait-art{height:100%;width:100%;border-radius:120px 120px 0 0;background-position:center 15%!important;box-shadow:0 0 35px #b091bd36}.lobby-glow{position:absolute;inset:8% 3%;background:radial-gradient(ellipse,#dcc6f533,transparent 65%)}.lobby-greeting{position:absolute;left:14px;right:14px;bottom:14px;z-index:3;padding:10px 15px;border:1px solid #dec8a95c;border-radius:16px;background:#261d36dd;backdrop-filter:blur(8px)}.lobby-greeting small{color:#ebc78a;font-size:11px}.lobby-greeting p{font-size:14px;margin:3px 0}.lobby-side{position:absolute;top:24%;z-index:4;width:66px;padding:8px 4px;color:#f4e2c9;font-size:10px;border:1px solid #dfbd7655;border-radius:15px;background:#33253ad9;box-shadow:0 4px 15px #0003}.lobby-side b{display:block;font-size:24px;line-height:1.2}.side-challenge{right:10px}.side-room{left:10px;top:48%}.lobby-bottom{padding:12px 20px 8px;background:linear-gradient(#34283e,#211a31);flex:none}.lobby-chapter{text-align:center;display:grid;gap:3px}.lobby-chapter>span{font-size:10px;letter-spacing:.15em;color:#c5abdb}.lobby-chapter strong{font-size:17px}.lobby-chapter small{font-size:11px;color:#c7b9cf}.lobby-play{width:100%;margin:12px 0 3px;min-height:52px;display:flex;justify-content:center;gap:20px;align-items:center;font-size:19px;border-radius:18px}.lobby-map{display:block;border:0;background:none;color:#d7c7e5;font-size:12px;margin:0 auto;padding:9px}
.chapter-switch{display:flex;justify-content:space-between;align-items:center;text-align:center;margin-bottom:12px}.chapter-switch button{width:36px;height:36px;border:1px solid #b99a703f;border-radius:50%;background:#3b2d4c;color:#f5ddb5;font-size:25px}.chapter-switch h1{font-size:23px;margin:3px 0}.chapter-switch small{font-size:11px;color:#c8b4d6}.journey-world.chapter{min-height:420px;height:calc(100dvh - 252px);max-height:620px;border-radius:22px}.journey-world .trail{height:100%;min-height:420px}.journey-world .trail svg{height:100%;width:100%}.journey-world .level-stop strong{font-size:11px;white-space:nowrap;background:#241a31d9;padding:2px 7px;border-radius:8px}.journey-world .level-stop small{font-size:11px;white-space:nowrap;color:#ffe0a1;text-shadow:0 1px 3px #160a21}.journey-world .node{width:49px;height:49px;font-size:20px}.journey-world .node:disabled{font-size:12px;opacity:.75}.journey-world .node.current{outline:3px solid #ffe8ad;outline-offset:5px;box-shadow:0 0 25px #f5cc8899}.node-reward{font-size:9px;color:#fff3cc;white-space:nowrap;display:block;text-shadow:0 1px 4px #000;background:#4c3845ab;border-radius:5px;padding:1px 4px}.chapter-1{background-position:100% 0!important}.chapter-2{background-position:0 100%!important}.chapter-prize{display:flex;gap:12px;align-items:center;padding:14px 5px 4px}.chapter-prize>span{font-size:30px;color:#ebc68a}.chapter-prize strong,.chapter-prize small{display:block}.chapter-prize strong{font-size:13px}.chapter-prize small{font-size:11px;color:#c4b5cf;margin-top:4px}
body .page-head{margin-bottom:16px}body .screen-title{font-size:25px}body .screen-copy{font-size:12px;line-height:1.6}body .page-back{font-size:10px;padding:8px}.partner-grid{grid-template-columns:1fr!important;gap:18px}.partner-card{padding:0 0 16px;border-radius:22px;overflow:hidden}.partner-card>h3,.partner-card>p,.partner-card>strong,.partner-card>small{margin-left:16px;margin-right:16px}.partner-card>.primary{width:calc(100% - 32px);margin:0 16px}.partner-card>.portrait-art{mask-image:none}.room-summary{text-align:center;padding:12px;color:#efd59b}.wish-album{background:#30243c;border-radius:16px;padding:14px;margin-bottom:18px}.wish-album summary{cursor:pointer;font-size:14px}.wish-album .record-row{font-size:11px;padding:12px 0}.wish-room{padding:0!important}.room-steps{gap:6px}.room-steps .room-step{padding:5px}.screen>.primary{width:100%}
body .veil{padding:12px;background:#0b0719bd;backdrop-filter:blur(7px);align-items:center}body .dialog{width:100%;max-width:420px;max-height:calc(100dvh - 24px);overflow:auto;padding:20px;border-radius:26px;background:linear-gradient(150deg,#3a2a49,#211b31);border:1px solid #d5b18a66;color:#f6e7d2}.dialog h2{font-size:24px}.prep-top{display:flex;justify-content:space-between;align-items:center;color:#d4b588}.prep-top small{font-size:12px}.text-button{border:0;background:none;color:#d8c8e1;padding:8px;font:inherit;font-size:12px}.prep-top button{font-size:23px;line-height:1;padding:0 5px}.prep-goals{display:flex;gap:8px;margin:16px 0}.prep-goals>div{flex:1;display:grid;justify-items:center;gap:4px;background:#ffffff08;border:1px solid #e5cba02b;border-radius:15px;padding:10px 5px}.prep-goals svg,.prep-goals span{width:29px;height:30px;font-size:26px;color:#f4ce85}.prep-goals strong{font-size:17px}.prep-goals small{font-size:10px;color:#bfaec9}.prep-tip{font-size:12px!important;line-height:1.65;background:#20192c;padding:10px;border-radius:10px}.prep-label{text-align:left;font-size:13px;margin:17px 0 8px}.prep-label small{font-weight:400;font-size:10px;color:#b9a7c7;margin-left:10px}.prep-partners{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.prep-partners button{padding:0 0 4px;border-radius:12px;background:#22192f;color:#d7c2e3;border:2px solid transparent;overflow:hidden}.prep-partners .portrait-art{aspect-ratio:1}.prep-partners button>span:last-child{font-size:11px}.prep-partners button[aria-pressed=true]{border-color:#f2ce87;box-shadow:0 0 12px #e4b88033}.prep-skill{padding:9px 3px;text-align:left;min-height:52px}.prep-skill b{font-size:12px;color:#e9c98f}.prep-skill small{display:block;font-size:11px;line-height:1.5;color:#cbbbda;margin-top:3px}.prep-tools{display:flex;gap:10px}.prep-tools button{flex:1;padding:12px 4px;border:1px solid #c8b0d44a;border-radius:12px;background:#2a2039;color:#cfbfdc;font-size:12px}.prep-tools [aria-pressed=true]{border-color:#ebc684;background:#57404b;color:#ffe9b7}.prep-warning{font-size:10px!important;line-height:1.5}.prep-warning button{font-size:10px;text-decoration:underline}.prep-start{width:100%;margin-top:16px;min-height:49px}
body[data-screen=game] .top{height:42px;padding:4px 14px}body[data-screen=game] .brand{font-size:14px}body[data-screen=game] .brand small,body[data-screen=game] #help,body[data-screen=game] #settings,body[data-screen=game] #homeButton{display:none}body[data-screen=game] .main{flex:1;min-height:0;display:block;padding:0;overflow-y:auto}body[data-screen=game] .story,body[data-screen=game] .mode-tabs,body[data-screen=game] #map,body[data-screen=game] #levelSubtitle{display:none}body[data-screen=game] .game{height:100%;min-height:0;display:flex;flex-direction:column;padding:8px 10px 10px;border:0;border-radius:0;box-shadow:none;gap:6px;background:linear-gradient(#30213c,#191a2e)}body[data-screen=game] .level-head{margin:0;min-height:20px}body[data-screen=game] #levelTitle{font-size:13px;margin:0}body[data-screen=game] .hud{flex:none;gap:5px;margin:0}body[data-screen=game] .metric{padding:6px 8px;min-height:0;border-radius:12px}body[data-screen=game] .metric>span{font-size:9px}body[data-screen=game] .metric strong{font-size:18px}body[data-screen=game] .metric.moves strong{font-size:25px}body[data-screen=game] .hud .metric:first-child{display:none}body[data-screen=game] .metric.target{flex:1}body[data-screen=game] .coach{padding:5px 8px;margin:0;gap:6px;min-height:0;border-radius:9px;flex:none}body[data-screen=game] .coach-avatar,body[data-screen=game] .coach strong{display:none}body[data-screen=game] .coach p{font-size:10px;line-height:1.4;margin:0}body[data-screen=game] .board-shell{flex:none;width:min(100%,calc(100dvh - 308px));align-self:center;margin:auto 0;padding:5px;border-radius:16px}body[data-screen=game] .board-caption{font-size:10px;line-height:1.3;min-height:14px;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}body[data-screen=game] .element-panel{margin:0;min-height:0;flex:none}body[data-screen=game] .element-panel>button:first-child{display:none}body[data-screen=game] .element-panel>span{font-size:9px;padding:0;min-height:13px;line-height:1.4}body[data-screen=game] .tool-row{gap:6px;margin:0;flex:none;order:3}body[data-screen=game] .tool{font-size:11px;padding:8px 3px;min-height:35px}body[data-screen=game] .tool b{font-size:9px}body[data-screen=game] .skill-box{order:2;flex:none;margin:0;padding:7px 9px;gap:8px;min-height:52px}body[data-screen=game] .skill-avatar{width:38px;height:38px}body[data-screen=game] .skill-info strong{font-size:11px}body[data-screen=game] .skill-info small{font-size:9px;line-height:1.4}body[data-screen=game] .skill-btn{padding:8px 12px;font-size:12px;min-height:35px}.skill-avatar .portrait-art{height:100%}
.mobile-result{text-align:center;padding:2px 0 20px}.result-small-art{width:116px;height:116px;margin:0 auto;border-radius:50%;overflow:hidden;border:2px solid #f3d498;box-shadow:0 0 35px #d8b4ff33}.result-small-art .portrait-art{height:100%;aspect-ratio:1}.result-stars{font-size:38px;color:#f1cd85;letter-spacing:5px;margin:9px 0}.mobile-result h1{font-size:26px;margin:6px 0}.mobile-result>p{font-size:12px;line-height:1.7;color:#ccb9d8}.result-tally{display:flex;justify-content:center;gap:50px;padding:14px;border-top:1px solid #c6accb33;border-bottom:1px solid #c6accb33;margin:16px 0}.result-tally span{font-size:10px;color:#bfaecb}.result-tally strong{font-size:23px;display:block;color:#f6deaf;margin-top:3px}.reward-reveal{display:flex;gap:13px;text-align:left;align-items:center;padding:12px;border:1px solid #bba16e66;border-radius:20px;background:#4b354744}.reward-reveal>.reward-art{width:105px;flex:none}.reward-reveal h2{font-size:17px;margin:4px 0}.reward-reveal p{font-size:11px;line-height:1.5;margin:4px 0}.reward-reveal small{font-size:10px;color:#d6b780}.remaining-goal,.chapter-unlock{padding:14px;border-radius:15px;background:#59405266;font-size:13px;margin:14px 0}.result-actions{display:grid;gap:9px;margin-top:20px}.result-actions>.primary{min-height:51px;font-size:15px}.result-actions .text-button{padding:5px}.result-actions .secondary{min-height:43px}.won .result-stars{animation:reward-arrive .6s ease-out both}@keyframes reward-arrive{from{opacity:0;transform:scale(.75)}to{opacity:1;transform:scale(1)}}.reduced .result-stars{animation:none}
@media(max-height:650px){body[data-screen=game] .board-shell{width:min(100%,calc(100dvh - 276px))}body[data-screen=game] .game{gap:4px}.lobby-greeting{bottom:8px;padding:6px 10px}.lobby-bottom{padding:8px 16px}.lobby-chapter small{display:none}.lobby-play{margin-top:8px}.prep-label{margin-top:10px}.prep-goals{margin:10px 0}}
@media(prefers-reduced-motion:reduce){.result-stars{animation:none}}
body[data-screen=game] .hud{grid-template-columns:minmax(0,1fr) 82px}body[data-screen=game] .coach{max-height:38px;overflow:hidden}body[data-screen=game] .board-shell{width:min(100%,calc(100dvh - 370px))}body[data-screen=game] .main{overflow-y:auto}body .cover-body{padding-bottom:24px}
body[data-screen=game] .hud{display:grid}.cover-home .cover-controls{bottom:max(36px,env(safe-area-inset-bottom))}.cover-home .cover-heading .screen-title{font-size:clamp(44px,11vw,66px)}
body[data-screen=game]:has(#timeMode.active) .hud{grid-template-columns:minmax(0,1fr) minmax(0,1.25fr) 70px}
body[data-screen=game]:has(#timeMode.active) .hud .metric:first-child{display:block}
body[data-screen=game]:has(#timeMode.active) .hud .metric:first-child strong{font-size:clamp(19px,5.6vw,27px);font-variant-numeric:tabular-nums}
body[data-screen=game]:has(#timeMode.active) .metric.target strong{font-size:12px;line-height:1.3}
body[data-screen=game]:has(#timeMode.active) .metric.target>span{white-space:normal}
body[data-screen=game] .weekly-eligibility{font:11px/1.4 system-ui;color:#ffe0a6}
body[data-screen=game] .weekly-eligibility.lost{color:#ffb9bd}
</style>
<style id="approvedArtStyle">:root{--prologue-atlas:url("data:image/webp;base64,");--currency-coin:url("data:image/webp;base64,