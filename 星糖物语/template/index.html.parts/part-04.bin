");--partner-1:url("data:image/webp;base64,");--partner-2:url("data:image/webp;base64,");--partner-3:url("data:image/webp;base64,");--partner-4:url("data:image/webp;base64,");--nav-0:url("data:image/webp;base64,");--nav-1:url("data:image/webp;base64,");--nav-2:url("data:image/webp;base64,");--nav-3:url("data:image/webp;base64,");}:root{--scene-lobby:var(--world-lobby)}.portrait-art{background-position:center!important}/* Scenic screens: clean illustration below live, accessible controls. */
body:is([data-screen=home],[data-screen=map],[data-screen=partners],[data-screen=records]) .top{display:none}
body:is([data-screen=home],[data-screen=map],[data-screen=partners],[data-screen=records]) .screen{padding:0;overflow:hidden;position:relative}
body:is([data-screen=home],[data-screen=map],[data-screen=partners],[data-screen=records]) .edition-label{display:none}
.art-page{height:100%;min-height:0;position:relative;isolation:isolate;overflow:hidden;color:#fff2d6;background:#30213c;font-family:Georgia,'Noto Serif SC','Songti SC',serif}
.art-backdrop,.art-partner-scene,.art-map-stage,.art-stops,.art-room-objects{position:absolute;inset:0;pointer-events:none}
.art-backdrop{background-size:100% 100%;background-position:center}
.art-lobby .art-backdrop{background-image:var(--scene-lobby)}
.art-journey .art-backdrop{background-image:var(--scene-journey)}
.art-room .art-backdrop{background-image:var(--scene-room)}
.art-page:after{content:'';position:absolute;inset:0;z-index:0;pointer-events:none;background:linear-gradient(#17122661,transparent 23%,transparent 56%,#25192a99 83%,#21172ef0)}
.art-header,.art-lobby-head{position:relative;z-index:3;display:flex;align-items:center;gap:10px;padding:18px 14px 5px;text-shadow:0 2px 8px #22132d}
.art-header h1{font-size:clamp(23px,6vw,30px);margin:0;white-space:nowrap;font-weight:500;letter-spacing:.08em}
.art-header>button,.art-chapters>button{width:36px;height:36px;flex:none;border:1px solid #ffe2a5;border-radius:50%;background:linear-gradient(140deg,#ffefc8,#a98579);color:#4e325e;font-size:28px;box-shadow:inset 0 0 0 3px #fff2c666,0 2px 9px #25152c44;line-height:1;padding:0}
.art-pill{margin-left:auto;white-space:nowrap;padding:5px 10px;background:#30203bb8;border:1px solid #efd49c8a;border-radius:18px;font-size:11px;color:#ffe6b1;text-shadow:0 1px 4px #29172f}
.art-lobby-head{justify-content:space-between;align-items:start;padding:24px 22px}
.art-lobby-head h1{font-size:clamp(30px,9vw,43px);font-weight:500;letter-spacing:.09em;margin:0;color:#fff0c5;text-shadow:0 0 12px #e5bf9f77,0 2px 4px #30203c}
.art-lobby-head h1 small{display:block;font:10px system-ui;letter-spacing:.15em;margin-top:7px;color:#f2ddec}
.art-chapter-tag{position:relative;z-index:2;margin:0 22px;display:inline-block;padding:5px 13px;border:1px solid #e7c99788;border-radius:20px;background:#362c4899;font-size:12px}
.art-event{position:absolute;z-index:3;top:19%;right:12px;padding:8px 5px;border:1px solid #efcf8c8c;border-radius:17px;color:#fff1cd;background:#3d2844c4;font-size:10px;box-shadow:0 3px 16px #21112766;width:60px}
.art-event span{display:block;font-size:30px;color:#ffe1a6;line-height:1.2}
.art-lobby-copy{position:absolute;z-index:2;left:7%;bottom:24%;padding:8px 14px;background:linear-gradient(100deg,#f3e4d9e8,#e7d9f4ce);border:1px solid #fff2d5;border-radius:18px 18px 18px 2px;box-shadow:0 4px 18px #21112e33;color:#56385d;max-width:76%}
.art-lobby-copy small{font-size:10px;color:#8c6680}.art-lobby-copy p{margin:2px 0;font-size:13px}
.art-dock{position:absolute;z-index:3;bottom:0;left:0;right:0;padding:12px 26px 5px;text-align:center}
.art-next{font-size:12px;margin:6px 0 11px;color:#ffe5b5;text-shadow:0 2px 4px #160a20;letter-spacing:.04em}
body .art-gold{display:block;position:relative;width:100%;min-height:53px;border:2px solid #ffe6a8;border-radius:32px;background:linear-gradient(110deg,#f5c875,#fff1c4 45%,#f6d99d 70%,#e8b967);color:#593463;font-family:inherit;font-weight:600;font-size:22px;letter-spacing:.07em;text-shadow:0 1px #fff3d0;box-shadow:inset 0 0 0 3px #a67f7c66,inset 0 0 16px #fff9de,0 0 0 3px #eecb8a44,0 6px 19px #160b2399;padding:10px 18px}
.art-gold:before,.art-gold:after{content:'✦';position:absolute;top:50%;transform:translateY(-50%);font-size:22px;color:#fff1b8;text-shadow:0 0 4px #d79846}.art-gold:before{left:-12px}.art-gold:after{right:-12px}.art-gold:disabled{filter:grayscale(.6);opacity:.6}
.art-link{border:0;background:none;color:#e8d0e6;padding:8px;font-family:inherit;font-size:11px;text-decoration:none}.art-link:hover{color:#ffe1a3}
body .bottom-nav{z-index:4;height:76px;padding:0 12px max(5px,env(safe-area-inset-bottom));background:linear-gradient(#241a30,#241b33);border-top:1px solid #ddbc7333;gap:7px}
body .bottom-nav button{position:relative;border-radius:0;padding:2px 2px 4px;font-family:Georgia,'Songti SC',serif;font-size:13px;color:#d8c4df;background:none!important;border:0;overflow:visible}
body .bottom-nav b{display:block;width:52px;height:40px;font-size:0;margin:auto;background-size:cover;background-position:center;filter:saturate(.7) brightness(.8);mask-image:radial-gradient(ellipse,#000 45%,transparent 76%)}
body .bottom-nav button:nth-child(1) b{background-image:var(--nav-0)}body .bottom-nav button:nth-child(2) b{background-image:var(--nav-1)}body .bottom-nav button:nth-child(3) b{background-image:var(--nav-2)}body .bottom-nav button:nth-child(4) b{background-image:var(--nav-3)}
body .bottom-nav [aria-current=page]{color:#ffe6af;text-shadow:0 0 12px #f1c87b99}body .bottom-nav [aria-current=page] b{filter:none}body .bottom-nav [aria-current=page]:after{content:'✦';position:absolute;bottom:-5px;left:calc(50% - 4px);font-size:10px;color:#f1cf88}
.art-partner-scene{background-size:cover;background-position:center 25%;bottom:14%}
.art-character-0 .art-partner-scene{background-image:var(--scene-lobby);background-position:center 35%}
.art-character-1 .art-partner-scene{background-image:var(--partner-1)}.art-character-2 .art-partner-scene{background-image:var(--partner-2)}.art-character-3 .art-partner-scene{background-image:var(--partner-3)}.art-character-4 .art-partner-scene{background-image:var(--partner-4)}
.art-name{position:absolute;right:7%;top:13%;z-index:2;text-align:center;min-width:70px;padding:8px 12px;color:#fff0c2;text-shadow:0 2px 7px #26172f,0 0 13px #25122f;background:radial-gradient(ellipse,#34223d80,transparent 75%)}
.art-name>span{font-size:28px}.art-name h2{font-size:28px;font-weight:500;margin:0 0 5px}.art-name small{font-size:11px}
.partner-dock{padding:10px 20px 9px;background:linear-gradient(transparent,#2b1d37d9 13%,#24192ef5 90%)}
.art-skill{display:flex;text-align:left;align-items:center;gap:12px;border:1px solid #f2d5a275;border-radius:20px 20px 11px 11px;padding:10px 12px;background:linear-gradient(125deg,#3b2a48dc,#59405abf);box-shadow:inset 0 0 0 3px #ffe0a80b}
.art-skill-symbol{flex:none;width:44px;height:44px;border:1px solid #dcc18d;border-radius:50%;display:grid;place-items:center;font-size:28px;color:#ffe6b5;background:radial-gradient(#b79aca66,#281a3f)}
.art-skill h3{font-size:15px;font-weight:500;margin:0 0 4px;color:#ffe7b9}.art-skill p{font-size:11px;line-height:1.5;margin:0 0 3px;color:#f1e1ed}.art-skill small{font:10px system-ui;color:#cdbbd8}.art-skill .art-link{padding:2px 0 0 10px;font-size:10px;color:#f1d39a}
.art-picks{display:flex;justify-content:space-between;gap:6px;margin:10px 0 12px}.art-picks button{width:18%;min-width:0;border:0;background:none;color:#ecdbed;font-size:11px;padding:0;position:relative}.art-picks .portrait-art{width:45px;height:45px;max-width:100%;margin:0 auto 4px;border:2px solid #ba98b0;border-radius:50%;box-shadow:0 2px 7px #0006}.art-picks [aria-pressed=true] .portrait-art{border-color:#ffe2a3;box-shadow:0 0 0 2px #ad795e,0 0 14px #f5cb7877}.art-picks [aria-pressed=true]{color:#ffe3a5}.art-picks button>small{position:absolute;right:-3px;top:-4px;padding:1px 3px;border-radius:5px;font-size:7px;background:#37243d;color:#e6c693}.art-picks button>span:last-of-type{display:block}.art-unavailable{display:block;font-size:9px;color:#bca4c4;margin-top:7px}
.art-chapters{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;margin:7px 22px;padding:6px 12px;border:1px solid #f6dca377;border-radius:25px;background:#362342b0;text-align:center}.art-chapters h2{font-weight:500;font-size:21px;margin:0 0 3px}.art-chapters small{font:11px system-ui;color:#ead5e3}.art-chapters>button{width:28px;height:28px;font-size:22px;background:#5a4262;color:#ffe5b4}.art-chapters>button:disabled{opacity:.25}
.art-map-stage{bottom:0;overflow:hidden}.chapter-tone-1{filter:hue-rotate(20deg)}.chapter-tone-2{filter:hue-rotate(-15deg)}
.art-stops{z-index:2}.art-stop{position:absolute;transform:translate(-50%,-50%);text-align:center;pointer-events:auto;display:flex;flex-direction:column;align-items:center;gap:2px}.art-stop>button{width:44px;height:44px;border:2px solid #ffdf9b;border-radius:50%;background:radial-gradient(circle at 35% 20%,#fff5cf,#e8b86b 65%,#ac794c);color:#68425a;font:600 23px Georgia;box-shadow:0 0 0 3px #714c7955,0 5px 10px #20113188;cursor:pointer}.art-stop>button:disabled{background:linear-gradient(#b7a4c5,#736784);color:#ebe0ea;border-color:#c5b2cd;font-size:19px}.art-stop small{font:10px system-ui;color:#ffe69d;text-shadow:0 1px 4px #2a1230}.art-stop strong{font-size:10px;font-weight:400;white-space:nowrap;color:#fff0d3;background:#392343c9;padding:2px 7px;border:1px solid #f1cd8b66;border-radius:10px}.art-stop.is-current>button{outline:2px solid #fff3bb;outline-offset:5px;box-shadow:0 0 24px #ffedbf}.art-stop.is-current:before{content:'当前';position:absolute;bottom:100%;margin-bottom:9px;font-size:10px;color:#fff2c1;border-radius:8px;padding:3px 7px;background:#633f69df}.map-dock{padding-bottom:13px}
.art-water{position:absolute;overflow:hidden;opacity:.5;mix-blend-mode:screen;clip-path:polygon(12% 0,88% 0,100% 95%,65% 100%,15% 93%,0 30%);mask-image:linear-gradient(transparent,#000 15%,#000 80%,transparent)}
.art-water b{position:absolute;inset:-100% 0;background:repeating-linear-gradient(176deg,transparent 0 14px,#b9ddff77 17px,#fff8 21px,transparent 25px 40px);animation:water-fall 2.4s linear infinite}.art-water em{position:absolute;inset:75% -20% -5%;border-radius:50%;background:radial-gradient(ellipse,#fff9,transparent 65%);animation:water-mist 3s ease-in-out infinite}.water-1 b{animation-delay:-1s}.water-2 b{animation-duration:1.8s}.water-3 b{animation-delay:-.6s}
@keyframes water-fall{to{transform:translateY(40px)}}@keyframes water-mist{50%{transform:scale(1.25);opacity:.4}}
.room-dock{background:linear-gradient(transparent,#2d2038d9 18%,#26192ff7);padding:12px 22px 4px}.art-gifts{display:flex;gap:10px}.art-gifts button{flex:1;min-width:0;padding:5px 4px 6px;background:linear-gradient(#6c517aba,#38283cc9);border:1px solid #dabb81;border-radius:15px;color:#fff0cb;box-shadow:inset 0 0 0 3px #e9c88a14}.art-gifts .reward-art{display:block;width:100%;aspect-ratio:1;height:auto;max-height:75px;border-radius:10px}.art-gifts b{font-size:10px;font-weight:500;display:block;margin-top:4px}.art-gifts small{display:block;font-size:9px;color:#cfb9d3;margin-top:3px}.art-gifts .locked .reward-art{filter:grayscale(1) brightness(.5);opacity:.7}.art-gifts .earned{border-color:#ffdda1}.art-gifts .earned small{color:#ffe6ab}
.art-room-objects{z-index:1}.art-object{position:absolute;pointer-events:auto;border:0;background:none;padding:0;filter:drop-shadow(0 0 10px #ffcf8177)}.art-object .reward-art{display:block;width:100%;height:100%;border-radius:25%;mask-image:radial-gradient(ellipse,#000 45%,transparent 72%)}.art-object-0{left:5%;top:42%;width:21%;height:14%}.art-object-1{left:27%;top:34%;width:19%;height:13%}.art-object-2{left:79%;top:20%;width:17%;height:15%}
body.reduced .art-water *,body[data-art-hidden=true] .art-water *{animation-play-state:paused!important}
@media(prefers-reduced-motion:reduce){.art-water *{animation:none!important}}
@media(max-height:680px){body .bottom-nav{height:65px}.art-header{padding-top:12px}.art-header h1{font-size:22px}.art-skill{padding:7px 10px}.art-skill p{font-size:10px}.art-picks{margin:7px 0}.art-picks .portrait-art{width:36px;height:36px}.art-gold{min-height:45px!important;font-size:19px!important;padding:7px 15px!important}.art-gifts .reward-art{max-height:50px}.art-name{top:14%;right:5%}.art-lobby-copy{bottom:25%}.art-lobby-head{padding-top:16px}.art-next{font-size:10px}.art-chapters h2{font-size:17px}.art-chapters{margin-top:3px}.art-stop>button{width:38px;height:38px}.art-stop strong{font-size:9px}}
@media(max-height:520px){body:is([data-screen=home],[data-screen=map],[data-screen=partners],[data-screen=records]) .screen{overflow-y:auto}.art-page{min-height:500px}}
.art-object .reward-art{border-radius:0;mask-image:none}
.art-preferences{position:absolute;z-index:4;right:22px;top:72px;width:32px;height:32px;border:1px solid #d9bb8c;border-radius:50%;background:#39283ea9;color:#ffe3b2;font-size:19px;padding:0}
.art-lobby .art-backdrop{background-size:cover;background-position:center 42%}
@media(max-height:680px){.art-stop:nth-child(4){top:28%!important}.art-stop:nth-child(3){top:43%!important}.art-stop:nth-child(2){top:58%!important}.art-stop:nth-child(1){top:73%!important}}

/* World scenes are independent artwork; all controls and progress are live. */
.world-scene{position:absolute;inset:0;background-position:center;background-size:100% 100%;pointer-events:none}
.world-home>.world-scene{background-image:var(--world-lobby);background-size:cover;background-position:center 35%}
.world-room>.world-scene{background-image:var(--world-room)}
.world-map-0 .world-scene{background-image:var(--world-cloud)}.world-map-1 .world-scene{background-image:var(--world-forest)}.world-map-2 .world-scene{background-image:var(--world-sea)}
.world-hotspot{position:absolute;z-index:3;color:#fff0ca;text-shadow:0 2px 4px #210f2d;padding:7px 12px;font:12px Georgia,'Songti SC',serif;background:linear-gradient(#78536dc9,#40263ce8);border:1px solid #edd2a4;border-radius:17px;box-shadow:0 2px 12px #22142970;min-height:36px}
.world-hotspot small{display:block;color:#d9c2d5;font-size:9px;margin-top:2px}.world-hotspot em,.world-room-actions em{position:absolute;top:-6px;right:-5px;min-width:17px;border-radius:10px;background:#9f5267;color:#fff2d3;font:10px/17px system-ui;text-align:center}
.hotspot-mail{left:7%;top:47%}.hotspot-wish{left:7%;top:29%}.hotspot-challenge{left:7%;top:17%}.hotspot-partner{right:12%;top:57%}
.world-home .art-lobby-head{padding-top:20px}.world-home .art-preferences{top:75px}
.world-speech{position:absolute;z-index:2;right:7%;top:64%;max-width:68%;padding:8px 12px;font-size:12px;background:#f6e6dadb;border:1px solid #fff4d8;border-radius:16px 3px 16px 16px;color:#5a3f5f;box-shadow:0 3px 12px #210d2533}
.world-home-dock{padding-top:4px;background:linear-gradient(transparent,#281a35e6 15%)}
.world-task{display:flex;align-items:center;gap:10px;text-align:left;margin:4px 0 9px;padding:6px 9px;border:1px solid #eac18b88;border-radius:17px;background:linear-gradient(110deg,#6e4c63b8,#39263cce)}
.world-task>.collection-art{width:52px;height:52px;flex:none}.world-task-star{font-size:40px;padding:0 8px;color:#f8d78f}.world-task small{font-size:9px;color:#dcbde1}.world-task strong{display:block;font-size:14px;font-weight:500;color:#ffe5b6}.world-task p{font-size:10px;color:#d6c4d9;margin:2px 0 0}
.world-secondary{display:flex;justify-content:center;gap:14px;padding:8px 0 3px}.world-secondary button{border:0;background:none;color:#eccee1;font:11px system-ui;padding:4px 0}
.world-map-canvas,.world-map-stops{position:absolute;inset:0;pointer-events:none}.world-map-canvas{overflow:hidden}.world-map-canvas canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;mix-blend-mode:screen}
.world-map .art-chapters{margin-top:7px}.world-map .art-header{padding-top:16px}
.world-map-stops{z-index:2}.world-stop{position:absolute;transform:translate(-50%,-50%);text-align:center;pointer-events:auto;white-space:nowrap}.world-stop>button{display:flex;align-items:center;gap:4px;padding:3px 9px 3px 3px;border:1px solid #e6c18c;border-radius:25px;color:#54314d;background:linear-gradient(#fff0c8,#dabb8a);font:11px Georgia,'Songti SC',serif;box-shadow:0 2px 8px #160d3088;min-height:39px}.world-stop b{display:grid;place-items:center;width:32px;height:32px;border:1px solid #fff2ce;border-radius:50%;font:18px Georgia;background:#b68d62;color:#fff1c3;flex:none}.world-stop>button:disabled{opacity:1;color:#4e425b;border-color:#e2d9ef;background:linear-gradient(#eee6f2,#b9a8c9)}.world-stop>button:disabled b{background:#887d94;border-color:#e8d9ef;color:white}.world-stop small{display:inline-block;color:#fff0bf;background:#322240cf;border-radius:8px;padding:1px 6px;font:9px/1.6 system-ui;margin-top:4px;text-shadow:0 1px 3px #160c20}.world-stop.current>button{outline:2px solid #ffe7a1;outline-offset:3px;box-shadow:0 0 22px #ffd98688}.world-stop.current small{background:#75465be8}
.world-map-dock{display:flex;align-items:center;gap:10px;background:linear-gradient(transparent,#2d2036e6 25%);padding:15px 21px 12px}.world-map-dock>.art-gold{flex:1;font-size:18px;letter-spacing:0;white-space:nowrap;padding:10px 12px}.world-map-reward{display:flex;align-items:center;gap:5px;flex:1;min-width:0;text-align:left}.world-map-reward>.collection-art{width:49px;height:49px;flex:none}.world-map-reward small{display:block;font-size:9px;color:#dbc2de}.world-map-reward strong{font-size:12px;color:#ffe3ac;font-weight:500;white-space:nowrap}
.collection-art{display:block;width:100%;aspect-ratio:1;background-repeat:no-repeat;background-size:300% 100%;background-position:0 0;border:0;border-radius:0}
.collection-0{background-position:0 0}.collection-1{background-position:50% 0}.collection-2{background-position:100% 0}
.collection-3,.collection-4,.collection-5,.collection-6,.collection-7,.collection-8,.collection-9,.collection-10,.collection-11{background-image:var(--collection-extras);background-size:300% 300%}
.collection-3{background-position:0 0}.collection-4{background-position:50% 0}.collection-5{background-position:100% 0}.collection-6{background-position:0 50%}.collection-7{background-position:50% 50%}.collection-8{background-position:100% 50%}.collection-9{background-position:0 100%}.collection-10{background-position:50% 100%}.collection-11{background-position:100% 100%}
.collection-large{max-width:240px;margin:0 auto}.world-reward-reveal{padding:8px 20px 20px;border:1px solid #ddba8266;border-radius:24px;background:linear-gradient(#69476744,#3c284a33)}.world-reward-reveal>.collection-art{width:170px;margin:auto}.world-reward-reveal h2{font-size:21px;margin:0 0 8px}.world-reward-reveal p{font-size:12px;margin:4px}.world-reward-reveal small{display:block;font-size:12px;line-height:1.6;color:#d5bfd9}
.world-furniture{position:absolute;inset:0;z-index:2;pointer-events:none}.world-slot{position:absolute;display:block;padding:0;border:0;background:none;pointer-events:auto;filter:drop-shadow(0 5px 5px #1b10214d);isolation:isolate;min-width:34px;min-height:34px}.world-slot>.collection-art{position:absolute;inset:0;width:100%;height:100%}.world-slot small{position:absolute;bottom:-18px;left:50%;transform:translateX(-50%);padding:2px 8px;border:1px solid #f5dc9d88;border-radius:8px;color:#ffe5a7;background:#4d3459dc;font-size:10px;white-space:nowrap;z-index:1}
.slot-window{left:18%;top:38%;width:20%;aspect-ratio:1}.slot-table{left:72%;top:48%;width:21%;aspect-ratio:1}.slot-wall{left:76%;top:21%;width:18%;aspect-ratio:1}.slot-rug{left:32%;top:65%;width:39%;aspect-ratio:1}.slot-hanging{left:53%;top:19%;width:17%;aspect-ratio:1}
.slot-dot{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:26px;height:26px;border-radius:50%;border:1px solid #f4e0acaa;background:#c4a97f44;color:#fff3c9;box-shadow:0 0 9px #e9cead33;font-size:15px}
.world-room:not(.is-furnishing) .empty-slot{opacity:.6}.preview-slot{outline:2px solid #ffe6a6;outline-offset:4px;border-radius:12px;background:#ffd48d18;box-shadow:0 0 16px #ffe1ab55}
.world-lamp-glow{position:absolute;z-index:1;left:5%;top:22%;width:52%;height:46%;opacity:0;background:radial-gradient(ellipse,#ffca6355,transparent 68%);mix-blend-mode:screen;pointer-events:none;transition:opacity .4s}.lamp-lit .world-lamp-glow{opacity:1}.world-slot:has(.collection-0){filter:drop-shadow(0 0 7px #eab96c44)}.lamp-lit .world-slot:has(.collection-0){filter:drop-shadow(0 0 12px #ffcd65aa)}.world-room:not(.lamp-lit) .collection-0{filter:brightness(.65) saturate(.7)}
.box-flower{position:absolute;left:42%;top:38%;font-size:20px;color:#ffe0ec;text-shadow:0 0 7px #ffe5ac;animation:box-turn 4s linear infinite;pointer-events:none}.box-playing .world-slot:has(.collection-1){filter:drop-shadow(0 0 9px #e8aad788)}@keyframes box-turn{to{transform:rotate(360deg)}}
.world-room-dock{background:linear-gradient(transparent,#2a1d35e8 18%);padding:11px 22px 4px}.world-room-message{font-size:11px;color:#f2d6d5;text-shadow:0 1px 4px #28132d;margin:0 0 9px}.world-room-actions{display:flex;gap:10px;margin-bottom:13px}.world-room-actions>button{position:relative;flex:1;border:1px solid #e4c396;border-radius:16px;background:linear-gradient(#72506ab8,#38273ee6);color:#fbe3b7;font:12px Georgia,'Songti SC',serif;padding:7px 3px;box-shadow:inset 0 0 0 3px #f9dbad0c}.world-room-actions span{display:block;font-size:22px;line-height:1.2;margin-bottom:2px}
.furnishing-drawer{position:absolute;z-index:5;bottom:0;left:0;right:0;padding:12px 14px 14px;background:linear-gradient(#e5d2dfeF,#f4e7d6);color:#69475d;border:1px solid #ffe7bc;border-radius:28px 28px 0 0;box-shadow:0 -8px 22px #1f12284d;max-height:52%;overflow-y:auto}
.furnishing-drawer h2{text-align:center;font-size:20px;font-weight:500;margin:0 0 8px}.furnishing-tabs{display:flex;border-bottom:1px solid #a4839755;padding-bottom:7px;gap:5px}.furnishing-tabs button{flex:1;font:12px inherit;background:none;border:1px solid transparent;border-radius:12px;padding:7px 3px;color:#785669}.furnishing-tabs [aria-pressed=true]{background:#684a73;color:#ffe6ac;border-color:#edc987}
.furnishing-items{display:flex;gap:9px;overflow-x:auto;padding:9px 2px;scroll-snap-type:x proximity}.furnishing-items>button{flex:0 0 30%;min-width:80px;padding:4px 4px 7px;border:1px solid #bda3b7;border-radius:15px;background:#bda9bf66;color:#5c3e58;scroll-snap-align:start}.furnishing-items [aria-pressed=true]{border:2px solid #e0ac55;background:#f7e7ce;box-shadow:0 0 9px #fff0ba}.furnishing-items>button:disabled{opacity:1;color:#5e5066;background:#b8aabd}.furnishing-items>button:disabled .collection-art{filter:grayscale(1) brightness(.5);opacity:.7}.furnishing-items .collection-art{max-width:100px;margin:auto}.furnishing-items b{display:block;font-size:11px;font-weight:500;white-space:nowrap}.furnishing-items small{font:9px system-ui}.furnishing-drawer>p{text-align:center;font-size:10px;margin:4px}.furnishing-controls{display:flex;gap:8px;margin-top:7px}.furnishing-controls button{font:12px Georgia,'Songti SC',serif;min-height:40px;flex:1;border:1px solid #b391a8;border-radius:20px;background:#f2e2d4;color:#704b62;padding:5px}.furnishing-controls .primary{flex:1.6;background:linear-gradient(#745077,#493052);color:#ffe9b8;border-color:#d9b171}.empty-category{font-size:12px;margin:auto;padding:20px 0}
.is-furnishing .world-furniture{bottom:0}.is-furnishing .slot-rug{top:43%;width:30%}.is-furnishing .slot-table{top:37%}.is-furnishing .slot-window{top:31%}.is-furnishing .world-scene{transform:translateY(-5%)}
.cabinet-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:14px 0}.cabinet-grid button{border:1px solid #c9a57b77;border-radius:15px;background:#7d567533;padding:6px;color:#f0dac0}.cabinet-grid b{display:block;font-size:11px;font-weight:500}.cabinet-grid small{font-size:9px;color:#ccb0d0}.cabinet-grid .not-owned .collection-art{filter:grayscale(1) brightness(.5)}.cabinet-grid .not-owned{opacity:.7}
.mail-row{display:flex;gap:10px;align-items:center;width:100%;padding:13px 10px;border:1px solid #d9b58455;border-radius:13px;background:#a5809b22;color:#f3dec4;margin:8px 0;text-align:left}.mail-row>span{font-size:24px;color:#f5d08b}.mail-row>b{flex:1;font-size:13px}.mail-row>small{font-size:10px;color:#ceb5d6}.letter-paper{background:#f2e3cf;color:#604357;border:1px solid #f8cf8d;padding:20px;border-radius:13px;text-align:left;box-shadow:inset 0 0 25px #bd947833}.letter-paper h2{font-size:21px}.letter-paper p{line-height:2!important}.letter-paper small{letter-spacing:.2em;color:#957181}.letter-sign{text-align:right;font-size:12px}
.visit-row{display:flex;gap:10px}.visit-row>div{flex:1;min-width:0;text-align:center}.visit-row .portrait-art{aspect-ratio:1;border-radius:15px}.visit-row small{font-size:11px}.visit-portrait{width:100px;height:100px;margin:auto;border-radius:50%;overflow:hidden}.visit-portrait .portrait-art{height:100%}
.reduced .box-flower{animation:none}@media(prefers-reduced-motion:reduce){.box-flower{animation:none}}
@media(max-height:680px){.world-speech{top:61%;font-size:10px}.world-task{margin:0 0 8px;padding:4px 8px}.world-task>.collection-art{width:40px;height:40px}.world-task strong{font-size:12px}.world-task p{font-size:9px}.world-secondary{padding-top:4px}.world-stop>button{font-size:9px;min-height:32px;padding-right:7px}.world-stop b{width:26px;height:26px;font-size:15px}.world-stop small{font-size:8px}.world-map-dock{padding-top:10px;padding-bottom:8px}.world-map-reward>.collection-art{width:40px;height:40px}.world-map-reward strong{font-size:10px}.world-room-actions{margin-bottom:9px}.world-room-actions>button{font-size:11px;padding:5px}.world-room-message{font-size:10px}.furnishing-drawer h2{font-size:17px}.furnishing-items .collection-art{max-width:70px}.furnishing-drawer{padding-top:9px;max-height:55%}}
@media(max-height:520px){.world-home,.world-room,.world-map{min-height:500px}}
.world-room .slot-window{top:30%}
.is-furnishing .slot-window{top:30%}.is-furnishing .slot-table{top:48%}.is-furnishing .slot-rug{top:65%;width:39%}
.is-furnishing .world-scene,.is-furnishing .world-furniture{transform:translateY(-8%)}
.edit-rug .world-scene,.edit-rug .world-furniture{transform:translateY(-24%)}
.edit-wall .world-scene,.edit-wall .world-furniture,.edit-hanging .world-scene,.edit-hanging .world-furniture{transform:none}
body:has(.world-room.is-furnishing) .bottom-nav{display:none}
.world-room:has(.slot-table .collection-0) .world-lamp-glow{left:54%;top:36%;width:46%;height:39%}
.prep-place{height:115px;margin:-20px -20px 13px;border-radius:25px 25px 0 0;background-size:210% auto;position:relative;overflow:hidden;box-shadow:inset 0 -35px 30px #2a1a39c9}.prep-place>span{position:absolute;bottom:9px;left:18px;font:17px Georgia,'Songti SC',serif;color:#fff1cd;text-shadow:0 2px 6px #24112b}
.place-0,.place-1,.place-2,.place-3{background-image:var(--world-cloud)}.place-0{background-position:0% 66%}.place-1{background-position:100% 44%}.place-2{background-position:0% 26%}.place-3{background-position:100% 16%}
.place-4,.place-5,.place-6,.place-7{background-image:var(--world-forest)}.place-4{background-position:100% 61%}.place-5{background-position:0% 44%}.place-6{background-position:100% 27%}.place-7{background-position:0% 15%}
.place-8,.place-9,.place-10,.place-11{background-image:var(--world-sea)}.place-8{background-position:0% 63%}.place-9{background-position:100% 49%}.place-10{background-position:0% 31%}.place-11{background-position:100% 17%}
@media(max-height:680px){.prep-place{height:85px}}

/* Native, illustrated lobby controls and compact phone-first economy sheets. */
.stamina-bar{display:flex;align-items:center;gap:8px;border:1px solid #d8b88c88;border-radius:16px;padding:6px 10px;background:linear-gradient(110deg,#573955ed,#2c213ee8);color:#ffe7bd;text-align:left}.stamina-content{display:block;flex:1;min-width:0}.stamina-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;font:11px system-ui}.stamina-heading small{font-size:9px;color:#e0c4d8}.stamina-gem{display:grid;place-items:center;width:28px;height:29px;color:#ffb5cb;font-size:22px;text-shadow:0 1px 1px #ffeff4,0 3px 5px #8c385c;border:1px solid #dcbd8a;border-radius:50%;background:radial-gradient(ellipse at 35% 25%,#d49fbf,#693957 70%)}.stamina-track{display:block;overflow:hidden;height:5px;border-radius:4px;background:#140d23;margin:4px 0}.stamina-track i{display:block;height:100%;background:linear-gradient(90deg,#cf83ac,#f5cfa0);border-radius:4px;transition:width .3s}.stamina-next{display:block;color:#d7b9d1;font:9px system-ui}.stamina-prep{width:100%;margin:12px 0}.stamina-lobby{position:absolute;z-index:4;left:17px;top:134px;width:205px}.stamina-wait{color:#ffe0a2!important}
.recharge-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:12px 0}.recharge-grid>button{position:relative;display:flex;align-items:center;flex-direction:column;gap:6px;min-width:0;padding:12px 6px;border:1px solid #d6b68d77;border-radius:16px;background:linear-gradient(145deg,#604365,#2c213d);color:#ffe7bf}.recharge-grid .recharge-badge{font-size:10px;background:#b8885644;color:#ffe0aa;border-radius:10px;padding:3px 8px}.recharge-grid b{font-size:15px}.recharge-grid small{font-size:10px;line-height:1.5;color:#dfcbe7}.recharge-grid strong{display:block;width:90%;padding:6px;border-radius:10px;background:linear-gradient(#f5deb0,#cea263);color:#503644;font-size:16px}.recharge-grid .lobby-icon{width:40px;height:40px}
.lobby-icon{width:42px;height:42px;display:block;flex:none;filter:drop-shadow(0 3px 3px #21122a80)}
.economy-home .art-lobby-head{padding:18px 18px 0;pointer-events:none}.economy-home .screen-title{font-size:28px}.economy-home .screen-title small{font-size:10px;margin-top:6px}
.wallet-row{display:flex;justify-content:center;gap:8px;margin:10px 0}.wallet-row>button{display:flex;align-items:center;justify-content:center;gap:4px;min-height:38px;padding:3px 10px 3px 4px;background:linear-gradient(125deg,#694967e8,#2b203de8);border:1px solid #d8b786;border-radius:20px;color:#ffedc8;font:12px system-ui}.wallet-row .lobby-icon{width:28px;height:28px}.wallet-row b{font-size:14px}.wallet-row span{font-size:9px;color:#e0cce6}
.economy-home>.wallet-row{position:absolute;z-index:4;left:17px;top:92px;justify-content:flex-start;margin:0}.economy-home .wallet-row>button{min-height:34px}.economy-home .wallet-row b{font-size:12px}
.lobby-medallion{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;width:65px;min-height:68px;padding:4px 2px;color:#ffedc7;background:radial-gradient(ellipse at 50% 35%,#a078a566,#33213f88 70%);border:0;border-radius:25px;font:10px/1.3 system-ui;text-shadow:0 1px 4px #160d20;filter:drop-shadow(0 2px 3px #241529aa)}
.lobby-medallion:before{content:'';position:absolute;left:9px;right:9px;top:2px;height:47px;border:1px solid #d9ba8570;border-radius:50%;box-shadow:inset 0 0 0 3px #d8b67c15;pointer-events:none}.lobby-medallion>.lobby-icon{width:39px;height:39px;margin-bottom:5px}.lobby-medallion>span{background:#392641b8;padding:2px 6px;border-radius:8px;white-space:nowrap}.lobby-medallion em{position:absolute;right:-2px;top:0;border:1px solid #e8bd9a;border-radius:12px;padding:1px 5px;background:#a8526e;font:9px system-ui;color:#fff7da;min-width:16px}
.lobby-left-rail{position:absolute;left:12px;top:25%;z-index:3;display:flex;flex-direction:column;gap:7px}.lobby-settings{position:absolute;right:13px;top:24px;z-index:4;width:52px}.lobby-settings:before{left:3px;right:3px}
.lobby-talk{position:absolute;right:10%;top:55%;z-index:3;display:flex;align-items:center;gap:4px;padding:5px 10px 5px 4px;border:1px solid #f1d6a1aa;border-radius:23px;background:linear-gradient(#73526ad9,#3b2746ed);color:#fff0ce;font:11px system-ui;box-shadow:0 3px 12px #33203966}.lobby-talk .lobby-icon{width:30px;height:30px}.economy-home .world-speech{top:62%;font-size:11px;max-width:67%;right:6%}
.economy-home .world-task{width:100%;color:inherit;cursor:pointer}.economy-home .world-task>.lobby-icon{width:40px;height:40px}.economy-home .world-task strong{font-size:13px}.economy-home .world-task p{font-size:10px}.economy-home .world-home-dock{padding-top:15px}.economy-home .world-home-dock>.art-gold{font-size:23px}
.shop-head{text-align:center}.shop-head>.lobby-icon{margin:0 auto 8px;width:47px;height:47px}.shop-head>small{font:9px system-ui;letter-spacing:2px;color:#a786b0}.shop-head h2{margin:5px 0}.shop-head p{font-size:12px!important;line-height:1.5!important;margin:7px 0!important}
.shop-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin:12px 0}.shop-tabs button{min-height:37px;border:1px solid #bca0c959;border-radius:12px;background:#281d38;color:#e2cce7;font:11px system-ui;padding:5px}.shop-tabs button[aria-pressed=true]{background:linear-gradient(#96709c,#634b79);border-color:#edc88c;color:#fff0cf}
.economy-note{font:11px/1.6 system-ui!important;color:#bda9c9!important;margin:10px 0!important}.shop-goods{display:grid;gap:10px}.shop-goods article{display:grid;grid-template-columns:58px 1fr;gap:7px 10px;padding:12px;background:linear-gradient(135deg,#74507735,#20182f);border:1px solid #bfa0c45c;border-radius:17px}.shop-item-art{align-self:center;display:grid;place-items:center}.shop-item-art .lobby-icon{width:48px;height:48px}.shop-item-art .portrait-art{width:58px;height:78px!important;border-radius:15px}.shop-goods h3{font:15px Georgia,'Songti SC',serif;margin:0 0 4px;color:#ffe8bc}.shop-goods p{font:11px/1.6 system-ui!important;margin:0!important;color:#d1bfdc!important}.shop-goods small{font:10px system-ui;color:#bca3d0}.shop-goods article>.primary{grid-column:1/-1;margin:0!important;min-height:37px;padding:8px!important;font-size:12px!important}.shop-goods button:disabled{opacity:.65}
.currency-sources{padding:8px 12px;border:1px solid #c6a4c14d;border-radius:16px}.currency-sources h3{font-size:15px;margin:8px 0}.currency-sources p{font:12px/1.7 system-ui!important}.topup-disabled{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px;background:#b49bc014;border:1px dashed #ac8eb0;border-radius:15px;padding:12px;margin:14px 0;color:#dbc4e3}.topup-disabled span{flex:0 0 100%;font-size:11px;text-align:center}.topup-disabled .lobby-icon{width:35px;height:35px}
.shop-confirm{text-align:center;padding:10px}.shop-confirm>.lobby-icon{margin:auto;width:80px;height:80px}.shop-confirm>.portrait-art{width:100px;height:125px!important;margin:auto}.shop-confirm>strong{display:block;color:#ffe2a2;font-size:22px}.shop-confirm p{font-size:12px!important;line-height:1.7!important}
.stage-progress{display:flex;align-items:center;justify-content:center;gap:10px;border:1px solid #dbc39b55;border-radius:15px;background:#9c78ba15;padding:8px;margin:10px 0;text-align:left}.stage-progress>span{width:58px;flex:none}.stage-progress b{font-size:14px;color:#ffe6bb}.stage-progress small{display:block;font:10px/1.6 system-ui;color:#d9c5e1}.stage-dots{display:flex;gap:7px;margin-top:5px}.stage-dots i{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;border:1px solid #b5a0c2;font:10px system-ui;background:#34233f;color:#b7a0c4}.stage-dots i.done{background:#c2a679;color:#32203c;border-color:#ffdf9e}.stage-dots i.current{border-color:#ffe2a7;color:#ffe2a7;box-shadow:0 0 0 2px #ffe2a726}
.stage-choices{display:grid;gap:9px}.stage-choices button{display:grid;grid-template-columns:1fr auto;gap:5px;text-align:left;border:1px solid #d1a7cb80;border-radius:13px;background:#6143615c;color:#fce6c5;padding:12px;font:12px system-ui}.stage-choices b{font-size:14px}.stage-choices small{grid-column:1;font-size:10px;color:#d5bedc}.stage-choices span{grid-column:2;grid-row:1/3;align-self:center;font-size:10px;color:#f5d293}.stage-choices button:disabled{opacity:.55}.earned-currency{display:flex;align-items:center;justify-content:center;gap:6px;margin:15px auto;color:#ffe0a5}.earned-currency .lobby-icon{width:29px;height:29px}.earned-currency small{font-size:10px;color:#c7b0d3}.earned-currency b{font-size:20px}
.prep-tools small{display:block;font-size:10px;font-weight:400;color:#bba4c9}.prep-shop-link{font-size:11px!important;margin:4px 0!important}.prep-partners{grid-template-columns:repeat(auto-fit,minmax(42px,1fr))!important}
.daily-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:16px 0}.daily-day{text-align:center;display:flex;flex-direction:column;align-items:center;gap:5px;border:1px solid #b191bd55;border-radius:14px;padding:10px 3px;background:#5c406c25}.daily-day .lobby-icon{width:34px;height:34px}.daily-day b{font:10px/1.5 system-ui;color:#f5debb;min-height:30px}.daily-day small{font:11px system-ui;color:#dac4e4}.daily-day span{font:9px system-ui;color:#a997b6}.daily-day.today{background:linear-gradient(#95618555,#57406766);border-color:#f5d093;box-shadow:inset 0 0 12px #f4cd8e12}.daily-day.today span{color:#ffe1aa}.daily-day.claimed{opacity:.64}.daily-day.claimed span{color:#a7dbbc}.daily-day:last-child{grid-column:1/-1;flex-direction:row;justify-content:center;gap:12px}.daily-day:last-child b{min-height:0;max-width:110px}
.room-decor{position:absolute;inset:0;pointer-events:none;z-index:2}.moon-window{position:absolute;left:23%;top:22%;width:17%;aspect-ratio:1}.moon-window>.lobby-icon{width:100%;height:100%;filter:drop-shadow(0 0 8px #f9d9a566)}.moon-window i{position:absolute;left:15%;top:80%;width:1px;height:30px;background:#f5d38c}.moon-window i:nth-of-type(2){left:48%;height:43px}.moon-window i:nth-of-type(3){left:78%;height:24px}.moon-window i:after{content:'✧';position:absolute;bottom:-10px;left:-6px;color:#ffdd9f;font-size:17px}.star-curtain{position:absolute;left:8%;top:16%;display:flex;width:45%;justify-content:space-between}.star-curtain>span{position:relative;width:18px;padding-top:var(--drop)}.star-curtain>span:before{content:'';position:absolute;top:0;bottom:13px;left:50%;width:1px;background:linear-gradient(#d7ac76,#fff4c9)}.star-curtain .lobby-icon{width:18px;height:24px}
@media(max-height:720px){.economy-home .art-lobby-head{padding-top:10px}.economy-home .screen-title{font-size:25px}.economy-home .screen-title small{margin-top:2px}.economy-home>.wallet-row{top:70px}.lobby-left-rail{top:22%;gap:1px}.lobby-medallion{min-height:55px;width:59px;font-size:9px}.lobby-medallion>.lobby-icon{width:31px;height:31px;margin-bottom:3px}.lobby-medallion:before{height:37px;left:10px;right:10px}.lobby-settings{top:10px}.lobby-settings:before{left:5px;right:5px}.lobby-talk{top:53%;right:8%;font-size:10px}.economy-home .world-speech{top:62%;font-size:10px}.economy-home .world-home-dock{padding-top:8px}.economy-home .world-home-dock>.art-gold{font-size:20px;padding:9px}.economy-home .world-task{margin-bottom:6px;padding:5px 8px}.economy-home .world-task>.lobby-icon{width:30px;height:30px}.economy-home .world-task strong{font-size:12px}.stage-progress{padding:5px;margin:7px 0}.stage-progress>span{width:43px}.daily-grid{gap:5px}.daily-day{padding:7px 3px}}
