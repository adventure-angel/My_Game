.boutique-scroll{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;padding:12px 14px 18px;scroll-padding-bottom:14px}
.boutique-scroll .month-card-banner{margin:0 0 12px;padding:9px 10px;gap:8px}.boutique-scroll .month-card-banner b{font-size:13px}.boutique-scroll .month-card-banner small{font-size:10px}.boutique-scroll .month-emblem{font-size:39px}.boutique-scroll .month-card-banner em{font-size:10px}
.boutique-footer{flex:none;padding:8px 14px 10px;border-top:1px solid #d4b57a44;background:#251a32}.boutique-footer>.secondary{width:100%;min-height:42px;margin:0!important;padding:8px;border-color:#c7ab7f77}
[data-skin=boutique] .boutique-scroll .product-exchange{display:grid;grid-template-columns:72px 1fr;gap:8px;text-align:left;padding:12px;border-radius:16px!important}
[data-skin=boutique] .boutique-scroll .product-exchange .shop-item-art{height:75px;grid-row:1/3}[data-skin=boutique] .boutique-scroll .product-exchange .shop-item-art>.lobby-icon{width:72px;height:72px}[data-skin=boutique] .boutique-scroll .product-exchange .shop-item-art:after{display:none}[data-skin=boutique] .boutique-scroll .product-exchange>.primary{grid-column:2}
