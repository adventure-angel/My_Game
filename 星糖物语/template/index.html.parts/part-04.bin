.economy-home .lobby-left-rail{top:max(202px,27%)} @media(max-height:720px){.stamina-lobby{top:110px;width:200px;padding:4px 9px}.economy-home .lobby-left-rail{top:166px;display:grid;grid-template-columns:repeat(2,59px);gap:5px}}

/* Illustrated v13 objects, with real stateful v15 controls and readable paper. */
.month-card-banner{display:flex;width:100%;align-items:center;gap:9px;text-align:left;padding:12px 10px;margin:12px 0;border:1px solid #e2c18a;border-radius:16px;background:radial-gradient(ellipse at 20% 20%,#ac82ba66,transparent),linear-gradient(120deg,#463459,#23192e);color:#fff0ce;box-shadow:inset 0 0 0 3px #e5c49215}.month-card-banner>span:nth-child(2){flex:1;min-width:0}.month-card-banner b{display:block;font:15px/1.5 Georgia,'Songti SC',serif}.month-card-banner small{display:block;color:#dfc9df;font:10px/1.8 system-ui}.month-card-banner em{font:10px/1.4 system-ui;color:#ffe1a5;max-width:54px}.month-emblem{display:block;font:52px/1 Georgia,serif;color:#ffe1a3;text-shadow:0 0 20px #c79be799;flex:none}.month-card-detail>.month-emblem{font-size:74px;margin:3px auto 15px}.month-card-detail>small{font:9px system-ui;letter-spacing:3px;color:#d4b8d9}.month-benefits{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:18px 0}.month-benefits>div{border:1px solid #ccab7955;border-radius:12px;padding:12px 4px;background:#a67fc316}.month-benefits b{display:block;font-size:25px;color:#f3d594}.month-benefits small{display:block;font:10px/1.8 system-ui;color:#d6bfdc}.month-daily{display:flex;align-items:center;justify-content:center;gap:5px}.month-daily .prop-art{width:47px;height:47px}.month-daily b{font-size:12px;color:#f6dbb3}
.prop-art{display:inline-block;position:relative;aspect-ratio:1;padding:0!important;border:0!important;border-radius:0!important;background-color:transparent!important;background-image:none!important;overflow:hidden}
.prop-art>i{position:absolute;display:block;left:16.667%;top:0;width:66.667%;height:100%;background-image:var(--economy-props);background-size:300% 200%;background-repeat:no-repeat}
.prop-coin>i{background-position:0 0}.prop-diamond>i{background-position:50% 0}.prop-hammer>i{background-position:100% 0}.prop-shuffle>i{background-position:0 100%}.prop-mail>i{background-position:50% 100%}.prop-calendar>i{background-position:100% 100%}
.lobby-medallion>.prop-art{width:52px;height:52px;margin:-3px 0 0;background-color:transparent!important}.wallet-row .prop-art{width:34px;height:34px}.lobby-medallion:has(.prop-art):before{border:0;box-shadow:none}.lobby-medallion:has(.prop-art){background:none}
body .dialog[data-skin=boutique],body .dialog[data-skin=daily],body .dialog[data-skin=mail],body .dialog[data-skin=purchase]{max-width:460px;padding:20px 16px;border:1px solid #dbbc84;border-radius:25px;background:linear-gradient(#21172dd9,#251930f5 260px),var(--world-room) center top/cover;box-shadow:0 20px 70px #080310aa,inset 0 0 0 4px #dab78022;color:#f9e7c8;scrollbar-width:thin;scrollbar-color:#b79a77 #2e203b}
body .dialog[data-skin]:not([data-skin=""]) button{touch-action:manipulation}
body .dialog[data-skin]:not([data-skin=""]) .primary{background:linear-gradient(180deg,#795985,#4c315d);border:1px solid #e6c48b;color:#fff0d1;box-shadow:inset 0 0 0 3px #e2b88718,0 4px 0 #1a1125;min-height:44px;font-family:Georgia,'Songti SC',serif}
body .dialog[data-skin]:not([data-skin=""]) .primary:disabled{opacity:.6;box-shadow:none}
body .dialog[data-skin]>.secondary{margin-top:14px;border-color:#c4a28066;color:#e8d4bf;background:#39294088;min-height:42px}
body .dialog[data-skin]:not([data-skin=""]) .economy-note{color:#dac9d9!important;font-size:11px!important}
.boutique-head{position:relative;padding:0 0 6px}.boutique-emblem{display:flex;align-items:center;justify-content:center;height:100px;margin:-12px auto 0;isolation:isolate}.boutique-emblem:before{content:'';position:absolute;top:32px;width:80%;height:1px;background:linear-gradient(90deg,transparent,#d9bc85,transparent);z-index:-1}.boutique-emblem .prop-art{width:85px;height:85px;filter:drop-shadow(0 4px 12px #9d73c744)}.boutique-emblem .prop-diamond{width:108px;height:108px;margin:0 -8px}.boutique-head h2{font-size:29px!important;letter-spacing:4px;color:#fff0cc}.boutique-head small,.daily-heading>small,.mail-heading>small{color:#d3b88d!important;letter-spacing:3px;font:9px system-ui}.boutique-head p{color:#ddc8df!important}
[data-skin=boutique] .wallet-row{margin:8px 0 15px}[data-skin=boutique] .wallet-row>button{flex:1;max-width:170px;background:#1f172dcc;border-color:#c8a46b77}[data-skin=boutique] .shop-tabs{gap:0;border-bottom:1px solid #d4b07988;padding-bottom:8px}[data-skin=boutique] .shop-tabs button{border:0;border-radius:10px;background:none;font-size:12px;padding:10px 2px}[data-skin=boutique] .shop-tabs button[aria-pressed=true]{background:linear-gradient(#b08a9355,#6b477f);box-shadow:inset 0 -2px #e7c488;color:#ffe2ad}
[data-skin=boutique] .shop-goods{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 10px}
[data-skin=boutique] .shop-goods article{position:relative;display:flex;flex-direction:column;gap:9px;min-width:0;text-align:center;padding:10px 9px 13px;border:1px solid #bc9a71;border-radius:50px 50px 13px 13px;background:radial-gradient(ellipse at 50% 20%,#aa85b344,transparent 65%),linear-gradient(125deg,#392642,#22172d);box-shadow:inset 0 0 0 4px #d5ac7312,0 5px 0 #100a1d}
[data-skin=boutique] .shop-item-art{position:relative;width:100%;height:125px;display:grid;place-items:center;margin:0}
[data-skin=boutique] .shop-item-art:after{content:'';position:absolute;bottom:0;left:3%;width:94%;height:20px;border-radius:50%;border-bottom:3px solid #c6a475;background:radial-gradient(ellipse,#8b5c9370,#382342);z-index:0}
[data-skin=boutique] .shop-item-art>.lobby-icon{position:relative;z-index:1;width:120px;height:120px;filter:drop-shadow(0 6px 8px #08030d99)}
[data-skin=boutique] .shop-goods h3{font-size:17px;line-height:1.4;margin:3px 0 6px}[data-skin=boutique] .shop-goods p{font-size:11px!important;line-height:1.7!important;color:#e0cddd!important}[data-skin=boutique] .shop-goods small{display:block;margin:6px 0 2px;color:#d3b68c}[data-skin=boutique] .shop-goods article>.primary{width:100%;margin-top:auto!important;min-height:40px;font-size:13px!important}
[data-skin=boutique] .shop-goods .product-partner{grid-column:1/-1;display:grid;grid-template-columns:105px 1fr;text-align:left;border-radius:16px;padding:12px;gap:8px 13px;background:linear-gradient(110deg,#78527966,#291e38)}
[data-skin=boutique] .product-partner .shop-item-art{grid-row:1/3;height:150px;align-self:center}[data-skin=boutique] .product-partner .shop-item-art:after{display:none}[data-skin=boutique] .product-partner .portrait-art{width:100%;height:150px!important;border-radius:50px 50px 10px 10px;border:1px solid #d4b287;box-shadow:0 3px 14px #10051a77}[data-skin=boutique] .shop-goods .product-partner>.primary{grid-column:2}[data-skin=boutique] .product-exchange{grid-column:1/-1;border-radius:18px!important}[data-skin=boutique] .product-exchange .shop-item-art{height:90px}[data-skin=boutique] .product-exchange .shop-item-art>.lobby-icon{width:90px;height:90px}
[data-skin=boutique] .currency-sources{border:none;padding:0}[data-skin=boutique] .recharge-grid>button{border-color:#b99467;background:radial-gradient(ellipse at 50% 40%,#8c68aa66,#2d203b 80%);box-shadow:inset 0 0 0 3px #e5c68918;padding:12px 5px}[data-skin=boutique] .recharge-grid .prop-art{width:85px;height:85px;margin:-5px 0}[data-skin=boutique] .recharge-grid .recharge-badge{border:1px solid #ceaa7566;color:#ffe5b8;background:#67475a}[data-skin=boutique] .recharge-grid strong{background:linear-gradient(#f7dfa4,#cca268);color:#482939;border:1px solid #fff0bf}
body .dialog[data-skin=daily]{background:linear-gradient(#251830da,#291c35ed),var(--world-room) center/cover;padding:16px 12px}.daily-heading>.prop-art{width:75px;height:75px;margin:-6px auto 0}.daily-heading h2{font-size:25px!important;color:#ffe8bd}.daily-heading p{color:#d7bfda!important}.daily-book{position:relative;border:2px solid #c19b68;border-radius:13px 13px 24px 24px;padding:12px 10px 15px;background:linear-gradient(90deg,#ead7af,#fff3d5 46%,#cab38c 49%,#9a7a5c 50%,#e8d1ac 51%,#fff2d2 55%,#e9d4ad);box-shadow:0 6px 0 #bf9f75,0 10px 0 #755071,0 12px 20px #0c061c88,inset 0 0 0 4px #e1c18d}.daily-book:before{content:'✦';position:absolute;top:-11px;left:calc(50% - 12px);color:#996e48;font-size:24px;z-index:1}.daily-book .daily-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px 18px;margin:0}.daily-book .daily-day{position:relative;min-width:0;gap:3px;border:1px solid #b393695c;border-radius:8px;padding:8px 3px;background:#fff9e63d;color:#573a4c}.daily-book .daily-day small{font:12px Georgia,'Songti SC',serif;color:#6d4d62}.daily-treasures{height:65px;display:flex;justify-content:center;align-items:center;width:100%}.daily-treasures .prop-art{width:65px;height:65px;flex:0 1 65px;filter:drop-shadow(0 3px 3px #98754b55)}.daily-treasures .prop-art+.prop-art{margin-left:-12px}.daily-book .daily-day b{color:#593c4e;font:11px/1.5 system-ui;min-height:0}.daily-book .daily-day>span{color:#7e6677;font:10px system-ui}.daily-book .daily-day.today{border:1px solid #a66f39;background:radial-gradient(ellipse,#fffdf2,#ffe4a3);box-shadow:0 0 0 2px #cfa35b55,inset 0 0 12px #f8ca6b66}.daily-book .daily-day.today>span{color:#8a5429;font-weight:700}.daily-book .daily-day.claimed{opacity:.7;background:#dac9b9}.daily-book .daily-day.claimed>span{color:#576753}.daily-book .daily-day:last-child{grid-column:1/-1;flex-direction:column;border:1px solid #ae8156;background:linear-gradient(120deg,#dfc49a,#fff0d2,#e4c79d);padding:9px}.daily-book .daily-day:last-child .daily-treasures{height:70px}.daily-book .daily-day:last-child b{max-width:none}.daily-caption{font:11px/1.6 system-ui!important;color:#e0c7d8!important;margin:22px 0 12px!important;text-align:center}
body .dialog[data-skin=mail]{padding:22px 17px;background:linear-gradient(#20162aab,#261930f2 240px),var(--world-room) center top/cover}.mail-heading{text-align:center;padding-bottom:16px}.mail-heading>.prop-art{width:128px;height:128px;margin:-10px auto 0}.mail-heading h2{color:#ffe8bd;font-size:29px!important;letter-spacing:3px;margin:6px 0}.mail-heading p{font-size:12px!important;color:#e4cddd!important}.mail-row{position:relative;min-height:84px!important;border:1px solid #c9a373!important;border-radius:8px!important;background:linear-gradient(120deg,#f3e1be,#fff3db 55%,#e5ccaa)!important;color:#5a3b51!important;padding:13px 10px!important;box-shadow:0 4px 0 #6d4a65;margin-bottom:13px!important;text-align:left}.mail-row b{font:16px/1.5 Georgia,'Songti SC',serif!important}.mail-row small{color:#865f75!important;font-size:11px}.letter-envelope{display:grid;place-items:center;width:43px;height:32px;flex:none;color:#f9d7a9!important;background:linear-gradient(30deg,transparent 48%,#d0b38b 49%,#f9eace 51%);border:1px solid #b69366;box-shadow:0 2px 3px #6a486344;font-size:22px!important}.mail-letter-top>.prop-art{width:100px;height:100px;margin:-12px auto -10px}.letter-paper{position:relative;background:linear-gradient(115deg,#f0dfbe,#fff4de 45%,#ead3b0)!important;color:#54394a!important;padding:30px 23px!important;border:1px solid #cfaa70!important;border-radius:5px!important;box-shadow:inset 0 0 0 5px #e8d0a5,inset 0 0 0 6px #bf956866,0 5px 20px #0e071d66;min-height:320px}.letter-paper:before{content:'✦';display:block;text-align:center;color:#9d754e;font-size:25px;margin-bottom:8px}.letter-paper small{color:#89617c!important;letter-spacing:3px}.letter-paper h2{color:#59384e!important;font:23px/1.5 Georgia,'Songti SC',serif!important;margin:12px 0 20px!important}.letter-paper p{color:#634a57!important;font:15px/2.1 Georgia,'Songti SC',serif!important;overflow-wrap:anywhere}.letter-paper .letter-sign{text-align:right;color:#8e657e!important;margin-top:35px!important;font-size:13px!important}
[data-skin=purchase] .shop-confirm>.prop-art{width:145px;height:145px}[data-skin=purchase] .shop-confirm>.portrait-art{width:150px;height:190px!important;border-radius:55px 55px 14px 14px;border:1px solid #d7b78d}
@media(max-width:350px){body .dialog[data-skin=boutique]{padding:16px 10px}.boutique-emblem{height:83px}.boutique-emblem .prop-art{width:70px;height:70px}.boutique-emblem .prop-diamond{width:90px;height:90px}[data-skin=boutique] .shop-item-art{height:105px}[data-skin=boutique] .shop-item-art>.lobby-icon{width:100px;height:100px}[data-skin=boutique] .shop-goods .product-partner{grid-template-columns:85px 1fr}.daily-treasures{height:55px}.daily-treasures .prop-art{width:55px;height:55px}.letter-paper{padding:24px 17px!important}}

/* Moon's cover is the canonical identity, reused directly rather than redrawn. */
.portrait-art.portrait-0{background-image:var(--moon-master)!important;background-size:260% auto!important;background-position:50% 24%!important}
.art-character-0 .art-partner-scene{background-image:var(--moon-master);background-position:center 32%;bottom:14%}

/* Use available WebView space, including dynamic browser chrome changes. */
body .app{height:var(--game-vh,100dvh)}
body .cover-stage{height:100%;max-height:100%}
body .veil{box-sizing:border-box;height:var(--game-vh,100dvh);top:var(--game-vtop,0px);bottom:auto;padding:max(8px,env(safe-area-inset-top)) max(8px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-left));overflow:hidden}
body .dialog{box-sizing:border-box;max-height:100%;min-height:0;overscroll-behavior:contain}
body .dialog[data-skin=preparation]{padding:0;overflow:hidden;max-width:440px;display:flex;flex-direction:column;height:min(600px,calc(var(--game-vh,100dvh) - 24px));border-radius:22px}
.prep-sheet{display:flex;flex-direction:column;min-height:0;flex:1;width:100%;overflow:hidden}
.prep-header{flex:none;min-height:66px;box-sizing:border-box;padding:12px 14px;display:flex;align-items:center;justify-content:space-between;text-align:left;background:linear-gradient(100deg,#251a36ee,#49354a88),var(--world-cloud) center 48%/cover;border-bottom:1px solid #d7bd8633}
.prep-header small{font:11px system-ui;color:#ecd19f}.prep-header h2{font-size:19px!important;margin:4px 0 0!important;line-height:1.3}.prep-header button{flex:none;width:44px;height:44px;padding:0;font-size:26px}
.prep-header:is(.place-4,.place-5,.place-6,.place-7){background-image:linear-gradient(100deg,#251a36ee,#49354a88),var(--world-forest)}
.prep-header:is(.place-8,.place-9,.place-10,.place-11){background-image:linear-gradient(100deg,#251a36ee,#49354a88),var(--world-sea)}
.prep-scroll{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:10px 14px 4px;scrollbar-width:thin}
.prep-sheet .prep-goals{gap:6px;margin:0 0 8px}.prep-sheet .prep-goals>div{display:flex;align-items:center;justify-content:center;gap:6px;padding:8px 4px;border-radius:12px;min-width:0}.prep-sheet .prep-goals span,.prep-sheet .prep-goals svg{width:21px;height:23px;font-size:21px}.prep-sheet .prep-goals strong{font-size:16px;white-space:nowrap}.prep-sheet .prep-goals small{font-size:10px}
.prep-sheet .stage-progress{margin:0 0 8px;padding:5px 8px;gap:8px;justify-content:flex-start}.prep-sheet .stage-progress>span{width:40px}.prep-sheet .stage-progress b{font-size:12px}.prep-sheet .stage-progress small{font-size:10px}.prep-sheet .stage-dots{gap:5px;margin-top:3px}.prep-sheet .stage-dots i{width:16px;height:16px;font-size:9px}
.prep-sheet .prep-label{font-size:12px;margin:8px 0 6px}.prep-sheet .prep-label small{font-size:10px;margin-left:6px}
.prep-sheet .prep-partners{display:flex!important;gap:7px;overflow-x:auto;overflow-y:hidden;padding:2px 1px 4px;min-height:70px}
.prep-sheet .prep-partners button{box-sizing:border-box;flex:0 0 58px;width:58px;min-width:58px;height:70px;min-height:0;padding:2px 2px 3px;display:flex;flex-direction:column;align-items:center;gap:2px;border-radius:12px}
.prep-sheet .prep-partners .portrait-art{display:block;width:46px!important;height:46px!important;min-height:0!important;max-height:46px!important;aspect-ratio:1;flex:none;border-radius:8px}
.prep-sheet .prep-partners button>span:last-child{font:11px/15px system-ui}
.prep-help{text-align:left;margin:4px 0 8px;border-bottom:1px solid #dbcba526;padding:0 0 5px}.prep-help summary{font:11px/1.5 system-ui;color:#edc88d;cursor:pointer;min-height:28px;display:list-item;align-content:center}.prep-help p{font:11px/1.65 system-ui!important;margin:5px 0!important;color:#dbcde4}
.prep-sheet .prep-tools{gap:7px}.prep-sheet .prep-tools button{padding:7px 4px;min-height:44px;font-size:12px}.prep-sheet .prep-tools small{font-size:10px;margin-top:2px}.prep-sheet .prep-shop-link{display:block;padding:7px!important;min-height:32px;width:100%}
.prep-footer{flex:none;padding:8px 14px 12px;background:#281d36;border-top:1px solid #cbb08a44;box-shadow:0 -6px 18px #160e251c}
.prep-sheet .stamina-prep{width:100%;margin:0 0 7px;padding:5px 9px}.prep-sheet .prep-start{margin:0!important;min-height:44px;padding:10px!important;font-size:15px!important;width:100%}
.prep-sheet .prep-warning{margin:5px 0!important}
@media(max-height:600px){.prep-header{min-height:55px;padding:6px 12px}.prep-header h2{font-size:17px!important}.prep-scroll{padding-top:6px}.prep-footer{padding:6px 12px 8px}.prep-sheet .prep-partners{min-height:60px}.prep-sheet .prep-partners button{height:60px;flex-basis:50px;min-width:50px;width:50px}.prep-sheet .prep-partners .portrait-art{width:37px!important;height:37px!important;max-height:37px!important}.prep-sheet .stage-progress{margin-bottom:4px}.prep-sheet .stage-progress>span{width:32px}.prep-sheet .prep-label{margin-top:5px}}
@media(max-width:350px){.prep-header h2{font-size:17px!important}.prep-scroll{padding-left:10px;padding-right:10px}.prep-sheet .prep-goals>div{gap:3px}.prep-sheet .prep-goals strong{font-size:14px}.prep-sheet .prep-goals small{font-size:9px}.prep-sheet .stage-progress small{font-size:9px}}

/* Resource and shortcut positions share a flow, not overlapping pixel anchors. */
.economy-home .lobby-layout{position:absolute;z-index:4;inset:0 0 auto;display:flex;flex-direction:column;align-items:flex-start;padding:14px 16px 0;gap:12px;pointer-events:none;box-sizing:border-box}
.economy-home .lobby-layout button{pointer-events:auto}
.economy-home .lobby-layout .art-lobby-head{position:static;padding:0 54px 0 0;min-height:48px;width:100%;box-sizing:border-box}
.economy-home .lobby-layout .screen-title{font-size:26px;line-height:1.2}.economy-home .lobby-layout .screen-title small{font-size:10px;letter-spacing:1px;margin-top:6px}
.economy-home .lobby-resources{display:grid;gap:10px;width:min(100%,300px);padding:0;box-sizing:border-box}
.economy-home .lobby-resources .wallet-row{position:static;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0;width:100%}
.economy-home .lobby-resources .wallet-row>button{min-width:0;min-height:39px;padding:3px 9px;gap:5px;justify-content:flex-start;background:#291e3cdb;box-shadow:0 2px 8px #160e2433;border-color:#d6b98c88}
.economy-home .lobby-resources .wallet-row b{font-size:13px;overflow-wrap:anywhere}.economy-home .lobby-resources .wallet-row>button>span:last-child{font-size:10px;margin-left:auto}.economy-home .lobby-resources .prop-art{width:30px;height:30px}
.economy-home .lobby-resources .stamina-lobby{position:static;width:100%;margin:0;min-height:47px;padding:7px 10px;box-sizing:border-box;gap:9px;border-radius:14px;background:#291e3cdb;border-color:#d6b98c88}
.economy-home .lobby-resources .stamina-heading{font-size:11px}.economy-home .lobby-resources .stamina-next{font-size:9px;line-height:1.5}.economy-home .lobby-resources .stamina-track{margin:5px 0;height:4px}
.economy-home .lobby-layout .lobby-settings{top:12px;right:13px;width:43px;min-height:44px;padding:0;background:#241b35b0;border:1px solid #d3b27e66;border-radius:15px}.economy-home .lobby-layout .lobby-settings:before{display:none}.economy-home .lobby-layout .lobby-settings .lobby-icon{width:26px;height:26px;margin:0}.economy-home .lobby-layout .lobby-settings>span{display:none}
.economy-home .lobby-layout .lobby-left-rail{position:static;display:grid;grid-template-columns:repeat(2,60px);gap:12px 10px;margin-top:2px;pointer-events:auto}
.economy-home .lobby-layout .lobby-left-rail .lobby-medallion{width:60px;min-height:62px;padding:0 1px;background:none;filter:drop-shadow(0 2px 3px #24152988)}
.economy-home .lobby-layout .lobby-left-rail .lobby-medallion:before{display:none}.economy-home .lobby-layout .lobby-left-rail .lobby-icon{width:40px;height:40px;margin:0}.economy-home .lobby-layout .lobby-left-rail .lobby-medallion>span:last-of-type{font-size:10px;padding:3px 5px;border:1px solid #e5c39744;background:#302039db}.economy-home .lobby-layout .lobby-left-rail em{top:-3px;right:-1px}
body .dialog[data-skin=boutique]{height:min(760px,calc(var(--game-vh,100dvh) - 24px));padding:0;display:flex;flex-direction:column;overflow:hidden}
.boutique-sheet{display:flex;flex-direction:column;min-height:0;width:100%;flex:1;overflow:hidden}.boutique-fixed{flex:none;padding:14px 14px 0;background:linear-gradient(#33223eee,#24192de8);border-bottom:1px solid #dab78366}
