/* The dismiss control stays inside the dialog focus scope and above scrolling content. */
body .dialog .dialog-corner-close{position:sticky;top:0;float:right;z-index:30;display:flex;align-items:center;justify-content:center;flex:none;align-self:flex-end;width:44px;height:44px;min-height:44px;margin:0 0 -44px auto;padding:9px;border:1px solid #e3c798b3;border-radius:50%;background:linear-gradient(145deg,#58405bea,#24182fed);box-shadow:0 2px 9px #140c2666,inset 0 1px #fff3d02b;color:#ffedc5;cursor:pointer;touch-action:manipulation}
body .dialog .dialog-corner-close svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}
body .dialog .dialog-corner-close:focus-visible{outline:2px solid #fff2c9;outline-offset:2px}
body .dialog .dialog-corner-close:active{filter:brightness(1.3)}
body .dialog[data-skin=boutique]>.dialog-corner-close,body .dialog[data-skin=preparation]>.dialog-corner-close{position:absolute;right:10px;top:10px;margin:0}
body .dialog[data-skin=boutique] .boutique-fixed .boutique-emblem{right:42px;width:58px;opacity:.7}
body .dialog[data-skin=boutique] .boutique-footer:has(button[hidden]){display:none}
body .dialog .prep-header{padding-right:60px}
body .dialog button[hidden]{display:none!important}
body .dialog>.shop-head,body .dialog>.mail-heading{padding-right:44px}
.growing-room{height:100%;min-height:0!important;background:#18162d}
.growing-room:before{content:'';position:absolute;inset:-10px;background:var(--room-base) center/cover;filter:blur(15px) brightness(.45);pointer-events:none}
.rg-canvas{position:absolute;inset:0 0 115px;overflow:hidden;isolation:isolate}
.rg-background{position:absolute;inset:0;background:var(--room-base) center/100% 100% no-repeat}
.rg-canvas:after{content:'';position:absolute;inset:0;background:linear-gradient(#11152955,transparent 18%,transparent 76%,#1e152b);pointer-events:none;z-index:4}
.rg-header{position:absolute;inset:0 0 auto;z-index:10;display:flex;align-items:center;gap:8px;padding:12px;color:#ffedc4;text-shadow:0 2px 5px #191020}
.rg-header>button{width:36px;height:36px;flex:none;border:1px solid #e9d0a4;border-radius:50%;background:#342543c9;color:#ffe7bb;font:27px/1 Georgia}
.rg-header>div{min-width:0;flex:1}.rg-header .screen-title{margin:0;padding:0;font-size:24px;line-height:1.2;font-weight:500;letter-spacing:1px}.rg-header small{display:block;font:10px/1.5 system-ui;margin-top:2px;color:#e0c9e1}.rg-header>span{font:10px/1.5 system-ui;border:1px solid #d4b88877;border-radius:14px;background:#2b1b36b8;padding:5px 9px;white-space:nowrap}
.rg-tools{position:absolute;right:10px;top:76px;display:flex;gap:6px;z-index:10}.rg-tools button{min-width:44px;min-height:36px;padding:4px 9px;border:1px solid #d9bd9288;border-radius:16px;background:#30203ed9;color:#ffe8bb;font:11px system-ui}
.rg-object{position:absolute;left:var(--x);top:var(--y);width:var(--w);aspect-ratio:1;transform:translate(-50%,-50%);background:none;border:0;padding:0;z-index:3;cursor:pointer;filter:drop-shadow(0 4px 3px #120b2344);min-width:24px;min-height:24px}
.rg-object .collection-art{width:100%;height:100%;aspect-ratio:1;background-color:transparent}
.rg-object:focus-visible{outline:2px solid #ffe5a5;border-radius:12px}.rg-object:active{filter:drop-shadow(0 0 9px #ffe7b8)}
.rg-object-2{z-index:1}.rg-object-8{z-index:1;transform:translate(-50%,-50%) scaleY(.55)}.rg-object-11{z-index:2}.rg-object-3{z-index:3}
.rg-object-0{filter:brightness(.7) saturate(.7)}.rg-lit .rg-object-0{filter:drop-shadow(0 0 13px #ffd477aa) brightness(1.08)}
.rg-warmth{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:0;background:radial-gradient(ellipse at var(--lamp-x) var(--lamp-y),#ffbb5266 0%,#f4b65422 24%,transparent 60%);mix-blend-mode:screen;transition:opacity 1.4s}
.rg-lit .rg-warmth{opacity:1}.rg-candle-glow{position:absolute;left:0;top:29%;width:35%;height:42%;background:radial-gradient(ellipse,#ffd47944,transparent 66%);opacity:0;pointer-events:none;mix-blend-mode:screen;z-index:2}.rg-candle-lit .rg-candle-glow{opacity:1;animation:rg-candle 3s ease-in-out infinite alternate}
.rg-soft{position:absolute;display:block;aspect-ratio:1;pointer-events:none;background-image:var(--room-soft);background-repeat:no-repeat;background-size:300% 200%;z-index:2;filter:drop-shadow(0 3px 3px #29173044)}
.rg-soft-0{background-position:0 0}.rg-soft-1{background-position:50% 0}.rg-soft-2{background-position:100% 0}.rg-soft-3{background-position:0 100%}.rg-soft-4{background-position:50% 100%}.rg-soft-5{background-position:100% 100%}
.rg-cushions{width:28%;left:5%;top:53%}.rg-vase{width:14%;left:25%;top:35%}.rg-tea{width:18%;left:32%;top:73%}.rg-flowers{width:43%;left:-7%;top:1%;opacity:.95}
.rg-curtains{width:73%;height:72%;left:-4%;top:1%;z-index:1}.rg-porch{width:32%;right:-7%;top:29%;z-index:2}.rg-stars{width:80%;left:10%;top:2%;height:23%;z-index:2;animation:rg-glimmer 4s ease-in-out infinite alternate}
.rg-person-hotspot,.rg-cat-hotspot{position:absolute;background:transparent;border:0;padding:0;border-radius:50%;z-index:5;cursor:pointer}.rg-person-hotspot{left:53%;top:35%;width:22%;height:18%}.rg-cat-hotspot{left:70%;top:61%;width:22%;height:12%}.rg-person-hotspot:focus-visible,.rg-cat-hotspot:focus-visible{outline:2px solid #ffe1a2}
.rg-cat-spark{position:absolute;left:83%;top:60%;z-index:6;opacity:0;color:#ffe4b5;font:28px Georgia;pointer-events:none;text-shadow:0 0 10px #f4c3eb}.rg-cat-react .rg-cat-spark{animation:rg-note 2.3s ease-out both}
.rg-speech{position:absolute;z-index:6;bottom:9px;left:6%;right:6%;margin:0;padding:8px 11px;border:1px solid #f3dfb8;border-radius:13px 13px 13px 3px;background:#f5e6dbeb;color:#604362;box-shadow:0 3px 12px #21142c44;font:11px/1.55 system-ui;pointer-events:none}.rg-speech b{font-size:10px;color:#97709d;margin-right:8px}
.rg-dock{position:absolute;bottom:0;left:0;right:0;z-index:10;min-height:115px;box-sizing:border-box;padding:8px 14px 10px;background:linear-gradient(#2e2039f7,#1e172d);border-top:1px solid #c7a56d88}
.rg-wish{display:flex;align-items:center;gap:8px;margin-bottom:5px}.rg-prize{background:#6e4c6a25;border:1px solid #d4b68a66;border-radius:13px;padding:0;flex:none;width:53px;height:53px}.rg-wish>div{flex:1;min-width:0}.rg-wish small{display:block;font:9px/1.3 system-ui;color:#d7bbd7}.rg-wish b{display:block;font:14px/1.6 Georgia,'Songti SC',serif;color:#ffe7b4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rg-preview-link{font:10px system-ui;color:#ebd3aa;border:0;background:none;min-height:36px;padding:4px}
.rg-progress{display:flex;gap:5px;align-items:center;margin-top:2px}.rg-progress>span{width:15px;height:15px;border:1px solid #bd9fba;border-radius:50%;display:grid;place-items:center;font:8px system-ui;color:#ceb6d3}.rg-progress>span.done{color:#4c334c;background:#f7dba4;border-color:#f7dba4}.rg-progress>small{font-size:9px;margin-left:3px}
.rg-dock>.primary{font-size:17px!important;min-height:40px!important;padding:8px!important;letter-spacing:1px;width:100%;margin:3px 0 0!important}.rg-dock .art-gold:before,.rg-dock .art-gold:after{font-size:15px}
.rg-dock-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:13px}.rg-dock-heading>span{font:9px system-ui;color:#f4d79b}.rg-dock p{font:10px/1.5 system-ui;color:#e1c5dd;margin:6px 0}.rg-style-choice{display:flex;gap:7px;margin-top:6px}.rg-style-choice button{flex:1;padding:5px;font:11px system-ui;border:1px solid #af92b0;border-radius:14px;background:#35253e;color:#e6cde5;min-height:32px}.rg-style-choice [aria-pressed=true]{border-color:#edc884;background:#775273;color:#ffe8bd}.rg-dock-buttons{display:flex;gap:8px}.rg-dock-buttons button{flex:1;font-size:13px!important;min-height:38px!important;padding:6px!important;margin:0!important}.rg-preview-dock{min-height:150px}
.growing-room:has(.rg-preview-dock) .rg-canvas{bottom:160px}
.rg-preview{outline:1px dashed #ffedc5;border-radius:18px;box-shadow:0 0 12px #ffd19d44}.rg-preview:after{content:'预览';position:absolute;left:50%;bottom:-12px;transform:translateX(-50%);background:#34203be8;border:1px solid #f4d5a8;border-radius:10px;color:#ffe9bb;font:9px/1.3 system-ui;padding:2px 6px;white-space:nowrap}
.rg-celebration{position:absolute;inset:0;z-index:20;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:radial-gradient(ellipse,#24132b00 40%,#1b102f44);pointer-events:none}.rg-celebration>span{font-size:60px;color:#ffe3a0;animation:rg-reveal 3.8s ease-out both;text-shadow:0 0 30px #ffd68e}.rg-celebration strong{padding:9px 16px;border:1px solid #f2d7a7;border-radius:18px;background:#35203cd9;color:#ffe5ad;font:16px Georgia;animation:rg-reveal 3.8s ease-out both}.rg-celebration button{position:absolute;right:12px;top:80px;padding:9px 12px;border:1px solid #e0c19c;border-radius:18px;background:#332039ed;color:#ffedcc;font:11px system-ui;pointer-events:auto}
.rg-celebrating .rg-warmth{animation:rg-welcome 3.8s ease-out}.rg-music-petals{position:absolute;inset:26% 0 auto;text-align:center;color:#ffe5ca;font-size:22px;animation:box-turn 5s linear infinite;pointer-events:none}.rg-object-react{animation:rg-bob 1.4s ease-in-out}
.rg-arrange-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0}.rg-arrange-grid>div{border:1px solid #cba57a77;border-radius:15px;background:#80567a24;overflow:hidden}.rg-arrange-grid button{display:block;width:100%;padding:6px;background:none;border:0;color:#ffe4bc;text-align:center}.rg-arrange-grid .collection-art{width:76px;height:76px;margin:auto}.rg-arrange-grid b{display:block;font-size:12px}.rg-arrange-grid small{display:block;font:10px/1.5 system-ui;color:#d9badb;margin-top:3px}.rg-arrange-grid .rg-store{border-top:1px solid #cba57a44;font:11px system-ui;min-height:32px;color:#dec8de}
.rg-memory-list{display:grid;gap:10px;margin:16px 0}.rg-memory-list button{display:flex;align-items:center;gap:10px;text-align:left;padding:8px;border:1px solid #cba57a77;border-radius:15px;background:#80567a24;color:#ffe4bc}.rg-memory-list .collection-art{flex:none;width:58px;height:58px}.rg-memory-list b{font-size:13px}.rg-memory-list small{display:block;font:11px/1.6 system-ui;color:#d9badb;margin-top:5px}.rg-empty-memory{padding:20px;border:1px dashed #e2bf8b66;border-radius:16px}
@keyframes rg-note{0%{opacity:0;transform:translateY(8px) scale(.8)}20%{opacity:1}100%{opacity:0;transform:translateY(-30px) scale(1.1)}}
@keyframes rg-candle{from{opacity:.7}to{opacity:1}}@keyframes rg-glimmer{from{filter:drop-shadow(0 0 2px #f1d89744)}to{filter:drop-shadow(0 0 7px #f1d89799)}}
@keyframes rg-reveal{0%{opacity:0;transform:translateY(14px) scale(.85)}15%,85%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-12px)}}
@keyframes rg-welcome{0%{opacity:0}40%,100%{opacity:1}}@keyframes rg-bob{50%{transform:translate(-50%,-54%) scale(1.08)}}
@media(max-height:620px){.rg-header{padding:8px 10px}.rg-header .screen-title{font-size:21px}.rg-tools{top:62px}.rg-canvas{bottom:106px}.rg-dock{min-height:106px;padding:5px 12px 8px}.rg-prize{width:44px;height:44px}.rg-wish b{font-size:12px}.rg-dock>.primary{font-size:15px!important;min-height:36px!important}.rg-speech{font-size:10px;padding:5px 8px}.rg-preview-dock{min-height:142px}.growing-room:has(.rg-preview-dock) .rg-canvas{bottom:150px}}
.reduced .growing-room *{animation:none!important;transition:none!important}@media(prefers-reduced-motion:reduce){.growing-room *{animation:none!important;transition:none!important}}
.rg-memory-picture{position:relative;isolation:isolate;width:min(100%,300px);aspect-ratio:2/3;margin:12px auto;border:1px solid #e1bd86;border-radius:15px;overflow:hidden;pointer-events:none}.rg-memory-picture .rg-object{display:block}.rg-memory-caption{position:absolute;bottom:0;left:0;right:0;padding:9px;background:#2e1d3bce;color:#ffe7bb;font:11px system-ui;z-index:8;text-align:center}

/* Transparent art atlas: individual, nonuniform sprite bounds. */
.rg-soft-0{aspect-ratio:430/420;background-size:291.6279069767442% 298.57142857142856%;background-position:2.4271844660194173% 19.18465227817746%}
.rg-soft-1{aspect-ratio:362/520;background-size:346.4088397790055% 241.15384615384613%;background-position:51.34529147982063% 9.536784741144414%}
.rg-soft-2{aspect-ratio:440/390;background-size:285% 321.53846153846155%;background-position:98.8943488943489% 23.14814814814815%}
.rg-soft-3{aspect-ratio:400/525;background-size:313.5% 238.8571428571429%;background-position:2.3419203747072603% 89.16323731138546%}
.rg-soft-4{aspect-ratio:407/530;background-size:308.1081081081081% 236.60377358490567%;background-position:50.76741440377804% 89.08839779005525%}
.rg-soft-5{aspect-ratio:385/510;background-size:325.7142857142857% 245.8823529411765%;background-position:97.81357882623706% 88.70967741935483%}
.rg-soft-1{clip-path:polygon(0 0,100% 0,100% 65%,95% 65%,95% 100%,0 100%)}.rg-soft-2{clip-path:polygon(8% 0,100% 0,100% 100%,0 100%,0 60%,8% 60%)}

/* Local v44: light is attached to placed sources and receiving room surfaces. */
.rg-contact-shadow{position:absolute;height:1.4%;transform:translate(-50%,-50%) skewX(-18deg);background:radial-gradient(ellipse,#24132c99,transparent 72%);filter:blur(1.2px);z-index:2;pointer-events:none}
.rg-surface-light{position:absolute;inset:0;z-index:2;pointer-events:none;mix-blend-mode:screen}
.rg-surface-light i{position:absolute;display:block;opacity:0}
.rg-lamp-wall{left:calc(var(--lx) - 31%);top:calc(var(--ly) - 28%);width:69%;height:55%;background:radial-gradient(ellipse at 45% 48%,#ffbe6299,#ffb84d38 35%,transparent 71%)}
.rg-lamp-core{left:calc(var(--lx) - 13%);top:calc(var(--ly) - 12%);width:26%;height:23%;background:radial-gradient(ellipse,#fff1bdbb 0%,#ffd47766 16%,#ffae3d16 48%,transparent 70%)}
.rg-ledge-reflection{left:0;top:43.5%;width:50%;height:3%;transform:rotate(4deg);background:radial-gradient(ellipse at 33% 50%,#ffdf9ab0,#ffc66c55 38%,transparent 75%);filter:blur(1px)}
.rg-sofa-bounce{left:10%;top:51%;width:49%;height:23%;background:radial-gradient(ellipse at 26% 10%,#ffcc8570,#eeb26a20 50%,transparent 75%)}
.rg-table-bounce{left:-7%;top:68%;width:58%;height:16%;transform:rotate(3deg);background:radial-gradient(ellipse at 36% 50%,#ffd18e70,#eab46720 52%,transparent 73%)}
.lamp-on .rg-lamp-wall,.lamp-on .rg-lamp-core,.lamp-on .rg-ledge-reflection,.lamp-on .rg-sofa-bounce,.lamp-on .rg-table-bounce{opacity:1}
.rg-candle-wall{left:-18%;top:34%;width:51%;height:43%;background:radial-gradient(ellipse at 50% 37%,#ffc66c7a,#ffc16a22 45%,transparent 72%)}
.candle-on .rg-candle-wall{opacity:1}
.rg-lantern-wall{right:-10%;top:-11%;width:56%;height:54%;background:radial-gradient(ellipse at 69% 35%,#ffe0a77a,#edb56b28 49%,transparent 72%)}
.lantern-on .rg-lantern-wall{opacity:1}
.rg-floor-bounce{left:-8%;bottom:-5%;width:63%;height:21%;transform:rotate(-9deg);background:radial-gradient(ellipse,#fbd59169,#f6be6a18 52%,transparent 73%)}
.lantern-on .rg-floor-bounce{opacity:.85}
.rg-crystal-reflection{left:25%;top:63%;width:36%;height:19%;background:radial-gradient(ellipse,#c7b3ff70,#c7b3ff18 45%,transparent 72%)}
.crystal-on .rg-crystal-reflection{opacity:1}
.rg-star-ceiling{left:4%;top:-7%;width:72%;height:34%;background:radial-gradient(ellipse,#ffdea754,#d8c3ff20 50%,transparent 73%)}
.stars-on .rg-star-ceiling{opacity:1}
.rg-firstlight-reveal .lamp-on i{animation:rg-light-spread 1.8s cubic-bezier(.2,.55,.3,1) both}
.rg-firstlight-reveal .rg-ledge-reflection{animation-delay:.18s}.rg-firstlight-reveal .rg-sofa-bounce{animation-delay:.32s}.rg-firstlight-reveal .rg-table-bounce{animation-delay:.42s}
.rg-lit .rg-object{filter:drop-shadow(2px 4px 3px #24132c78)}
.rg-lit .rg-object-0{filter:drop-shadow(0 0 8px #ffe4a9) drop-shadow(0 0 18px #ffc563aa) brightness(1.12)}
.rg-object-4,.rg-object-7{filter:drop-shadow(0 0 6px #ffce7b88) drop-shadow(2px 4px 3px #24132c99)!important}
.rg-object-9{filter:drop-shadow(0 0 5px #c3a5fa88) drop-shadow(2px 4px 3px #24132c99)!important}
.rg-cushions{width:25%;left:9%;top:56%}.rg-vase{width:14%;left:24%;top:33%}.rg-tea{width:19%;left:25%;top:70%}
.rg-flowers{width:26%;left:-6%;top:0}.rg-curtains{width:42%;height:auto;left:-7%;top:2%;z-index:1}.rg-porch{width:23%;right:-10%;top:27%}
.rg-stars{width:32%;height:auto;left:35%;top:-7%;z-index:2;animation:none}
.rg-object-8{transform:translate(-50%,-50%) scaleY(.44);z-index:1;filter:drop-shadow(0 4px 2px #17102099)}
.rg-arriving .collection-art{animation:rg-place-settle .7s cubic-bezier(.18,.68,.25,1) both}
.rg-soft-arriving{animation:rg-soft-settle 1s ease-out both}
@keyframes rg-place-settle{from{opacity:0;transform:translateY(-12%) scale(.94)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes rg-soft-settle{from{opacity:0;translate:0 -6px}to{opacity:1;translate:0 0}}
@keyframes rg-light-spread{from{opacity:0}to{opacity:1}}
.rg-canvas .rg-soft.rg-vase{left:25%;top:33%;width:13%}
.rg-canvas .rg-soft.rg-tea{left:23%;top:71%;width:17%}
.rg-canvas .rg-soft.rg-cushions{left:9%;top:54%;width:24%}
.rg-journey-layer{position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden}
.rg-journey-layer i{position:absolute;display:block}
.rg-journey-1 .rg-journey-window{left:8%;top:12%;width:43%;height:46%;background:radial-gradient(ellipse at 45% 35%,#7ecb9a77,transparent 70%);mix-blend-mode:screen}
.rg-journey-1 .rg-journey-garland{left:-2%;top:9%;width:30%;height:42%;border:7px solid #80a965aa;border-right:0;border-bottom:0;border-radius:62% 0 0 0;filter:drop-shadow(0 2px 4px #30452f)}
.rg-journey-1 .rg-journey-floor{left:2%;top:76%;width:38%;height:9%;background:radial-gradient(ellipse,#a8d38477,transparent 70%)}
.rg-journey-2 .rg-journey-window{left:8%;top:10%;width:48%;height:50%;background:radial-gradient(ellipse at 45% 35%,#65c9f29c,#5f9fdf33 50%,transparent 78%);mix-blend-mode:screen}
.rg-journey-2 .rg-journey-floor{left:0;top:75%;width:55%;height:18%;border-radius:50%;background:repeating-radial-gradient(ellipse at 45% 55%,transparent 0 15px,#9ae6ef77 17px 19px,transparent 21px 34px);transform:rotate(-9deg);opacity:.8}
.rg-journey-2 .rg-journey-garland{left:6%;top:5%;width:44%;height:8%;border-top:3px dotted #c4eeffad;border-radius:50%;filter:drop-shadow(0 0 6px #b5eaff)}
.rg-journey-3 .rg-journey-window{left:5%;top:9%;width:55%;height:56%;background:radial-gradient(ellipse at 46% 32%,#ffe6abbb,#d7acff44 42%,transparent 76%);mix-blend-mode:screen}
.rg-journey-3 .rg-journey-floor{left:0;top:70%;width:60%;height:24%;background:radial-gradient(ellipse,#ffe1a789,#c19bed33 56%,transparent 78%);mix-blend-mode:screen}
.rg-journey-3 .rg-journey-garland{left:8%;top:7%;width:47%;height:16%;border-top:4px solid #f9d99c;border-radius:50%;box-shadow:0 -6px 12px #fbe3a977;transform:rotate(-9deg)}
.rg-journey-emblem{left:20%;top:26%;width:17%;aspect-ratio:1;border-radius:50%;border:3px solid #f2ddb7;background:radial-gradient(circle at 45% 35%,#fff2cb,#9cc484 56%,#3e6a5d);box-shadow:0 0 0 4px #543f5a88,0 0 16px #b7e4a8,2px 7px 7px #282437aa;transform:rotate(-12deg)}
.rg-journey-emblem:before{content:'';position:absolute;left:48%;bottom:100%;height:80px;border-left:2px solid #ead9b4}
.rg-journey-emblem:after{content:'';position:absolute;left:28%;top:25%;width:44%;height:48%;background:#ecf6d2;clip-path:polygon(0 80%,48% 0,100% 15%,65% 100%);filter:drop-shadow(0 0 4px white)}
.rg-journey-2 .rg-journey-emblem{background:radial-gradient(circle at 40% 35%,#e8fbff,#75c7df 52%,#37618e);box-shadow:0 0 0 4px #435676aa,0 0 20px #9ce6f4,2px 7px 7px #202c4aaa}
.rg-journey-2 .rg-journey-emblem:after{background:#e9fbff;clip-path:polygon(50% 0,80% 40%,100% 68%,76% 100%,22% 100%,0 68%,20% 40%)}
.rg-journey-3 .rg-journey-emblem{background:radial-gradient(circle at 40% 30%,#fff9d6,#f2bf6f 55%,#8d568b);box-shadow:0 0 0 4px #6e4e75aa,0 0 23px #ffe5a4,2px 7px 7px #322448aa}
.rg-journey-3 .rg-journey-emblem:after{background:#fff0c4;clip-path:polygon(50% 0,61% 37%,100% 38%,69% 60%,80% 100%,50% 76%,20% 100%,31% 60%,0 38%,39% 37%)}
.rg-theme-3 .rg-object-2{filter:drop-shadow(0 0 9px #ffe5bd) drop-shadow(0 4px 3px #24132c)}
.rg-theme-3 .rg-stars{filter:drop-shadow(0 0 8px #f5dcac)}
.rg-tools:has([data-action=rgTheme]){left:8px;right:8px;justify-content:flex-end}
.rg-tools [data-action=rgTheme]{font-size:10px;white-space:nowrap}
@media(max-width:340px){.rg-tools:has([data-action=rgTheme]){top:69px;gap:3px}.rg-tools:has([data-action=rgTheme]) button{min-width:0;padding:3px 6px;font-size:9px}}
.room-theme-unlock{padding:10px 12px;border:1px solid #e9d29b88;border-radius:12px;background:#493b65;color:#ffe8b9;font:13px/1.6 system-ui}

/* Reuse the existing room toolbar and speech area on small screens. */
.rg-tools .daily-note-new{border-color:#f2d699;color:#fff0c8}.daily-note-new:after{content:' · 新';font-size:9px;color:#f8d48c}
.room-note{padding:18px 16px 14px;border:1px solid #d8b985;border-radius:16px;background:linear-gradient(135deg,#f9edce,#e9d8b8);color:#553d5a;text-align:left;box-shadow:inset 0 0 0 5px #fff6dd55}
.room-note>small{font:11px/1.6 system-ui;color:#856c80}.room-note h2{font:25px/1.5 Georgia,'Songti SC',serif!important;color:#66466c!important;margin:14px 0!important}.room-note>p{font:16px/2 Georgia,'Songti SC',serif!important;color:#624d63!important;margin:8px 0 20px!important}.room-note-sign{display:block;text-align:right;color:#8b658d;font-size:17px}
.room-note-history{margin-top:15px;text-align:left}.room-note-history summary{padding:12px 0;cursor:pointer;font-size:13px}.room-note-history article{padding:12px;border-top:1px solid #d5b69155}.room-note-history small,.room-note-history b{display:block;margin-bottom:5px}.room-note-history p{font-size:13px!important;line-height:1.8!important}
.forest-wish-card{display:flex;align-items:center;gap:10px;width:100%;margin:10px 0;padding:10px;border:1px solid #d8bb8799;border-radius:16px;background:linear-gradient(110deg,#3b364c,#343e3b);color:#ffe8ba;text-align:left}.forest-wish-card>.collection-art{width:52px;height:52px;flex:none}.forest-wish-card>span{flex:1;min-width:0}.forest-wish-card small,.forest-wish-card b,.forest-wish-card span>span{display:block}.forest-wish-card small{font:10px/1.6 system-ui;color:#d5c3d9}.forest-wish-card b{font:14px/1.7 Georgia,'Songti SC',serif}.forest-wish-card span>span{font:11px/1.6 system-ui;color:#ecd8ae}.forest-wish-card i{font:25px Georgia}
.forest-letter>.collection-art{width:100px;height:100px;margin:8px auto}.forest-letter p{text-align:left;font-size:14px;line-height:1.9}.forest-wish-effect{padding:10px;border:1px solid #d7bc8b66;border-radius:12px}.rg-wish .forest-wish-link{display:block;padding:3px 0;color:#f0d397;background:none;border:0;font:10px/1.4 system-ui;text-align:left;min-height:27px}
.wish-chime{position:absolute;left:53%;top:19%;width:11%;min-width:32px;min-height:54px;padding:22px 0 0;background:none;border:0;pointer-events:auto;cursor:pointer;transform-origin:50% 0;filter:drop-shadow(0 2px 4px #291632aa);z-index:4}.wish-chime:before{content:'';position:absolute;top:0;left:50%;width:1px;height:28px;background:#f5d899}.wish-chime>.lobby-icon{width:100%;height:auto;display:block}.wish-chime:after{content:'✧';position:absolute;left:40%;top:95%;color:#ffeab9;font-size:14px}.chime-playing{animation:chime-swing 1.5s ease-out}
.rg-cat-react .rg-cat-hotspot:after{content:'呼噜…';position:absolute;top:-18px;left:15%;font:12px/1.4 Georgia;color:#ffe8be;text-shadow:0 1px 4px #281633;animation:rg-note 2.3s ease-out both;pointer-events:none}
.room-decor .wish-chime:focus-visible{outline:2px solid #ffe7ae;border-radius:12px}
@keyframes chime-swing{0%,100%{transform:rotate(0)}20%{transform:rotate(12deg)}45%{transform:rotate(-9deg)}70%{transform:rotate(5deg)}}
@media(max-height:620px){.rg-wish .forest-wish-link{font-size:9px;min-height:22px}.room-note{padding:12px}.room-note>p{font-size:14px!important;line-height:1.8!important}}
.reduced .chime-playing{animation:none!important}@media(prefers-reduced-motion:reduce){.chime-playing{animation:none!important}}
.rg-cat-hotspot i{position:absolute;display:block;opacity:0;pointer-events:none;filter:drop-shadow(0 2px 3px #554057)}
.rg-cat-motion-tail{right:5%;bottom:14%;width:32%;height:45%;border:5px solid #f7eae8;border-left:0;border-top:0;border-radius:0 0 80% 0;transform-origin:20% 80%}
.rg-cat-motion-ears{left:26%;top:9%;width:20%;height:19%;background:#f8ecea;clip-path:polygon(0 100%,20% 0,48% 65%,75% 4%,100% 100%)}
.rg-cat-motion-paws{left:28%;bottom:16%;width:34%;height:15%;background:radial-gradient(ellipse at 25% 50%,#f8edeb 0 30%,transparent 34%),radial-gradient(ellipse at 75% 50%,#f8edeb 0 30%,transparent 34%)}
.rg-cat-tail .rg-cat-motion-tail{animation:rg-cat-tail 1.1s ease-in-out 2}
.rg-cat-ears .rg-cat-motion-ears{animation:rg-cat-ears .9s ease-out 2}
.rg-cat-roll .rg-cat-motion-paws{animation:rg-cat-paws 1.2s ease-in-out 2}
@keyframes rg-cat-tail{0%,100%{opacity:0;transform:rotate(-18deg)}25%,70%{opacity:.95}50%{transform:rotate(18deg)}}
@keyframes rg-cat-ears{0%,100%{opacity:0;transform:translateY(5px)}35%,70%{opacity:.95;transform:translateY(-3px)}}
@keyframes rg-cat-paws{0%,100%{opacity:0;transform:rotate(-10deg)}30%,75%{opacity:.95}55%{transform:rotate(18deg)}}
.reduced .rg-cat-hotspot i{animation:none!important}@media(prefers-reduced-motion:reduce){.rg-cat-hotspot i{animation:none!important}}

.journey-postcard-art{position:relative;display:inline-flex;flex:none;width:66px;height:80px;align-items:flex-end;justify-content:center;border:2px solid #e8ce9b;border-radius:5px;background-size:cover;background-position:center;box-shadow:0 3px 12px #120b1e55;overflow:hidden}
.postcard-scene-0{background-image:var(--world-cloud)}.postcard-scene-1{background-image:var(--world-forest)}.postcard-scene-2{background-image:var(--world-sea)}
.journey-postcard-art i{font-style:normal;font-size:24px;line-height:1.5;color:#ffe8af;text-shadow:0 1px 6px #241131}
.postcard-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.postcard-grid button{display:flex;flex-direction:column;align-items:center;gap:7px;padding:14px 8px;color:#f7e7c5;background:#70516b33;border:1px solid #d4b78c66;border-radius:14px}.postcard-grid b{font-size:14px}.postcard-grid small{font-size:11px;color:#d8c5dc}.postcard-locked .journey-postcard-art{filter:saturate(.35);opacity:.65}
.postcard-letter{text-align:left}.postcard-letter>.journey-postcard-art{display:flex;width:100%;height:160px;margin-bottom:16px;background-position:center 40%}.postcard-letter>small{color:#dfc5ad}.postcard-letter>p{line-height:1.9}.postcard-letter>span{display:block;text-align:right;margin:12px 0 22px}
.world-reward-reveal>.journey-postcard-art{width:106px;height:128px;margin:8px auto}.stage-progress .journey-postcard-art,.rg-prize .journey-postcard-art{width:48px;height:60px}.world-map-reward>.journey-postcard-art{width:46px;height:56px}
.world-map-3 .world-scene{background-image:var(--world-cloud)}.world-map-4 .world-scene{background-image:var(--world-forest)}.world-map-5 .world-scene{background-image:var(--world-sea)}
.release-build-label{font-size:12px;line-height:1.6;color:#dfc7a2;text-align:center;margin:10px 0 16px}
.journey-ending{text-align:center}.journey-ending>.result-small-art{margin:0 auto 16px}.journey-ending>small{color:#dec5a5;font-size:12px}.journey-ending h2,.journey-finale h1{color:#ffe5a8;letter-spacing:4px}.journey-ending blockquote,.journey-ending-quote{margin:16px 0;padding:14px 16px;border-left:2px solid #d8b67d;background:#7e5e811c;border-radius:0 12px 12px 0;text-align:left;font-size:14px;line-height:1.9;color:#f2dfd2}.journey-ending blockquote span,.journey-ending-quote span{display:block;margin-top:8px;text-align:right;color:#d5bcda;font-size:12px}.journey-ending-actions{display:grid;gap:10px}.journey-ending-actions>button{width:100%;min-height:44px;white-space:normal}.journey-finale .result-actions>button{white-space:normal}
/* Former stamina components must never occupy space in this free-play release. */
.lobby-stamina,.stamina-card,.stamina-pill,.stamina-panel,[data-action="staminaInfo"]{display:none!important}
/* Approved global currency art: front-facing star coin and B moon-drop crystal. */
.prop-art.prop-coin>i,.prop-art.prop-diamond>i{left:0;top:0;width:100%;height:100%;background-size:contain;background-position:center;background-repeat:no-repeat}
.prop-art.prop-coin>i{background-image:var(--currency-coin)}
.prop-art.prop-diamond>i{background-image:var(--currency-diamond)}

/* v27: controls remain reachable in short mobile WebViews. */
body[data-screen=game] .top{height:48px;padding:2px 10px}
body[data-screen=game] .top-right{gap:4px}
body[data-screen=game] .top-right .icon-btn{width:44px;height:44px;min-height:44px}
body[data-screen=game] #trialExit{font:11px system-ui;min-width:74px;min-height:44px;padding:5px 9px;border:1px solid #d4b58999;border-radius:13px;background:#342840;color:#ffe4b5;touch-action:manipulation}
body[data-screen=game] .game{gap:5px;padding:6px 8px 8px}
body[data-screen=game] .coach:not([hidden]){display:flex;max-height:none;overflow:visible;padding:6px 8px;gap:8px;align-items:center}
body[data-screen=game] .coach .lesson-copy{flex:1;min-width:0}
body[data-screen=game] .coach .lesson-copy>small{display:block;color:#efd2a4;font:10px/1.4 system-ui;margin-bottom:2px}
body[data-screen=game] .coach p{font:11px/1.5 system-ui;overflow-wrap:anywhere}
.lesson-skip{flex:none;min-width:54px;min-height:44px;padding:4px 6px;border:1px solid #d3b68b66;border-radius:10px;background:#302339;color:#e5cfdc;font:10px system-ui;touch-action:manipulation}
.lesson-skip:disabled{opacity:.5}
body[data-screen=game] .element-panel{display:flex!important;min-height:14px;max-height:30px;overflow:hidden}
body[data-screen=game] .element-panel>span{font:9px/1.4 system-ui;display:block;min-width:0}
body[data-screen=game] .tool-row{display:flex;gap:5px;align-items:stretch;min-height:44px}
body[data-screen=game] .tool{flex:1;min-width:0;min-height:44px;font-size:11px;padding:5px 2px;touch-action:manipulation}
body[data-screen=game] .tool b{font-size:9px;margin-left:2px}
body[data-screen=game] .skill-box{padding:5px 8px;min-height:54px}
body[data-screen=game] .skill-btn{min-height:44px;min-width:58px;padding:6px 8px;touch-action:manipulation}
body[data-screen=game] .skill-avatar{width:44px;height:44px;min-width:44px}
body[data-screen=game] #mirrorPicker{flex:0 0 76px;min-width:0;display:flex;align-items:center;gap:3px;padding:0 3px;border:1px solid #b594b966;border-radius:10px;background:#362843;color:#f0dcc3}
#mirrorPicker>span{width:20px;font:9px/1.2 system-ui}
#mirrorElement{width:46px;min-height:44px;padding:2px 0;color:#ffe6bb;background:#362843;border:0;font:13px system-ui;border-radius:8px}
.tile.lesson-target{outline:2px solid #fff1a8;outline-offset:-3px;box-shadow:inset 0 0 10px #ffe0a180;z-index:3;animation:lesson-glow 1.4s ease-in-out infinite alternate}
.lesson-skill{outline:2px solid #ffe9a2;outline-offset:1px;animation:lesson-glow 1.4s ease-in-out infinite alternate}
@keyframes lesson-glow{from{filter:brightness(1)}to{filter:brightness(1.28)}}
.first-light-menu{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0 5px}
.first-light-menu button{display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:90px;gap:5px;margin:0;font:13px system-ui}
.first-light-menu .lobby-icon{width:40px;height:40px}
.first-light-home .lobby-left-rail .collection-art{width:48px;height:48px}
.first-light-home .world-task .collection-art{width:48px;height:48px;flex:none}
.first-light-home .world-task strong{font-size:15px}
.prep-companion{display:flex;align-items:center;gap:10px;padding:10px 8px;margin:6px 0;border:1px solid #d2b49355;border-radius:13px;background:#392a4566;text-align:left}
.prep-companion .portrait-art{width:48px!important;height:48px!important;min-width:48px;flex:none;border-radius:12px}
.prep-companion b{font:12px/1.5 system-ui;color:#f7dcaf}
.prep-companion p{font:11px/1.5 system-ui!important;margin:3px 0 0!important;color:#dac5dc}
.prep-help summary{min-height:44px;box-sizing:border-box;padding:8px 0;touch-action:manipulation}
.prep-sheet .prep-shop-link,.prep-warning .text-button{min-height:44px}
.first-light-prep .prep-scroll{padding-top:12px}
.first-light-prep .prep-help{margin-bottom:0}
body .dialog[data-skin=daily]{position:relative;padding:0;overflow:hidden;display:flex;flex-direction:column;height:min(640px,calc(var(--game-vh,100dvh) - 24px));max-height:100%}
body .dialog[data-skin=daily]>.dialog-corner-close{position:absolute;right:10px;top:10px;margin:0}
.daily-sheet{display:flex;flex-direction:column;min-height:0;flex:1;overflow:hidden;width:100%}
.daily-sheet .daily-heading{flex:none;padding:15px 58px 8px 16px;text-align:left}
.daily-sheet .daily-heading>small{font-size:8px;letter-spacing:2px}
.daily-sheet .daily-heading h2{font-size:21px!important;margin:4px 0 0!important;line-height:1.3}
.daily-today{display:flex;align-items:center;gap:10px;flex:none;margin:0 13px 9px;padding:8px 10px;border:1px solid #ddc48e88;border-radius:14px;background:linear-gradient(110deg,#77577255,#30203a88);text-align:left}
.daily-today-art>.prop-art{width:50px;height:58px;flex:none}
.daily-today>div:last-child{min-width:0;flex:1;display:grid;gap:4px}
.daily-today small{font:10px system-ui;color:#e6c696}
.daily-today strong{font:14px/1.5 system-ui;color:#ffe8bb;overflow-wrap:anywhere}
.daily-today span{font:10px/1.5 system-ui;color:#ddc8df}
.daily-scroll{min-height:0;flex:1;overflow-y:auto;overscroll-behavior:contain;padding:8px 12px 18px;scrollbar-width:thin}
.daily-sheet .daily-book{padding:10px 7px 13px}
.daily-sheet .daily-grid{gap:8px 12px}
.daily-sheet .daily-day{padding:7px 3px}
.daily-sheet .daily-treasures{height:49px}
.daily-sheet .daily-treasures .prop-art{width:49px;height:49px;flex-basis:49px}
.daily-sheet .daily-day:last-child .daily-treasures{height:49px}
.daily-footer{flex:none;padding:9px 14px 10px;background:#291d34;border-top:1px solid #d1b78366;box-shadow:0 -5px 15px #150e2922}
.daily-footer>.primary{margin:0!important;width:100%;min-height:48px;padding:9px!important;font-size:15px!important}
.daily-footer p{font:10px/1.5 system-ui!important;color:#cdb6d1!important;margin:6px 0 0!important}
.rg-header>button{width:44px;height:44px}
.rg-tools button,.rg-preview-link,.rg-style-choice button,.rg-celebration button,.rg-arrange-grid .rg-store{min-height:44px;touch-action:manipulation}
.rg-tools{top:78px}
.rg-dock>.primary,.rg-dock-buttons button{min-height:44px!important;touch-action:manipulation}
.rg-await-light{min-width:44px;min-height:44px;filter:none!important;border-radius:16px;outline:1px solid #ffe4a4;outline-offset:3px;box-shadow:0 0 15px #edc77d44}
.rg-await-light>.collection-art{filter:brightness(.65) saturate(.65)}
.rg-light-hint{position:absolute;left:50%;top:100%;transform:translateX(-50%);padding:3px 7px;border:1px solid #e1c48e;border-radius:9px;background:#37273de8;color:#ffe7ae;font:10px/1.4 system-ui;white-space:nowrap}
.first-light-dock .rg-prize .collection-art{width:100%;height:100%}
.first-light-dock .rg-wish>div{display:grid;gap:3px}
@media(max-height:650px){body[data-screen=game] .game{gap:3px;padding:3px 7px 5px}body[data-screen=game] .level-head{display:none}body[data-screen=game] .coach:not([hidden]){padding:4px 6px}body[data-screen=game] .metric{padding:4px 7px}.rg-tools{top:70px}}
@media(max-height:500px){.daily-sheet .daily-heading{padding-top:11px;padding-bottom:5px}.daily-sheet .daily-heading>small{display:none}.daily-today{padding:4px 8px;margin-bottom:4px}.daily-today-art>.prop-art{width:38px;height:42px}.daily-today span{display:none}.daily-footer{padding:6px 12px}.daily-footer p{margin-top:3px!important}}
.reduced .lesson-target,.reduced .lesson-skill{animation:none!important}
@media(prefers-reduced-motion:reduce){.lesson-target,.lesson-skill{animation:none!important}}

/* Clear objectives without adding another tall battle panel. */
.tile.chapter-ice .tile-face{box-shadow:inset 0 0 8px #a5e7ff75;outline:1px solid #bbecffe0;outline-offset:-2px;border-radius:10px}
.tile .chapter-frost{position:absolute;inset:4%;border:2px solid #c6f3ffb8;border-radius:8px;background:linear-gradient(140deg,#cbf4ff45,transparent 28%,transparent 73%,#c1f4ff55);color:#e5ffff;font:11px/1 system-ui;text-align:left;padding:3px;pointer-events:none;z-index:5}
.tile.practice-target{outline:2px solid #ffedb6;outline-offset:-3px;box-shadow:inset 0 0 12px #ffd28b77}
body[data-screen=game] .target>span{white-space:normal;line-height:1.4;display:block;overflow-wrap:anywhere}
.chapter-brief{padding:8px 10px;margin:0 0 8px;border:1px solid #d5b88a55;border-radius:12px;text-align:left;background:#38274080}
.chapter-goals{display:flex;flex-wrap:wrap;gap:5px}
.chapter-goals>span{border:1px solid #a6d7ef55;color:#f6e1b9;padding:4px 7px;border-radius:8px;font:11px/1.4 system-ui;background:#2a253b}
.chapter-brief>p{font:11px/1.6 system-ui!important;margin:6px 0!important;color:#dbc9df}
.chapter-stars{display:block;font:10px/1.5 system-ui;color:#c6abc9;margin-top:6px}
.chapter-recommend{display:flex;align-items:center;gap:7px;margin-top:6px;padding-top:6px;border-top:1px solid #d6b88533}
.chapter-recommend .portrait-art{width:35px!important;height:35px!important;flex:none;border-radius:10px}
.chapter-recommend>div{flex:1;min-width:0}.chapter-recommend b{display:block;font:11px/1.4 system-ui;color:#f5deb1}.chapter-recommend small{display:block;font:10px/1.5 system-ui;color:#cbb8d4}
.chapter-recommend button{min-width:44px;min-height:44px;border:1px solid #d8ba8c77;border-radius:10px;background:#6c4d6977;color:#f9e2b2;font:11px system-ui}
.first-light-prep .chapter-brief{padding:5px 8px}.first-light-prep .chapter-brief>p{display:none}
.chapter-result-goals{display:flex;justify-content:center;flex-wrap:wrap;gap:7px;margin:10px 0}
.chapter-result-goals>span{font:12px system-ui;border:1px solid #d3b18b77;border-radius:10px;padding:7px 9px;background:#49314e66;color:#efd5bd}
.chapter-result-goals>.complete{border-color:#b8d5a888;color:#e0f1c7}
.chapter-failure{padding:12px;margin:12px 0;background:#3c2a4680;border:1px solid #d6b08a66;border-radius:15px;text-align:left}
.chapter-failure>b{font:13px/1.6 system-ui;color:#ffe3b3}.chapter-failure p{font:12px/1.7 system-ui;color:#d5bfd8;margin:6px 0 0}
.chapter-supply{font-size:12px;color:#f6dfb4}
.mio-invitation{display:grid;grid-template-columns:52px 1fr;gap:8px 10px;padding:12px;text-align:left;border:1px solid #9cd2df77;border-radius:16px;background:linear-gradient(120deg,#28516c66,#39294399);margin:12px 0}
.mio-invitation>.portrait-art{width:52px;height:68px!important;border-radius:18px 18px 10px 10px;grid-row:1/3}
.mio-invitation b{font:14px/1.5 system-ui;color:#f7dfb8}.mio-invitation p{font:11px/1.6 system-ui;color:#dac6da;margin:4px 0}.mio-invitation small{font:10px system-ui;color:#c6dae3}
.mio-invitation button{grid-column:2;min-height:44px;border:1px solid #d4bc91;border-radius:10px;background:#60506a;color:#ffe9bf;font:12px system-ui}
.partner-dock .partner-practice{display:block;width:100%;min-height:44px;border:1px solid #dcc79b77;background:#3c2b498c;border-radius:13px;color:#eddbbd;font:12px system-ui;margin:4px 0 7px}
.practice-portrait{width:76px;height:90px;margin:4px auto 12px;border:1px solid #e0bf87;border-radius:26px;overflow:hidden}.practice-portrait>.portrait-art{width:100%;height:100%}
/* Different arrangements reserve separate places for the first four gifts. */
.rg-cushions.rg-roomset-0{left:9%;top:54%;width:24%}.rg-cushions.rg-roomset-1{left:3%;top:58%;width:23%;transform:rotate(-6deg)}
.rg-vase.rg-roomset-0{left:43%;top:36%;width:10%}.rg-vase.rg-roomset-1{left:1%;top:35%;width:11%}
.rg-tea.rg-roomset-0{left:16%;top:78%;width:12%}.rg-tea.rg-roomset-1{left:16%;top:80%;width:14%;transform:rotate(-10deg)}
.rg-flowers.rg-roomset-0{left:-6%;top:0;width:33%}.rg-flowers.rg-roomset-1{left:auto;right:-5%;top:26%;width:29%;transform:scaleX(-1)}
.rg-object-2.rg-style-1:not(.rg-legacy-layout){transform:translate(-50%,-50%) rotate(-7deg);filter:drop-shadow(3px 5px 2px #160f2c88)}
.rg-firstlight-reveal .rg-warmth{animation:rg-welcome 1.5s ease-out both}
.rg-tools{gap:5px}.rg-tools button{font-size:10px;padding:4px 7px}
.room-event-dock .rg-prize>.collection-art{width:100%;height:100%}
.room-chapter-cards{display:grid;gap:10px;margin-top:14px}
.room-chapter-cards button{display:flex;align-items:center;gap:10px;min-height:85px;padding:10px;border:1px solid #c7aa8177;border-radius:15px;background:#68496630;text-align:left;color:#f7dfb3}
.room-chapter-cards .collection-art{width:54px;height:54px;flex:none}.room-chapter-cards b{display:block;font:13px/1.5 system-ui}.room-chapter-cards small,.room-chapter-cards span{display:block;font:10px/1.7 system-ui;color:#d0b8d2}
.room-event-memories{display:grid;gap:8px;margin:12px 0}.room-event-memories button{min-height:44px;padding:8px 12px;text-align:left;border:1px solid #d6bb9077;border-radius:12px;color:#f6deaf;background:#4d345466}
.room-story{position:absolute;z-index:25;inset:0;background:linear-gradient(#21162b55,transparent 26%,transparent 55%,#24142c88);display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:12px 12px 150px;box-sizing:border-box}
.room-story-skip{position:absolute;top:16px;right:12px;min-height:44px;min-width:84px;padding:6px 12px;background:#30233ee8;border:1px solid #ddc48f;border-radius:15px;color:#ffe7b4;font:11px system-ui}
.room-story-copy{max-width:360px;width:100%;padding:14px 16px;border:1px solid #ebd8b1;border-radius:18px;background:#f5e7d7f0;box-sizing:border-box;box-shadow:0 6px 24px #160f2a66;color:#5d3b59;animation:room-story-in .3s ease-out both}
.room-story-copy small{font:10px/1.5 system-ui;color:#88617d}.room-story-copy p{font:14px/1.8 Georgia,'Songti SC',serif;margin:6px 0 10px}
.room-story-dots{display:flex;gap:5px;justify-content:center}.room-story-dots i{width:14px;height:3px;border-radius:3px;background:#bea8be}.room-story-dots .done{background:#8d627d}
.room-visit-faces{position:relative;display:flex;align-items:center;justify-content:center;gap:9px;margin-bottom:18px;padding:12px;border-radius:18px;border:1px solid #edcda2;background:#36233cda}
.room-visit-faces>div{text-align:center}.room-visit-faces .portrait-art{width:46px;height:54px;display:block;border-radius:15px 15px 8px 8px}.room-visit-faces span:last-child{display:block;color:#f2d7b5;font:10px/1.5 system-ui;margin-top:4px}
.room-photo-flash{position:absolute;inset:0;background:#fff8ed;pointer-events:none;animation:room-shutter .6s ease-out both}
@keyframes room-shutter{from{opacity:.7}to{opacity:0}}@keyframes room-story-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@media(max-height:650px){.room-story{padding-bottom:140px}.room-story-copy{padding:10px 12px}.room-story-copy p{font-size:12px}.room-visit-faces{margin-bottom:10px}.chapter-brief{padding:6px 8px}}
@media(max-height:560px){.partner-dock .art-skill p{font-size:10px!important;line-height:1.5!important}.partner-dock .art-skill{padding:7px 10px}.partner-dock .partner-practice{margin:3px 0 4px}.room-visit-faces .portrait-art{width:38px;height:44px}}
.reduced .room-story *{animation:none!important}.reduced .room-photo-flash{display:none}
@media(prefers-reduced-motion:reduce){.room-story *{animation:none!important}.room-photo-flash{display:none}}

/* Stories advance at the reader's pace, including after app backgrounding. */
.room-story-next{display:block;width:100%;min-height:44px;margin-top:12px;padding:8px 12px;border:1px solid #b48f72;border-radius:12px;background:#fff4d8;color:#64405b;font:600 14px/1.5 system-ui;touch-action:manipulation}
.room-story-next:focus-visible{outline:3px solid #92698c;outline-offset:2px}

/* A four-panel comic with a single readable frame on small screens. */
body[data-screen=prologue] .top,body[data-screen=prologue] .edition-label{display:none}
body[data-screen=prologue] .screen{padding:0;overflow:hidden}
.prologue-page,.prologue-page *{box-sizing:border-box}
.prologue-page{height:100%;min-height:0;display:flex;flex-direction:column;overflow:hidden;position:relative;isolation:isolate;background:radial-gradient(ellipse at 15% 15%,#67506b55,transparent 55%),linear-gradient(145deg,#231b34,#151426 75%);color:#f8e7ce;font-family:Georgia,'Songti SC','Noto Serif SC',serif}
.prologue-page button{font:inherit;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;color:inherit}
.prologue-page button:focus-visible{outline:2px solid #f9e6b5;outline-offset:-3px}
.comic-header{flex:none;display:flex;align-items:center;gap:6px;padding:8px 12px 6px;padding-top:max(8px,env(safe-area-inset-top));min-height:57px;border-bottom:1px solid #ddbf8b28}
.comic-header>div{flex:1;min-width:0}.comic-header small{display:block;color:#bfa6c1;letter-spacing:2.5px;font:8px/1.4 system-ui}.comic-header b{font-size:16px;font-weight:400;line-height:1.6;letter-spacing:1px}
.comic-header button{flex:none;min-width:44px;min-height:44px;border:1px solid #dfc29555;border-radius:14px;padding:5px 11px;background:#58405b44;font-size:12px;color:#ead7b7}.comic-header button span{margin-left:2px;font-size:16px}
.comic-reading{flex:1;min-height:0;display:flex;flex-direction:column;padding:12px 14px 0;gap:11px}
.comic-image-wrap{flex:1;min-width:0;min-height:70px;position:relative;display:flex;justify-content:center;align-items:center;overflow:hidden}
.comic-art{height:100%;width:auto;max-width:100%;max-height:100%;aspect-ratio:1;position:relative;isolation:isolate;padding:0;border:1px solid #d6b78a;border-radius:5px 22px 5px 22px;overflow:hidden;background:#292135;box-shadow:0 9px 28px #0d081f66,inset 0 0 0 4px #e6d0a429;display:block}
/* A square sprite must have equal dimensions even when the viewport is narrow.
   Out-of-flow artwork keeps its size from feeding back into the flex layout. */
.comic-image-wrap>.comic-art{position:absolute;flex:none;width:var(--comic-side,0px);height:var(--comic-side,0px);max-width:none;max-height:none;min-width:0;min-height:0}
.comic-illustration{position:absolute;inset:0;display:block;background-image:var(--prologue-atlas);background-repeat:no-repeat;background-size:200% 200%;background-position:var(--comic-x) var(--comic-y);animation:comic-camera 13s ease-out both;transform-origin:50% 50%}
.comic-art-0{--comic-x:0%;--comic-y:0%}.comic-art-1{--comic-x:100%;--comic-y:0%}.comic-art-2{--comic-x:0%;--comic-y:100%}.comic-art-3{--comic-x:100%;--comic-y:100%}
.comic-art-1 .comic-illustration{transform-origin:48% 38%}.comic-art-2 .comic-illustration{transform-origin:35% 45%}
.comic-sheen{position:absolute;inset:0;pointer-events:none;border:5px solid #f7dca222;box-shadow:inset 0 -26px 28px #1c132c44;z-index:2}
.comic-panel-number{position:absolute;top:9px;left:9px;z-index:3;font:italic 14px/1 Georgia;color:#fff0d0;background:#352538b8;border:1px solid #e3cfa177;padding:8px;border-radius:50%}
.comic-mote{position:absolute;z-index:2;pointer-events:none;width:3px;height:3px;background:#ffe6af;border-radius:50%;box-shadow:0 0 8px 2px #f4cd9d88;animation:comic-star 5s ease-in-out infinite;opacity:0}
.mote-0{left:15%;top:70%;animation-delay:.2s}.mote-1{left:71%;top:35%;animation-delay:1.1s}.mote-2{left:40%;top:53%;animation-delay:2.3s}.mote-3{left:82%;top:77%;animation-delay:3.4s}.mote-4{left:23%;top:24%;animation-delay:4.1s}
.comic-copy{flex:none;position:relative;border-left:2px solid #d7bc90;padding:0 10px 0 12px;min-height:158px;max-height:45%;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin}
.comic-copy-heading small{font:10px/1.5 system-ui;letter-spacing:1px;color:#c5a8cc}.comic-copy h1{font-weight:400;font-size:21px;line-height:1.5;margin:3px 0 7px;color:#ffdfaa;outline:none}
.comic-dialogue{font:14px/1.85 system-ui;margin:0;color:#e8dbe9;white-space:pre-line;min-height:5.55em}
.comic-footer{flex:none;padding:1px 14px max(9px,env(safe-area-inset-bottom));background:linear-gradient(transparent,#171428 30%)}
.comic-progress{display:flex;justify-content:center;gap:2px;margin:0 auto 1px}
.comic-progress button{width:44px;min-height:44px;border:0;background:none;display:grid;place-items:center;padding:0}
.comic-progress button span{font:10px/1 system-ui;color:#bfa8c8;border-bottom:2px solid #7b5d7c;padding:5px 9px}.comic-progress [aria-current=step] span{border-color:#f5d5a1;color:#ffebc7}
.comic-actions{display:flex;gap:9px;align-items:stretch}.comic-prev{width:46px;flex:none;border:1px solid #b89e8377;background:#49354e66;border-radius:13px;font-size:24px!important;min-height:46px}.comic-prev:disabled{opacity:.35;cursor:default}
.comic-next{flex:1;display:flex;justify-content:center;align-items:center;gap:11px;min-height:46px;min-width:0;padding:9px 12px;border:1px solid #ffe9b5;border-radius:14px;background:linear-gradient(120deg,#f8e8bd,#e6c58b);box-shadow:inset 0 0 0 3px #fff8d533,0 3px #a37a59;color:#543443!important;font-size:15px!important;letter-spacing:.5px;font-weight:600!important}.comic-next>span{font-size:18px;font-weight:400}
.comic-reading-hint{display:block;margin-top:8px;text-align:center;font:9px/1.4 system-ui;color:#b39bbf}
.comic-grid{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;display:grid;grid-template-columns:1fr;gap:14px;padding:14px;align-content:start}
.comic-grid article{border:1px solid #ccb28a66;border-radius:5px 20px 5px 20px;overflow:hidden;background:#4a344144;min-width:0}
.comic-grid .comic-art{width:100%;height:auto;border:0;border-radius:0;box-shadow:none;aspect-ratio:1}.comic-grid .comic-illustration{animation:none;transform:none}
.comic-grid article>div{padding:12px}.comic-grid small{font:10px system-ui;color:#c9aed0}.comic-grid h2{font-size:19px;font-weight:400;line-height:1.6;color:#ffe0b0;margin:5px 0}.comic-grid p{font:13px/1.9 system-ui;color:#e4d3e5;white-space:pre-line;margin:0}
.comic-overview-footer{flex:none;padding:9px 14px max(10px,env(safe-area-inset-bottom));border-top:1px solid #c9aa7c33}.comic-overview-footer .comic-next{width:100%}
.prologue-replay{display:flex!important;gap:12px;align-items:center;text-align:left;width:100%;padding:12px!important;margin-top:14px!important;min-height:52px}
.prologue-replay>span:nth-child(2){flex:1}.prologue-replay small{display:block;font:10px/1.7 system-ui;color:#c5afce}
@keyframes comic-camera{from{transform:scale(1)}to{transform:scale(1.035)}}
@keyframes comic-star{0%,100%{opacity:0;transform:translateY(5px) scale(.5)}40%{opacity:.8}75%{opacity:0;transform:translateY(-22px) scale(1)}}
@media(max-height:650px){.comic-header{min-height:50px;padding-top:4px;padding-bottom:2px}.comic-reading{gap:7px;padding-top:8px}.comic-copy{min-height:135px;padding-left:10px}.comic-copy h1{font-size:18px;margin-bottom:4px}.comic-dialogue{font-size:12px;line-height:1.8}.comic-reading-hint{margin-top:6px}.comic-footer{padding-bottom:6px}.comic-progress button{min-height:40px}}
@media(max-width:350px){.comic-header b{font-size:14px}.comic-header button{padding:4px 8px}.comic-copy h1{font-size:18px}.comic-dialogue{font-size:13px}.comic-copy{min-height:153px}.comic-next{font-size:13px!important}.comic-reading{padding-inline:10px}.comic-footer{padding-inline:10px}}
@media(max-height:480px){.comic-reading{flex-direction:row;gap:10px;align-items:stretch}.comic-image-wrap{flex:1;min-width:0}.comic-copy{flex:1;min-width:0;min-height:0;max-height:100%;padding-left:8px}.comic-copy h1{font-size:16px}.comic-dialogue{font-size:11px;line-height:1.7}.comic-footer{padding-top:4px}.comic-progress{display:none}.comic-reading-hint{display:none}}
.comic-reduced *{animation:none!important;transition:none!important}.comic-reduced .comic-mote{display:none}
body[data-art-hidden=true] .prologue-page *{animation-play-state:paused!important}
.comic-paused *{animation-play-state:paused!important}
@media(prefers-reduced-motion:reduce){.prologue-page *{animation:none!important;transition:none!important}.comic-mote{display:none}}

.release-settings{display:grid;gap:8px;margin:14px 0}.release-settings button{margin:0!important;min-height:44px}.release-settings small{display:block;font-size:11px;opacity:.8;margin-top:3px}
.release-panel{display:flex;flex-direction:column;max-height:calc(var(--game-vh,100dvh) - 86px);text-align:left;min-height:0}.release-panel>header{padding:0 36px 12px 0;flex-shrink:0}.release-panel>header small{font-size:9px;letter-spacing:2px;color:#ccb3de}.release-panel h2{font-size:22px;margin:5px 0}.release-scroll{overflow:auto;overscroll-behavior:contain;min-height:0;padding:2px 3px 16px}.release-scroll p{font-size:13px;line-height:1.7;margin:10px 0}.release-scroll h3{font-size:16px;margin:18px 0 8px}.release-scroll button{width:100%;min-height:44px;margin:5px 0}.release-scroll button small{display:block;font-size:11px;line-height:1.6;margin-top:4px}.release-status{padding:14px;border:1px solid #e5c98366;border-radius:15px;background:#42314c}.release-status.issue{border-color:#ebaf75}.release-status small,.release-muted{font-size:11px!important;color:#d3bedf!important}.release-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.release-actions button{font-size:13px;padding:10px}.release-panel textarea{display:block;width:100%;box-sizing:border-box;min-height:130px;max-height:35vh;resize:vertical;border:1px solid #a88aaf;border-radius:12px;padding:12px;background:#21192f;color:#fff0d4;font:12px/1.5 ui-monospace,monospace;margin:12px 0}.release-file{display:block;border:1px dashed #c9ac78;padding:12px;border-radius:12px;font-size:13px}.release-file input{display:block;width:100%;margin-top:8px;color:#eadabf}.release-compare{display:grid;gap:10px}.release-compare>div{padding:12px;border:1px solid #ffffff22;border-radius:12px}.release-compare small{display:block;opacity:.7;margin-bottom:5px}.release-compare b{font-size:14px;line-height:1.7}.release-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;text-align:center}.release-stats span{padding:10px 4px;border:1px solid #ffffff22;border-radius:10px;font-size:11px}.release-stats b{display:block;font-size:22px;margin-top:5px}.release-events{font-size:11px;line-height:2;padding-left:22px;overflow-wrap:anywhere}.release-scroll summary{padding:12px;min-height:44px;box-sizing:border-box}.release-scroll #backupError{color:#ffd29c}.release-channel-note{padding:8px 12px;border-radius:10px;background:#21192f;color:#e6d1ef;font-size:11px!important;margin:8px 0!important}
#saveNotice{position:fixed;z-index:120;left:50%;transform:translateX(-50%);top:max(4px,env(safe-area-inset-top));width:calc(100% - 24px);max-width:480px;min-height:44px;border:1px solid #e7c28a;background:#38253f;color:#fff0c8;border-radius:12px;box-shadow:0 3px 14px #0008;font-size:12px;padding:8px 14px}#saveNotice[hidden]{display:none}
@media(max-height:600px){.release-panel{max-height:calc(var(--game-vh,100dvh) - 60px)}.release-panel h2{font-size:18px}.release-panel>header{padding-bottom:6px}}

.ad-supply-intro{text-align:center;padding:12px 4px 18px}.ad-supply-intro>small{letter-spacing:3px;font-size:10px;color:#e4c88f}.ad-supply-intro h3{margin:8px 0;font-size:21px}.ad-supply-intro p{font-size:13px;line-height:1.7;color:#d9cee6}.ad-review-status{display:inline-block;padding:5px 13px;border:1px solid #bda47566;border-radius:20px;font-size:12px;color:#f5dcaa}.ad-supply-grid{display:grid;gap:12px}.ad-supply-card{display:grid;grid-template-columns:62px minmax(0,1fr);gap:8px 12px;align-items:center;padding:14px;border:1px solid #c3a36b77;border-radius:19px;background:linear-gradient(130deg,#80608055,#231a32bb)}.ad-supply-icon{display:flex;align-items:center;justify-content:center;width:60px;height:62px}.ad-supply-icon .lobby-icon{width:54px!important;height:54px!important}.ad-supply-icon .stamina-bottle{width:38px;height:48px}.ad-supply-card h3{font-size:15px;margin:0 0 3px}.ad-supply-card strong{font-size:21px;color:#ffe5ab}.ad-supply-card p{font-size:12px;line-height:1.55;margin:4px 0;color:#ddd1e4}.ad-supply-card>button{grid-column:1/-1;min-height:40px;margin:4px 0 0!important;opacity:.7!important}.free-income,.ad-stamina-note{padding:14px;border:1px solid #bca77955;border-radius:16px;margin:12px 0}.free-income h3{font-size:16px;margin:0}.free-income p,.ad-stamina-note p{font-size:13px;line-height:1.7}.boutique-sheet .boutique-scroll{overscroll-behavior:contain}.boutique-sheet .shop-tabs{grid-template-columns:repeat(3,minmax(0,1fr))}.boutique-sheet .shop-tabs button{min-width:0;font-size:13px}.boutique-sheet .release-channel-note{font-size:12px;text-align:center}
.ad-supply-card>button:not(:disabled){opacity:1!important}.ad-supply-card>button:disabled{opacity:.55!important}.ad-supply-card small{color:#e9d6ae;font-size:12px}

.weekly-page{max-width:580px;margin:0 auto;padding:24px 18px 36px;display:grid;gap:16px;color:#f6e8cf}.weekly-page>small,.weekly-prep>small{letter-spacing:.24em;color:#d3b9de}.weekly-page h1{font-size:clamp(26px,6vw,38px);margin:0}.weekly-page h2{font-size:19px;margin:0 0 10px}.weekly-page p{margin:0;line-height:1.65}.weekly-score{display:grid;gap:8px;text-align:center;padding:24px;border:1px solid #c5a372;border-radius:24px;background:linear-gradient(135deg,#584365bb,#291e39dd)}.weekly-score strong{font-size:52px;color:#ffe6a7}.weekly-score span,.weekly-note{font-size:13px;color:#d1bdd9}.weekly-prizes{padding:18px;border:1px solid #8d7397;border-radius:18px;background:#392c4caa}.weekly-prizes p+p{margin-top:12px}.weekly-prizes b{color:#ffdda1}.weekly-rules{padding-left:20px;line-height:1.7}.weekly-rules li+li{margin-top:8px}.weekly-page button{min-height:48px}.weekly-prep{max-height:75vh;overflow-y:auto;padding-right:6px}.weekly-prep>.primary{position:sticky;bottom:0;width:100%;margin-top:12px}.weekly-page details{font-size:14px;line-height:1.7}.weekly-page [role=status]{min-height:3em}
</style>
</head>
<body>
<div class="app">
 <header class="top"><div class="brand"><button class="brand-mark" id="homeButton" aria-label="返回首页" style="border:0;font:inherit">✦</button><div>星糖物语<small>STAR CANDY · WISH COLLECTOR</small></div></div><div class="top-right"><button class="icon-btn" id="help" aria-label="玩法说明">?</button><button class="icon-btn" id="settings" aria-label="设置">⚙</button><button class="icon-btn" id="pause" aria-label="暂停游戏">Ⅱ</button></div></header>
 <main class="screen" id="screen"></main>
 <main class="main" id="gamePage" hidden>
  <aside class="story"><div class="eyebrow">A LITTLE MAGIC, A LITTLE JOY</div><h1>交换一颗星，<br><span>遇见小幸运。</span></h1><p>旅途不必匆忙。和你的 AI 伙伴一起，<br>把散落的星糖，变成闪闪发光的心愿。</p><div class="illustration"><div class="orbit"></div><div class="big-character" id="heroArt"></div><div class="floating f1" id="float1"></div><div class="floating f2" id="float2"></div><div class="floating f3" id="float3"></div></div><div class="story-note">选择陪伴你的伙伴 · 满能量时释放星愿共鸣</div><div class="companions" id="companions"></div></aside>
  <section class="game" aria-label="星愿消除">
   <div class="mode-tabs"><button id="storyMode" class="mode-tab active" aria-pressed="true">星愿旅途</button><button id="timeMode" class="mode-tab" aria-pressed="false">90 秒星光挑战</button></div>
   <div class="level-head"><div><h2 id="levelTitle">01 · 云朵花园</h2><small id="levelSubtitle">交换相邻星糖，连接三个同色图案</small></div><button class="map-btn" id="map">关卡地图 ↗</button></div>
   <div class="hud"><div class="metric"><span>本局星光</span><strong id="score">0</strong></div><div class="metric target"><span id="targetLabel">心愿目标</span><strong id="targetText">0 / 1,800</strong><div class="progress"><i id="goalBar"></i></div></div><div class="metric moves"><span id="movesLabel">剩余步数</span><strong id="moves">22</strong></div></div>
   <div id="coach" class="coach" hidden role="status"></div>
   <div class="board-shell" id="boardShell"><div id="board" class="board" role="group" aria-label="七乘七星糖棋盘"></div></div>
   <div class="board-caption" id="caption" aria-live="polite">四连造直线，五连造彩虹，T / L 形造爆炸</div>
   <div class="tool-row"><button class="tool" id="hint">✧ 提示 <b>免费</b></button><button class="tool" id="hammer">♢ 星锤 <b id="hammerCount">2</b></button><button class="tool" id="shuffle">⟳ 重排 <b id="shuffleCount">1</b></button></div>
   <div class="skill-box"><button id="partner" class="skill-avatar icon-btn" aria-label="选择伙伴"></button><div class="skill-info"><strong id="partnerName">月见 · 星愿共鸣</strong><small id="energyText">消除 40 颗星糖，为伙伴充能</small><div class="progress"><i id="energyBar"></i></div></div><button class="skill-btn" id="skill">共鸣</button></div>
  </section>
 </main>
 <nav class="bottom-nav" id="pageNav" aria-label="主导航"><button data-route="home"><b>⌂</b>首页</button><button data-route="map"><b>♧</b>旅途</button><button data-route="partners"><b>♡</b>伙伴</button><button data-route="records"><b>✧</b>收藏</button></nav>
 <footer class="footer"><span id="record">星愿旅途 · 每一步都算数</span><span>不赶路，去感受路。✦</span></footer>
</div>
<div class="veil" id="veil" hidden><section class="dialog" id="dialog" role="dialog" aria-modal="true" aria-labelledby="dialogTitle"></section></div>
<div class="toast" id="toast" role="status"></div>
<script id="engine">

class CandyEngine {
  constructor(rng=Math.random){this.n=7;this.rng=rng;this.serial=0;this.cells=[];this.pool=[0,1,2,3,4,5];this.generate();}
  cell(k,s=''){return {id:++this.serial,k,s};}
  swap(a,b){[this.cells[a],this.cells[b]]=[this.cells[b],this.cells[a]];}
  adjacent(a,b){return a>=0&&b>=0&&a<49&&b<49&&Math.abs(Math.floor(a/7)-Math.floor(b/7))+Math.abs(a%7-b%7)===1;}
  runs(){
    const groups=[];
    for(let axis=0;axis<2;axis++)for(let line=0;line<7;line++){
      let seq=[];
      const flush=()=>{if(seq.length>=3)groups.push({ids:[...seq],axis:axis?'col':'row'});};
      for(let p=0;p<=7;p++){
        const i=axis?p*7+line:line*7+p,cell=p<7?this.cells[i]:null;
        if(seq.length&&(!cell||cell.s==='rainbow'||cell.k!==this.cells[seq[0]].k)){flush();seq=[];}
        if(cell&&cell.s!=='rainbow')seq.push(i);
      }
    }
    return groups;
  }
  legalMoves(limit=Infinity){
    const moves=[];
    for(let a=0;a<49;a++)for(const b of [a%7<6?a+1:-1,a<42?a+7:-1]){
      if(b<0)continue;
      const x=this.cells[a],y=this.cells[b];if(!x||!y)continue;
      let yes=x.s==='rainbow'||y.s==='rainbow'||(x.s&&y.s);
      if(!yes&&x.k!==y.k){this.swap(a,b);yes=this.runs().length>0;this.swap(a,b);}
      if(yes){moves.push([a,b]);if(moves.length>=limit)return moves;}
    }return moves;
  }
  move(){return this.legalMoves(1)[0]||null;}
  boardChoices(){
    const moves=this.legalMoves(),regions=new Set();
    // A move belongs to its midpoint region, so one boundary swap cannot count twice.
    for(const [a,b] of moves){const row=(Math.floor(a/7)+Math.floor(b/7))/2,col=(a%7+b%7)/2;regions.add((row>=3.5?2:0)+(col>=3.5?1:0));}
    const target=this.pool.length<=4?6:this.pool.length===5?5:4;
    return {count:moves.length,regions:regions.size,ready:moves.length>=target&&regions.size>=3,rank:Math.min(moves.length,target)*10+regions.size};
  }
  fillRandomBoard(fixed=[]){
    const locked=new Map(fixed);this.cells=Array(49).fill(null);
    const colorAt=i=>this.cells[i]?.k??locked.get(i);
    for(let i=0;i<49;i++){
      const options=(locked.has(i)?[locked.get(i)]:this.pool).filter(k=>{
        if(!this.pool.includes(k))return false;
        // Look ahead to lesson locks as well as already-filled neighbours.
        for(const step of [1,7])for(let offset=-2;offset<=0;offset++){
          const start=i+offset*step,end=start+2*step;
          if(start<0||end>=49||(step===1&&Math.floor(start/7)!==Math.floor(end/7)))continue;
          if([start,start+step,end].every(p=>p===i||colorAt(p)===k))return false;
        }
        return true;
      });
      if(!options.length)return false;
      this.cells[i]=this.cell(options[Math.floor(this.rng()*options.length)]);
    }
    return true;
  }
  generate({fixed=[]}={}){
    let best=null,bestRank=-1;
    for(let attempt=0;attempt<96;attempt++){
      if(!this.fillRandomBoard(fixed))continue;
      const choice=this.boardChoices();
      if(choice.ready)return;
      if(choice.count&&choice.rank>bestRank){best=[...this.cells];bestRank=choice.rank;}
    }
    if(best){this.cells=best;return;}
    // Rare constrained/RNG fallback: plant local exchanges, never a patterned whole board.
    const [a,b]=this.pool,seeds=fixed.length?fixed:[[0,a],[1,a],[2,b],[9,a],[4,a],[5,a],[6,b],[13,a],[35,a],[36,a],[37,b],[44,a],[39,a],[40,a],[41,b],[48,a]];
    for(let attempt=0;attempt<96;attempt++)if(this.fillRandomBoard(seeds)&&this.move())return;
    throw new Error('暂时无法生成可玩的棋盘，请重新进入本关');
  }
  plan(preferred=[]){
    let clusters=[];
    for(const run of this.runs()){
      let cluster={ids:new Set(run.ids),runs:[run]};
      const remaining=[];
      for(const c of clusters){
        if([...c.ids].some(i=>cluster.ids.has(i))){c.ids.forEach(i=>cluster.ids.add(i));cluster.runs.push(...c.runs);}
        else remaining.push(c);
      }
      // A new run can bridge previously separate horizontal runs.
      let merged=true;
      while(merged){merged=false;for(let j=remaining.length-1;j>=0;j--)if([...remaining[j].ids].some(i=>cluster.ids.has(i))){remaining[j].ids.forEach(i=>cluster.ids.add(i));cluster.runs.push(...remaining[j].runs);remaining.splice(j,1);merged=true;}}
      clusters=[...remaining,cluster];
    }
    const clear=new Set(),creates=new Map();
    for(const c of clusters){
      c.ids.forEach(i=>clear.add(i));
      const longest=c.runs.reduce((a,b)=>a.ids.length>=b.ids.length?a:b);
      const s=longest.ids.length>=5?'rainbow':c.runs.some(r=>r.axis!==longest.axis)?'bomb':longest.ids.length===4?longest.axis:'';
      if(s){
        const candidates=[...preferred,...c.ids].filter(i=>c.ids.has(i)&&!this.cells[i].s);
        if(candidates.length){const at=candidates[0];creates.set(at,{k:this.cells[at].k,s});clear.delete(at);}
      }
    }
    const matches=this.runs().sort((a,b)=>Number(b.ids.some(i=>preferred.includes(i)))-Number(a.ids.some(i=>preferred.includes(i)))||this.cells[a.ids[0]].k-this.cells[b.ids[0]].k||a.ids[0]-b.ids[0]);
    return {clear,creates,matches};
  }
  specialSwap(a,b){
    const x=this.cells[a],y=this.cells[b],clear=new Set([a,b]);
    if(x.s!=='rainbow'&&y.s!=='rainbow'&&!(x.s&&y.s))return null;
    if(x.s==='rainbow'||y.s==='rainbow'){
      const other=x.s==='rainbow'?y:x;
      this.cells.forEach((c,i)=>{if(other.s==='rainbow'||c.k===other.k)clear.add(i);});
    }
    if(x.s==='bomb'&&y.s==='bomb')for(let r=0;r<7;r++)for(let c=0;c<7;c++)if(Math.abs(r-Math.floor(b/7))<=2&&Math.abs(c-b%7)<=2)clear.add(r*7+c);
    return {clear,creates:new Map(),rainbowColor:x.s==='rainbow'?y.k:y.s==='rainbow'?x.k:undefined};
  }
  expand(plan){
    const clear=new Set(plan.clear),queue=[...clear],seen=new Set();let triggered=0;
    const add=i=>{if(i>=0&&i<49&&!plan.creates.has(i)&&!clear.has(i)){clear.add(i);queue.push(i);}};
    for(let p=0;p<queue.length;p++){
      const i=queue[p],cell=this.cells[i];if(!cell||seen.has(i))continue;seen.add(i);
      if(cell.s)triggered++;
      const r=Math.floor(i/7),c=i%7;
      if(cell.s==='row')for(let x=0;x<7;x++)add(r*7+x);
      if(cell.s==='col')for(let y=0;y<7;y++)add(y*7+c);
      if(cell.s==='bomb')for(let y=Math.max(0,r-1);y<=Math.min(6,r+1);y++)for(let x=Math.max(0,c-1);x<=Math.min(6,c+1);x++)add(y*7+x);
      if(cell.s==='rainbow'){const counts=Array(7).fill(0);this.cells.forEach(t=>counts[t.k]++);const k=plan.rainbowColor===undefined?counts.indexOf(Math.max(...counts)):plan.rainbowColor;this.cells.forEach((t,j)=>{if(t.k===k)add(j);});}
    }return {clear,creates:plan.creates,triggered};
  }
  apply(plan){
    const removed=[...plan.clear].map(i=>this.cells[i]);
    plan.clear.forEach(i=>this.cells[i]=null);
    plan.creates.forEach((v,i)=>this.cells[i]=this.cell(v.k,v.s));
    for(let c=0;c<7;c++){
      const stack=[];for(let r=6;r>=0;r--)if(this.cells[r*7+c])stack.push(this.cells[r*7+c]);
      for(let r=6;r>=0;r--)this.cells[r*7+c]=stack[6-r]||this.cell(this.pool[Math.floor(this.rng()*this.pool.length)]);
    }return removed;
  }
  shuffle(){
    const saved=[...this.cells];let best=null,bestRank=-1;
    for(let attempt=0;attempt<150;attempt++){
      this.cells=[...saved];
      for(let i=48;i>0;i--){const j=Math.floor(this.rng()*(i+1));this.swap(i,j);}
      if(this.runs().length)continue;
      const choice=this.boardChoices();
      if(choice.ready)return;
      if(choice.count&&choice.rank>bestRank){best=[...this.cells];bestRank=choice.rank;}
    }
    if(best){this.cells=best;return;}
    this.generate();
  }
}

</script>
<script id="elementEffects">
(() => {
 'use strict';
 const elements=[['fire','火','焰','#ff935e'],['water','水','滴','#6edcfa'],['ice','冰','霜','#c6f5ff'],['lightning','雷','电','#d6a6ff'],['grass','草','芽','#b5e77a'],['wind','风','旋','#8af1d5'],['rock','岩','晶','#efcb7f']];
 const pairs={
  'fire+water':['steam','蒸腾','水雾从中心鼓起，再向左右散开。'],
  'fire+ice':['melt','融解','冰壳出现裂纹，化为温暖的光滴。'],
  'fire+lightning':['blast','爆裂','火雷聚成亮点，沿纵向冲开。'],
  'fire+grass':['burn','燃烧','火舌沿边缘升起，余烬缓缓落下。'],
  'water+ice':['dew','凝露','水光收拢成冰露，向邻格散出露珠。'],
  'water+lightning':['conduct','导电','电弧连接周围糖果，节点依次亮起。'],
  'water+grass':['bloom','绽芽','叶片舒展，中心形成一颗发光种子。'],
  'ice+lightning':['fracture','碎霜','冰晶向四个对角碎开，留下短电光。'],
  'lightning+grass':['grow','激生','绿色脉络向外生长，叶尖闪起电光。']
 };
 function reaction(a,b){if(a===b)return ['refresh','附着刷新','同元素只刷新附着，不播放爆炸。'];const ia=elements.findIndex(e=>e[0]===a),ib=elements.findIndex(e=>e[0]===b),key=ia<ib?a+'+'+b:b+'+'+a;if(pairs[key])return pairs[key];const other=a==='wind'||a==='rock'?b:a;if((a==='wind'||b==='wind')&&['fire','water','ice','lightning'].includes(other))return ['diffuse','元素扩散','气流卷起已有元素，送向相邻糖果。'];if((a==='rock'||b==='rock')&&['fire','water','ice','lightning'].includes(other))return ['crystal','元素结晶','碎片向中心汇聚，凝成一枚棱晶。'];return ['replace','附着替换','没有额外反应，旧附着淡出，新附着接替。'];}
 const css=`
 .ef-host{position:absolute;inset:0;pointer-events:none;z-index:9;border-radius:inherit;color:var(--ef-color);isolation:isolate}.ef-loop{position:absolute;inset:0;border:1.5px solid currentColor;border-radius:inherit;box-shadow:inset 0 0 10px color-mix(in srgb,currentColor 25%,transparent),0 0 7px color-mix(in srgb,currentColor 28%,transparent);animation:ef-breathe 2.5s ease-in-out infinite}.ef-loop:before,.ef-loop:after{content:'';position:absolute;pointer-events:none}.ef-label{position:absolute;right:-3px;top:-5px;min-width:17px;height:17px;border-radius:7px;background:#21172f;border:1px solid currentColor;font-size:10px;line-height:15px;text-align:center;color:var(--ef-color);box-shadow:0 2px 5px #10071a80}.ef-mote{position:absolute;left:50%;top:50%;width:5px;height:5px;background:currentColor;border-radius:50%;animation:ef-orbit 3s linear infinite;animation-delay:calc(var(--i)*-.55s)}
 .ef-host[data-element=fire] .ef-loop{border-top-color:transparent}.ef-host[data-element=fire] .ef-mote{border-radius:70% 5% 70% 30%;animation:ef-flame 1.8s ease-out infinite;animation-delay:calc(var(--i)*-.35s)}
 .ef-host[data-element=water] .ef-loop:before{inset:6%;border-bottom:3px solid currentColor;border-radius:40%;animation:ef-water 2.5s ease-in-out infinite}.ef-host[data-element=water] .ef-mote{opacity:.65;animation:ef-drop 3.5s ease-in-out infinite;animation-delay:calc(var(--i)*-.6s)}
 .ef-host[data-element=ice] .ef-loop{border-radius:15%;clip-path:polygon(0 0,100% 0,100% 100%,0 100%)}.ef-host[data-element=ice] .ef-mote{border-radius:0;width:8px;height:8px;clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);animation:ef-frost 2.8s ease-in-out infinite;animation-delay:calc(var(--i)*-.5s)}
 .ef-host[data-element=lightning] .ef-loop:after{inset:-3px;border:2px dashed currentColor;border-radius:inherit;clip-path:polygon(0 0,40% 0,20% 50%,90% 20%,100% 100%,0 100%);animation:ef-electric 2.4s steps(1) infinite}.ef-host[data-element=lightning] .ef-mote{width:3px;height:9px;transform:rotate(30deg);animation:ef-frost 2s infinite;animation-delay:calc(var(--i)*-.4s)}
 .ef-host[data-element=grass] .ef-loop{border:2px solid currentColor;border-top-color:transparent;border-left-color:transparent;border-radius:40% 15% 35% 20%}.ef-host[data-element=grass] .ef-mote{width:10px;height:6px;border-radius:100% 0;animation:ef-leaf 3s ease-in-out infinite;animation-delay:calc(var(--i)*-.6s)}
 .ef-host[data-element=wind] .ef-loop{border:2px solid transparent;border-top-color:currentColor;border-bottom-color:currentColor;border-radius:50%;inset:-4%;animation:ef-spin 3.4s linear infinite}.ef-host[data-element=wind] .ef-mote{height:2px;width:10px;animation:ef-orbit 2.8s linear infinite;animation-delay:calc(var(--i)*-.5s)}
 .ef-host[data-element=rock] .ef-loop{border-style:double;border-width:3px;border-radius:16%}.ef-host[data-element=rock] .ef-mote{width:7px;height:9px;border-radius:0;clip-path:polygon(50% 0,100% 25%,80% 100%,10% 80%,0 25%);animation:ef-frost 4s ease-in-out infinite;animation-delay:calc(var(--i)*-.6s)}
 .ef-arrive{position:absolute;inset:-5px;border:2px solid currentColor;border-radius:inherit;animation:ef-arrival .6s ease-out both}.ef-host[data-element=water] .ef-arrive{border-radius:50%;animation-name:ef-water-arrival}.ef-host[data-element=ice] .ef-arrive,.ef-host[data-element=rock] .ef-arrive{border-radius:10%;border-style:double;border-width:5px}.ef-host[data-element=grass] .ef-arrive{border-style:dashed;border-radius:35%}.ef-host[data-element=lightning] .ef-arrive{clip-path:polygon(10% 0,80% 0,55% 40%,100% 30%,40% 100%,50% 55%,0 70%)}.ef-host[data-element=wind] .ef-arrive{border-radius:50%;border-left-color:transparent;animation:ef-wind-arrival .65s ease-out both}
 .ef-stage{position:absolute;inset:0;pointer-events:none;z-index:15;color:var(--ef-color);overflow:visible}.ef-stage .ef-core{position:absolute;inset:5%;border-radius:50%;border:2px solid currentColor;box-shadow:0 0 15px currentColor;animation:ef-wave .8s ease-out both}.ef-bit{position:absolute;left:50%;top:50%;width:7px;height:7px;background:currentColor;border-radius:50%;box-shadow:0 0 6px currentColor;animation:ef-burst .85s ease-out both;animation-delay:calc(var(--i)*.018s)}.ef-stage[data-reaction=steam]{color:#d7f7ff}.ef-stage[data-reaction=steam] .ef-bit{width:30px;height:23px;background:radial-gradient(#efffffaa,transparent 70%);box-shadow:none;animation-name:ef-steam}.ef-stage[data-reaction=blast]{color:#ffd494}.ef-stage[data-reaction=blast] .ef-core{inset:-85% 35%;border:0;border-radius:40%;background:linear-gradient(transparent,#fff0b9,#f385c9,transparent);animation:ef-flash .65s ease-out both}.ef-stage[data-reaction=melt]{color:#b7f5ff}.ef-stage[data-reaction=melt] .ef-bit{border-radius:10% 70% 70%;background:linear-gradient(#caffff,#ffba78);animation-name:ef-steam}.ef-stage[data-reaction=fracture] .ef-bit,.ef-stage[data-reaction=crystal] .ef-bit{border-radius:0;clip-path:polygon(50% 0,100% 40%,70% 100%,0 70%);height:15px}.ef-stage[data-reaction=crystal]{color:#ffd994}.ef-stage[data-reaction=crystal] .ef-bit{animation-name:ef-gather}.ef-stage[data-reaction=crystal] .ef-core{inset:20%;border-radius:0;clip-path:polygon(50% 0,95% 35%,75% 100%,20% 100%,0 35%);background:linear-gradient(120deg,#fff6c1,#bd914d);animation:ef-gem .9s both}.ef-stage[data-reaction=burn]{color:#ffb36d}.ef-stage[data-reaction=burn] .ef-bit{border-radius:80% 0 60% 30%;width:12px;height:22px;animation-name:ef-steam}.ef-stage[data-reaction=dew]{color:#bef5ff}.ef-stage[data-reaction=dew] .ef-bit{background:#a6efff22;border:1px solid #d8ffff;width:17px;height:17px}.ef-stage[data-reaction=bloom],.ef-stage[data-reaction=grow]{color:#caec87}.ef-stage[data-reaction=bloom] .ef-bit,.ef-stage[data-reaction=grow] .ef-bit{width:17px;height:9px;border-radius:100% 0}.ef-stage[data-reaction=bloom] .ef-core{inset:25%;border-radius:60% 10%;background:radial-gradient(#ffffc9,#9ac870);animation:ef-gem 1.1s both}.ef-stage[data-reaction=diffuse] .ef-core{border-left-color:transparent;border-right-color:transparent;animation:ef-wind-arrival .9s both}.ef-stage[data-reaction=replace] .ef-core,.ef-stage[data-reaction=refresh] .ef-core{box-shadow:none;animation:ef-arrival .5s both}.ef-stage[data-reaction=replace] .ef-bit,.ef-stage[data-reaction=refresh] .ef-bit{display:none}.ef-bolt{position:absolute;inset:-70%;width:240%;height:240%;overflow:visible}.ef-bolt path{fill:none;stroke:#e6c9ff;stroke-width:2;stroke-linejoin:round;stroke-dasharray:180;stroke-dashoffset:180;animation:ef-draw .65s ease-out both}.ef-bolt path:nth-child(2){animation-delay:.1s}.ef-bolt path:nth-child(3){animation-delay:.2s}
 @keyframes ef-breathe{50%{opacity:.65}}@keyframes ef-orbit{from{transform:rotate(0) translateX(29px)}to{transform:rotate(360deg) translateX(29px)}}@keyframes ef-flame{0%{transform:translate(calc((var(--i) - 2)*12px),25px) scale(.5);opacity:0}30%{opacity:.9}100%{transform:translate(calc((var(--i) - 2)*14px),-30px) scale(.2);opacity:0}}@keyframes ef-drop{0%,100%{transform:translate(calc((var(--i) - 2)*13px),-23px);opacity:.2}50%{transform:translate(calc((var(--i) - 2)*13px),23px);opacity:.8}}@keyframes ef-frost{0%,100%{transform:rotate(calc(var(--i)*72deg)) translateX(28px) rotate(45deg) scale(.6);opacity:.35}50%{transform:rotate(calc(var(--i)*72deg)) translateX(28px) rotate(45deg);opacity:1}}@keyframes ef-leaf{0%,100%{transform:rotate(calc(var(--i)*72deg)) translateX(28px) rotate(-10deg)}50%{transform:rotate(calc(var(--i)*72deg)) translateX(29px) rotate(15deg)}}@keyframes ef-electric{0%,80%,100%{opacity:.1}82%,88%{opacity:.8}}@keyframes ef-spin{to{transform:rotate(360deg)}}@keyframes ef-water{50%{transform:translateY(-8px) rotate(8deg)}}@keyframes ef-arrival{from{transform:scale(1.5);opacity:0}35%{opacity:1}to{transform:scale(1);opacity:0}}@keyframes ef-water-arrival{from{transform:scale(.2);opacity:.9}to{transform:scale(1.3);opacity:0}}@keyframes ef-wind-arrival{from{transform:scale(.3) rotate(-150deg);opacity:1}to{transform:scale(2) rotate(80deg);opacity:0}}@keyframes ef-wave{from{transform:scale(.2);opacity:1}to{transform:scale(2.2);opacity:0}}@keyframes ef-burst{from{transform:translate(-50%,-50%) scale(.3);opacity:1}to{transform:translate(var(--x),var(--y)) rotate(90deg) scale(.5);opacity:0}}@keyframes ef-steam{from{transform:translate(-50%,0) scale(.3);opacity:1}to{transform:translate(var(--x),calc(var(--y) - 30px)) scale(1.7);opacity:0}}@keyframes ef-gather{from{transform:translate(var(--x),var(--y)) rotate(-60deg);opacity:0}40%{opacity:1}to{transform:translate(-50%,-50%) scale(.2);opacity:0}}@keyframes ef-gem{0%{transform:scale(.2);opacity:0}45%,75%{transform:scale(1);opacity:1}100%{transform:scale(.9);opacity:0}}@keyframes ef-flash{0%{transform:scaleY(.1);opacity:0}25%{opacity:1}100%{transform:scaleY(1.2);opacity:0}}@keyframes ef-draw{0%{stroke-dashoffset:180;opacity:1}65%{stroke-dashoffset:0;opacity:1}100%{stroke-dashoffset:0;opacity:0}}
 .ef-paused *{animation-play-state:paused!important}.ef-reduced .ef-loop,.ef-reduced .ef-mote{animation:none!important}.ef-reduced .ef-mote{display:none}.ef-reduced .ef-arrive,.ef-reduced .ef-stage *{animation:none!important}.ef-reduced .ef-stage .ef-bit,.ef-reduced .ef-stage .ef-bolt{display:none}.ef-reduced .ef-stage .ef-core{opacity:.7;inset:0;border:2px solid currentColor;box-shadow:none;background:transparent;transform:none;clip-path:none}@media(prefers-reduced-motion:reduce){.ef-loop,.ef-mote,.ef-arrive,.ef-stage *{animation:none!important}.ef-mote,.ef-bit,.ef-bolt{display:none}.ef-stage .ef-core{inset:0;box-shadow:none;opacity:.7;transform:none}}
 .el-lab{color:#f6e9d5;font-family:system-ui,'Microsoft YaHei',sans-serif;max-width:430px;margin:auto;text-align:left}.el-lab *{box-sizing:border-box}.el-lab h2{font-size:22px;margin:6px 0 10px;color:#ffe2ae}.el-copy{font-size:12px;color:#c5b6d4;line-height:1.8;margin:0 0 18px}.el-picker{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin:10px 0}.el-picker button{background:#342840;border:1px solid #947b9c66;color:#dfcfe5;border-radius:11px;min-height:42px;font:inherit;font-size:12px;padding:4px}.el-picker button[aria-pressed=true]{border-color:var(--pick);color:var(--pick);box-shadow:inset 0 0 12px #fff1}.el-board{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:9px;padding:25px;margin:18px 0;border:1px solid #b3986955;border-radius:22px;background:radial-gradient(#493251,#1a172a);overflow:hidden}.el-cell{position:relative;aspect-ratio:1;border:1px solid #b69cca33;border-radius:15px;background:linear-gradient(145deg,#58415e,#29243d);display:grid;place-items:center}.el-cell:not(.el-center){opacity:.4}.el-cell svg{width:76%;height:76%;filter:drop-shadow(0 4px 2px #0c071f80)}.el-center{z-index:2;border-color:#c2a6d570}.el-status{min-height:60px;border-left:2px solid #eccd91;padding:2px 0 2px 12px;margin:12px 0}.el-status strong{font-size:15px;display:block;color:#ffe2ad}.el-status span{font-size:12px;line-height:1.7;display:block;color:#d4c1df;margin-top:5px}.el-controls{display:grid;grid-template-columns:1fr 1fr;gap:9px}.el-controls button{min-height:46px;border:1px solid #ddba82;border-radius:13px;background:linear-gradient(#ffe5af,#d5a25d);color:#513530;font:inherit;font-weight:700;font-size:13px}.el-controls button:last-child{background:#362840;color:#edddf4;border-color:#a98abc}.el-controls button:disabled{opacity:.45}.el-settings{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#c9b6d6;gap:10px;margin:17px 0}.el-settings label{display:flex;gap:7px;align-items:center}.el-settings button{background:none;border:0;color:#e7c795;text-decoration:underline;font:inherit}.el-stage-label{font-size:10px;color:#c6adcf;letter-spacing:.12em}.el-lab button:focus-visible{outline:2px solid #fff;outline-offset:3px}@media(max-width:360px){.el-board{padding:21px;gap:7px}.el-picker{gap:3px}.el-picker button{font-size:11px}.el-copy{font-size:11px}}
 `;
 const strongCss=`
 .ef-host:not([data-element=wind]) .ef-loop{border-width:2px;box-shadow:inset 0 0 16px color-mix(in srgb,currentColor 35%,transparent),0 0 14px color-mix(in srgb,currentColor 50%,transparent)}
 .ef-host .ef-ornament,.el-cell .ef-ornament{position:absolute;inset:-19%;width:138%;height:138%;overflow:visible;filter:drop-shadow(0 0 3px currentColor);pointer-events:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linejoin:round;stroke-linecap:round}
 .ef-ornament .ef-solid{fill:currentColor;stroke:#fff5;stroke-width:.7}.ef-ornament .ef-inner{stroke:#fff3c9;stroke-width:1;opacity:.85}.ef-host[data-element=fire] .ef-ornament{animation:ef-fire-large 1.7s ease-in-out infinite;transform-origin:50% 80%}.ef-host[data-element=fire] .ef-mote{width:9px;height:16px;box-shadow:0 0 7px #ff9c4f;animation-duration:1.5s}
 .ef-host[data-element=water] .ef-ornament{animation:ef-spin 4.5s linear infinite}.ef-host[data-element=water] .ef-loop:before{border-bottom-width:5px;inset:-3%;box-shadow:0 5px 8px #67d6ff55}.ef-host[data-element=water] .ef-mote{width:9px;height:12px;border:1px solid #efffff99;background:#6cdfff66;border-radius:60% 40% 60% 40%}
 .ef-host[data-element=ice] .ef-ornament{animation:ef-ice-large 2.8s ease-in-out infinite}.ef-host[data-element=ice] .ef-mote{width:13px;height:17px;box-shadow:0 0 8px #ccffff99}.ef-host[data-element=ice] .ef-loop{border-width:3px;background:linear-gradient(135deg,#a8eaff22,transparent 45%,#a8eaff1a)}
 .ef-host[data-element=lightning] .ef-ornament{stroke-width:2.7;filter:drop-shadow(0 0 4px #c487ff)}.ef-host[data-element=lightning] .ef-ornament .ef-current{stroke-dasharray:16 5;animation:ef-current 1.2s linear infinite}.ef-host[data-element=lightning] .ef-loop:after{animation:none;opacity:.5}.ef-host[data-element=lightning] .ef-mote{width:6px;height:17px;clip-path:polygon(45% 0,100% 0,60% 40%,100% 40%,10% 100%,35% 55%,0 55%);background:#f2d9ff}
 .ef-host[data-element=grass] .ef-ornament{stroke-width:2.5;animation:ef-grass-large 3s ease-in-out infinite}.ef-host[data-element=grass] .ef-mote{width:18px;height:10px;background:linear-gradient(30deg,#76bd57,#e0ffad);box-shadow:0 1px 4px #a3e76477}.ef-host[data-element=grass] .ef-loop{border-width:3px}
 .ef-host[data-element=rock] .ef-ornament{animation:ef-rock-large 3.4s ease-in-out infinite;stroke:#ffe6a1}.ef-host[data-element=rock] .ef-mote{width:13px;height:17px;background:linear-gradient(130deg,#fff1b0,#c28b43);box-shadow:0 0 8px #ffc66299}.ef-host[data-element=rock] .ef-loop{border-width:4px;inset:-2%}
 .ef-host:not([data-element=wind]) .ef-arrive{inset:-18%;border-width:4px;animation-duration:.85s;filter:drop-shadow(0 0 7px currentColor)}
 .ef-stage:not([data-reaction=diffuse]):not([data-reaction=replace]):not([data-reaction=refresh]) .ef-core{border-width:3px;box-shadow:0 0 24px currentColor;animation-duration:1s}.ef-stage:not([data-reaction=diffuse]) .ef-bit{width:11px;height:11px;animation-duration:1s}.ef-stage[data-reaction=steam] .ef-bit{width:46px;height:35px;background:radial-gradient(#effffff0,#bbddff66 35%,transparent 70%)}.ef-stage[data-reaction=melt] .ef-bit{width:13px;height:25px}.ef-stage[data-reaction=burn] .ef-bit{width:19px;height:34px}.ef-stage[data-reaction=dew] .ef-bit{width:26px;height:26px;border-width:2px}.ef-stage[data-reaction=bloom] .ef-bit,.ef-stage[data-reaction=grow] .ef-bit{width:25px;height:14px}.ef-stage[data-reaction=fracture] .ef-bit,.ef-stage[data-reaction=crystal] .ef-bit{width:17px;height:29px}.ef-stage .ef-bolt path{stroke-width:3.5;filter:drop-shadow(0 0 4px #d1a3ff);animation-duration:1s}
 @keyframes ef-fire-large{0%,100%{transform:scale(.96,.92);opacity:.75}50%{transform:scale(1.03,1.08);opacity:1}}@keyframes ef-ice-large{0%,100%{transform:scale(.94);opacity:.65}50%{transform:scale(1.06);opacity:1}}@keyframes ef-current{to{stroke-dashoffset:-42}}@keyframes ef-grass-large{0%,100%{transform:rotate(-5deg) scale(.96)}50%{transform:rotate(5deg) scale(1.04)}}@keyframes ef-rock-large{0%,100%{transform:translateY(2px) rotate(-4deg)}50%{transform:translateY(-4px) rotate(4deg)}}
 .ef-reduced .ef-ornament,.ef-reduced .ef-ornament *{animation:none!important}.ef-reduced .ef-ornament{opacity:.7;filter:none!important}.ef-reduced .ef-stage .ef-core{box-shadow:none!important}@media(prefers-reduced-motion:reduce){.ef-ornament,.ef-ornament *{animation:none!important}.ef-ornament{filter:none!important;opacity:.7}.ef-stage .ef-core{box-shadow:none!important}}
 `;
 function ornament(id){const forms={
 fire:'<path class="ef-solid" d="M17 76C4 66 11 49 13 43Q13 60 21 57C13 40 24 34 23 23Q40 45 29 64Q25 72 27 78ZM74 78C66 63 72 49 79 43Q77 60 84 59Q83 48 90 37C98 55 98 72 86 79Z"/><path class="ef-inner" d="M20 72Q12 61 21 49M81 74Q90 65 88 55"/>',
 water:'<path d="M14 57A38 38 0 0 1 74 17L68 24M86 43A38 38 0 0 1 26 83L32 76" stroke-width="4"/><path d="M19 62A32 32 0 0 1 64 22M81 38A32 32 0 0 1 36 78" opacity=".5"/><circle class="ef-solid" cx="17" cy="65" r="4"/><circle class="ef-solid" cx="83" cy="35" r="4"/>',
 ice:'<path class="ef-solid" d="m15 36-7-14 9-14 7 16-3 12ZM66 15 77 3 85 21 76 34ZM81 68 96 74 91 91 73 82ZM24 76 24 96 9 86 11 70Z"/><path class="ef-inner" d="m17 13 2 19M78 9l-2 19M89 78l-10 2M14 78l7 10"/><path d="m29 12 8 7-7 8M88 38l-8 7 8 7M65 88l-8-7-8 7"/>',
 lightning:'<path d="m14 15 19-8-8 17 17-5M82 20l9 21-13-4 10 24M79 84l-23 9 7-14-22 8M13 78 5 53l13 8-7-24" opacity=".7"/><path class="ef-current" d="m14 15 19-8-8 17 17-5M82 20l9 21-13-4 10 24M79 84l-23 9 7-14-22 8M13 78 5 53l13 8-7-24"/><path class="ef-inner" d="m14 15 19-8-8 17M82 20l9 21-13-4M79 84l-23 9 7-14M13 78 5 53l13 8"/>',
 grass:'<path d="M28 87Q3 78 16 47T34 12M72 13Q97 22 84 53T66 88"/><path class="ef-solid" d="M16 47Q0 31 11 20Q27 30 16 47ZM22 28Q24 9 42 9Q40 27 22 28ZM17 68Q0 65 4 48Q23 50 17 68ZM84 53Q100 69 89 80Q73 70 84 53ZM78 72Q76 91 58 91Q60 73 78 72ZM83 32Q100 35 96 52Q77 50 83 32Z"/>',
 rock:'<path class="ef-solid" d="m13 12 13-5 8 14-12 13-13-8ZM72 7 88 12 92 29 77 34 66 22ZM83 68 96 77 88 95 72 90 68 76ZM12 69 26 67 34 84 20 96 6 84Z"/><path class="ef-inner" d="m13 12 9 9 12 0M22 21v13M72 7l6 15 14 7M78 22l-1 12M83 68l-3 14 8 13M80 82l-12-6M12 69l9 12 13 3M21 81l-1 15"/>'};return forms[id]?'<svg class="ef-ornament" viewBox="0 0 100 100" aria-hidden="true">'+forms[id]+'</svg>':'';}
 let mounted=false;
 function install(){if(mounted)return;const s=document.createElement('style');s.textContent=css+strongCss;document.head.append(s);mounted=true;}
 const timers=new WeakMap();
 function clear(target){(timers.get(target)||[]).forEach(clearTimeout);timers.delete(target);target.querySelectorAll(':scope > .ef-host,:scope > .ef-stage').forEach(n=>n.remove());}
 function later(target,fn,ms){const ts=timers.get(target)||[];ts.push(setTimeout(fn,ms));timers.set(target,ts);}
 function attach(target,id,reduced=false){install();clear(target);const e=elements.find(e=>e[0]===id);if(!e)return;const n=document.createElement('span');n.className='ef-host'+(reduced?' ef-reduced':'');n.dataset.element=id;n.style.setProperty('--ef-color',e[3]);n.setAttribute('aria-hidden','true');n.innerHTML=ornament(id)+'<i class="ef-loop"></i>'+Array.from({length:5},(_,i)=>'<i class="ef-mote" style="--i:'+i+'"></i>').join('')+'<i class="ef-arrive"></i><b class="ef-label">'+e[1]+'</b>';target.append(n);later(target,()=>n.querySelector('.ef-arrive')?.remove(),950);}
 function burst(target,from,incoming,reduced=false){install();clear(target);const e=elements.find(e=>e[0]===incoming),r=reaction(from,incoming),n=document.createElement('span');n.className='ef-stage'+(reduced?' ef-reduced':'');n.dataset.reaction=r[0];n.style.setProperty('--ef-color',e[3]);n.setAttribute('aria-hidden','true');n.innerHTML='<i class="ef-core"></i>'+Array.from({length:12},(_,i)=>{const a=i*Math.PI/6;return '<i class="ef-bit" style="--i:'+i+';--x:'+Math.round(Math.cos(a)*82)+'px;--y:'+Math.round(Math.sin(a)*75)+'px"></i>';}).join('')+(['conduct','fracture','grow'].includes(r[0])?'<svg class="ef-bolt" viewBox="0 0 180 180"><path d="M90 90 68 75 72 66 35 35 44 61 17 90"/><path d="M90 90 115 77 108 64 147 34 136 66 165 88"/><path d="M90 90 103 115 91 120 118 149 82 145 90 168"/></svg>':'');target.append(n);later(target,()=>n.remove(),1200);return r;}
 const candy='<svg viewBox="0 0 64 68" aria-hidden="true"><path d="M32 55 12 35C-1 21 19 7 32 21 45 7 65 21 52 35Z" fill="#94265f"/><path d="M32 51 12 31C-1 17 19 3 32 17 45 3 65 17 52 31Z" fill="#ed79ac" stroke="#ffdaea" stroke-width="1.7"/><path d="M13 24Q13 13 24 14" fill="none" stroke="#ffe5f4" stroke-width="4" stroke-linecap="round"/><path d="m40 32 2 5 5 2-5 2-2 5-2-5-5-2 5-2Z" fill="#fff3f8" opacity=".7"/></svg>';
 function mount(container){install();let from='fire',incoming='water',attached=false,busy=false,epoch=0,reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;container.innerHTML='<section class="el-lab"><div class="el-stage-label">元素演出 · 可交互预览</div><h2>染上、停留，再爆发。</h2><p class="el-copy">中心始终是同一颗桃心糖，观察元素如何附着在它外面。这里演示视觉效果，不会修改你的对局或存档。</p><div class="el-stage-label">① 先染上的元素</div><div class="el-picker el-source"></div><div class="el-board">'+Array.from({length:9},(_,i)=>'<div class="el-cell '+(i===4?'el-center':'')+'">'+candy+'</div>').join('')+'</div><div class="el-stage-label">② 再接触的元素</div><div class="el-picker el-incoming"></div><div class="el-status" role="status" aria-live="polite"><strong></strong><span></span></div><div class="el-controls"><button class="el-attach">播放染上效果</button><button class="el-burst">触发反应</button></div><div class="el-settings"><label><input class="el-reduce" type="checkbox">减少动态效果</label><button class="el-reset">清除附着</button></div></section>';
 const q=s=>container.querySelector(s),center=q('.el-center');
 function status(a,b){q('.el-status strong').textContent=a;q('.el-status span').textContent=b;}
 function pick(cls,selected,fn){const root=q(cls);root.innerHTML=elements.map(e=>'<button type="button" data-element="'+e[0]+'" style="--pick:'+e[3]+'" aria-pressed="'+(e[0]===selected)+'">'+e[1]+'</button>').join('');root.onclick=ev=>{const b=ev.target.closest('button');if(!b||busy)return;root.querySelectorAll('button').forEach(n=>n.setAttribute('aria-pressed',String(n===b)));fn(b.dataset.element);};}
 function describe(){const r=reaction(from,incoming);status(attached?'附着中 → '+r[1]:'准备染上元素',attached?r[2]:'先点「播放染上效果」，短动画结束后会持续轻动。');}
 pick('.el-source',from,id=>{from=id;if(attached)attach(center,from,reduced);describe();});pick('.el-incoming',incoming,id=>{incoming=id;describe();});
 q('.el-attach').onclick=()=>{if(busy)return;epoch++;attach(center,from,reduced);attached=true;describe();};
 q('.el-burst').onclick=()=>{if(busy)return;if(!attached){status('先给糖果染上元素','附着后再接触第二种元素，才能看到反应。');return;}busy=true;const current=++epoch,r=burst(center,from,incoming,reduced);status(r[1]+' · 爆发',r[2]);q('.el-burst').disabled=true;q('.el-attach').disabled=true;setTimeout(()=>{if(current!==epoch||!container.isConnected)return;busy=false;q('.el-burst').disabled=false;q('.el-attach').disabled=false;if(r[0]==='replace'||r[0]==='refresh'){attached=true;attach(center,incoming,reduced);from=incoming;pick('.el-source',from,id=>{from=id;attach(center,from,reduced);describe();});status('附着中',r[0]==='refresh'?'同元素刷新，没有额外爆炸。':'现在附着的是新元素。');}else{attached=false;status(r[1]+' · 演出结束','反应消耗附着。可重新染色，再比较其他组合。');}},1250);};
 q('.el-reset').onclick=()=>{epoch++;clear(center);attached=false;busy=false;q('.el-burst').disabled=false;q('.el-attach').disabled=false;describe();};q('.el-reduce').checked=reduced;q('.el-reduce').onchange=e=>{reduced=e.target.checked;if(attached&&!busy)attach(center,from,reduced);};describe();
 return ()=>{epoch++;clear(center);container.innerHTML='';};
 }
 document.addEventListener('visibilitychange',()=>document.documentElement.classList.toggle('ef-paused',document.hidden));
 window.StarCandyEffects={attach,burst,clear,mount,elements,reaction};
})();

</script>
<script id="elementRules">
/* Aura belongs to candy; delayed fields belong to board positions. */
class ElementSystem {
 constructor(engine){this.engine=engine;this.turn=0;this.used=0;this.fields=[];this.events=[];}
 static ids=['fire','water','rock','grass','lightning','ice','wind'];
 static reactionLimit=2;
 neighbors(i){return [i-7,i-1,i+1,i+7].filter(j=>this.engine.adjacent(i,j));}
 nearby(i,predicate=()=>true){return this.engine.cells.map((c,j)=>({j,d:Math.abs(j%7-i%7)+Math.abs(Math.floor(j/7)-Math.floor(i/7))})).filter(o=>o.j!==i&&predicate(this.engine.cells[o.j],o.j)).sort((a,b)=>a.d-b.d||a.j-b.j).map(o=>o.j);}
 begin(){this.turn++;this.used=0;this.events=[];}
 attach(i,e){const c=this.engine.cells[i];if(c)c.aura={e,until:this.turn+2};}
 field(i,type,e){if(this.fields.some(f=>f.i===i)||this.fields.length>=4)return;this.fields.push({i,type,e,born:this.turn,until:this.turn+2,left:type==='burn'?2:1});}
 pulse(entries,clear=new Set(),protectedCells=new Map()){
  const old=this.engine.cells.map(c=>c.aura?.e),seen=new Set();
  const add=i=>{if(i>=0&&i<49&&!protectedCells.has(i))clear.add(i);};
  for(const {i,e} of entries){
   if(seen.has(i)||clear.has(i)||protectedCells.has(i))continue;seen.add(i);
   const c=this.engine.cells[i],field=this.fields.find(f=>f.i===i);if(!c)continue;
   if(field){
    let hit=[];
    if(field.type==='seed'&&e==='fire')hit=[i,...this.neighbors(i)];
    if(field.type==='seed'&&e==='lightning')hit=[i,...this.nearby(i).slice(0,2)];
    if(field.type==='burn'&&e==='water')hit=this.neighbors(i).slice(0,field.left);
    if(field.type==='crystal'&&e===field.e)hit=[i,...this.nearby(i).slice(0,1)];
    if(hit.length&&this.used<ElementSystem.reactionLimit){this.used++;hit.forEach(add);this.fields=this.fields.filter(f=>f!==field);this.events.push({i,a:field.type==='seed'?'grass':field.type==='burn'?'fire':'rock',b:e,type:'relay',name:'元素接力'});continue;}
   }
   const a=old[i];if(!a||a===e){this.attach(i,e);continue;}
   const [type,name]=StarCandyEffects.reaction(a,e);
   if(type==='replace'){this.attach(i,e);continue;}
   if(this.used>=ElementSystem.reactionLimit){continue;}
   this.used++;delete c.aura;add(i);this.events.push({i,a,b:e,type,name});
   const near=this.neighbors(i),other=a==='wind'||a==='rock'?e:a;
   if(type==='steam')near.filter(j=>Math.floor(j/7)===Math.floor(i/7)).forEach(add);
   if(type==='blast')near.filter(j=>j%7===i%7).forEach(add);
   if(type==='melt')this.nearby(i,(c,j)=>!clear.has(j)).slice(0,1).forEach(add);
   if(type==='fracture')[-8,-6,6,8].map(d=>i+d).filter(j=>j>=0&&j<49&&Math.abs(j%7-i%7)===1).slice(0,2).forEach(add);
   if(type==='conduct')this.nearby(i,c=>[1,4].includes(c.k)).slice(0,2).forEach(add);
   if(type==='bloom')this.field(i,'seed','grass');
   if(type==='burn')this.field(i,'burn','fire');
   if(type==='crystal')this.field(i,'crystal',other);
   if(type==='diffuse')near.filter(j=>!clear.has(j)&&!this.engine.cells[j].s&&!this.engine.cells[j].buff&&!seen.has(j)).slice(0,2).forEach(j=>{this.attach(j,other);seen.add(j);});
   if(type==='dew'||type==='grow')this.nearby(i,(c,j)=>!clear.has(j)&&!c.s&&!c.buff&&(type!=='grow'||c.k===3)).slice(0,type==='dew'?2:1).forEach(j=>this.engine.cells[j].buff={type,until:this.turn+2});
  }return clear;
 }
 dyeTargets(plan,clear){
  const entries=[],chosen=new Set();
  for(const run of plan.matches||[]){
   const middle=run.ids[Math.floor(run.ids.length/2)],candidates=new Set();
   for(const source of run.ids)for(const i of this.neighbors(source))if(!clear.has(i)&&!plan.creates.has(i)&&!chosen.has(i))candidates.add(i);
   // Deterministic center-out targeting, with existing different auras first.
   const e=ElementSystem.ids[this.engine.cells[run.ids[0]].k];
   const rank=i=>Math.abs(i%7-middle%7)+Math.abs(Math.floor(i/7)-Math.floor(middle/7));
   const priority=i=>Number(!!this.engine.cells[i].aura&&this.engine.cells[i].aura.e!==e);
   const limit=Math.min(4,run.ids.length-1);
   [...candidates].sort((a,b)=>priority(b)-priority(a)||rank(a)-rank(b)||a-b).slice(0,limit).forEach(i=>{chosen.add(i);entries.push({i,e});});
  }return entries;
 }
 wave(plan,expanded,emit=false){
  this.events=[];const clear=expanded.clear,baseClear=new Set(clear);
  for(const i of [...clear]){const c=this.engine.cells[i];if(c.buff){const targets=c.buff.type==='dew'?this.neighbors(i).slice(0,1):this.neighbors(i).filter(j=>Math.floor(j/7)===Math.floor(i/7));targets.forEach(j=>{if(!plan.creates.has(j))clear.add(j);});delete c.buff;}}
  if(emit)this.pulse(this.dyeTargets(plan,clear),clear,plan.creates);
  expanded.elementClear=new Set([...clear].filter(i=>!baseClear.has(i)));return expanded;
 }
 end(){
  const clear=new Set();this.events=[];
  this.fields=this.fields.filter(f=>{
   if(f.born===this.turn)return true;
   if(f.type==='seed'){[f.i,...this.neighbors(f.i)].forEach(i=>clear.add(i));this.events.push({i:f.i,a:'water',b:'grass',name:'种子绽放'});return false;}
   if(f.type==='burn'){const j=this.neighbors(f.i)[2-f.left];if(j!==undefined)clear.add(j);f.left--;this.events.push({i:f.i,a:'fire',b:'grass',name:'余焰'});return f.left>0;}
   return f.until>this.turn;
  });
  this.engine.cells.forEach(c=>{if(c.aura?.until<=this.turn)delete c.aura;if(c.buff?.until<=this.turn)delete c.buff;});return clear;
 }
 export(){return {turn:this.turn,used:this.used,fields:this.fields};}
 restore(x){this.turn=Number.isInteger(x?.turn)&&x.turn>=0?x.turn:0;this.used=Number.isInteger(x?.used)?Math.max(0,Math.min(ElementSystem.reactionLimit,x.used)):0;this.fields=Array.isArray(x?.fields)?x.fields.filter(f=>f&&Number.isInteger(f.i)&&f.i>=0&&f.i<49&&['seed','burn','crystal'].includes(f.type)&&ElementSystem.ids.includes(f.e)&&Number.isInteger(f.born)&&Number.isInteger(f.until)&&[1,2].includes(f.left)).slice(0,4):[];}
}

</script>
<script id="gameMusic">
/* User-selected Stable Audio tracks; bytes embedded by build-game.cjs. */
window.StarCandyMusic=(()=>{
 const assets={"menu":"